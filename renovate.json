{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "description": "`# renovate: datasource=… depName=…` 註記之後的變數或 ARG",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.gitlab-ci\\.yml$/", "/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:ARG\\s+)?\\w+[:=]\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "PostgreSQL 主版本須與正式區相同，不自動升主版本",
      "matchDepNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
