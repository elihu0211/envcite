{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "Asia/Taipei",
  "schedule": [
    "before 6am on Monday"
  ],
  "labels": [
    "renovate",
    "dependencies"
  ],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "branchConcurrentLimit": 2,
  "rebaseWhen": "conflicted",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security",
      "renovate"
    ],
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on Monday"
    ]
  },
  "customManagers": [
    {
      "description": "`# renovate: datasource=… depName=…` 註記之後的變數或 ARG",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.gitlab-ci\\.yml$/",
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:ARG\\s+)?\\w+[:=]\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "大版本升級先在 Dependency Dashboard 勾選才開 MR：多半需要程式碼遷移，照排程自動開只會是紅燈（chepb 2026-10-13 的 lock file maintenance 一次帶進多個大版本的前科）",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "語言執行環境與其基底映像的 minor 也是行為變更（python 3.14→3.15、.NET 10→11 的映像與 SDK）：升版要連同 requires-python／TargetFramework 與依賴的相容性一起評估，先勾選才開 MR。三處（.python-version、CI 變數、Dockerfile）已歸為同一個 MR",
      "matchDepNames": [
        "python",
        "dotnet-sdk",
        "mcr.microsoft.com/dotnet/sdk",
        "mcr.microsoft.com/dotnet/aspnet"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "CI 變數的版本值會被拼進映像名稱或指令（如 postgres:$POSTGRES_MAJOR），不能附 digest；digest 釘選只用於 Dockerfile 與字面 image",
      "matchManagers": [
        "custom.regex"
      ],
      "pinDigests": false
    },
    {
      "description": "ontology／consult 的 FROM 以 ARG 組 tag（python:${PYTHON_VERSION}-slim-trixie），digest 無處可寫，不釘",
      "matchFileNames": [
        "services/ontology/Dockerfile",
        "services/consult/Dockerfile"
      ],
      "pinDigests": false
    },
    {
      "description": "python 在 .python-version、CI 變數與兩個 Dockerfile 各有一處，升版時同一個 MR 一起改",
      "matchDepNames": [
        "python"
      ],
      "groupName": "python"
    },
    {
      "description": "uv 在 CI 變數、兩個 Dockerfile 的映像 tag 與各 pyproject 的 uv_build 範圍各有一處，升版時同一個 MR 一起改",
      "matchDepNames": [
        "uv",
        "ghcr.io/astral-sh/uv",
        "uv_build"
      ],
      "groupName": "uv"
    },
    {
      "description": ".NET SDK 在 global.json、CI 變數與 platform Dockerfile，執行期映像（aspnet）須同版",
      "matchDepNames": [
        "dotnet-sdk",
        "mcr.microsoft.com/dotnet/sdk",
        "mcr.microsoft.com/dotnet/aspnet"
      ],
      "groupName": ".NET SDK and images"
    },
    {
      "description": "global.json 的 sdk.version 是下限（搭配 rollForward: latestFeature），不是釘死的版本：升它不改變任何人實際用的 SDK，卻會讓 Renovate 自己的執行環境（鎖檔更新要在那裡跑 dotnet restore）因 SDK 版本不足而失敗。實際用的 SDK 由 CI／Dockerfile 的映像決定，那兩處照常更新",
      "matchManagers": [
        "nuget"
      ],
      "matchFileNames": [
        "services/platform/global.json"
      ],
      "matchDepNames": [
        "dotnet-sdk"
      ],
      "enabled": false
    },
    {
      "description": "PostgreSQL 主版本須與正式區相同，不自動升主版本",
      "matchDepNames": [
        "postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
