<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet source for CI only: the runner host's Nexus pull-through cache of api.nuget.org.
  `host.docker.internal` resolves inside CI job containers, not on a developer machine,
  so this file is never the repository's nuget.config; CI installs it as the user-level
  config (see `deps-dotnet` and services/platform/Dockerfile).

  One source, no fallback: Nexus CE counts failed requests against a daily quota, and a
  fallback chain turns every cache miss into a 404 on the first source.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nexus" value="http://host.docker.internal:8081/repository/nuget-proxy/index.json" allowInsecureConnections="true" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nexus">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
