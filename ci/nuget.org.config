<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet source for GitHub-hosted runners: nuget.org directly.
  The self-hosted runner still uses ci/nuget.mirror.config (no fallback, Nexus quota).
  CI installs the chosen file as the user-level config; see ci/restore-dotnet.sh.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
