        "type": "object",
        "properties": {
          "loser": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "winner": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "basis": {
            "$ref": "#/components/schemas/OverrideBasisDto"
          }
        }
      },
      "DefinitionUseDto": {
        "required": [
          "conditionId",
          "definitionId",
          "uri",
          "term",
          "members"
        ],
        "type": "object",
        "properties": {
          "conditionId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "definitionId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "uri": {
            "type": "string"
