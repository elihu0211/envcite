{
  "openapi": "3.1.1",
  "info": {
    "title": "envcite API",
    "description": "環境知識 API。以租戶的 API key 呼叫（`Authorization: Bearer sk_live_…`）。拒答是結果、不是錯誤：`POST /v2/ground` 有法源與拒答都回 200，以 `outcome` 區分。",
    "version": "v2"
  },
  "paths": {
    "/v2/me": {
      "get": {
        "tags": [
          "租戶"
        ],
        "summary": "目前的租戶",
        "description": "此 API key 所屬的租戶。",
        "operationId": "GetCurrentTenant",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantResponse"
                }
              }
            }
          },
          "401": {
            "description": "API key 缺少、無效、已過期或已撤銷。"
          },
          "429": {
            "description": "超過本租戶方案的速率限制。"
          }
        }
      }
    },
    "/v2/api-keys": {
      "get": {
        "tags": [
          "租戶"
        ],
        "summary": "列出本租戶的 API key",
        "description": "依建立時間排序；只回傳前綴，不回傳 key 本身。",
        "operationId": "ListApiKeys",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApiKeySummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "API key 缺少、無效、已過期或已撤銷。"
          },
          "429": {
            "description": "超過本租戶方案的速率限制。"
          }
        }
      }
    },
    "/v2/api-keys/{id}": {
      "delete": {
        "tags": [
          "租戶"
        ],
        "summary": "撤銷 API key",
        "description": "撤銷後立即失效；重複撤銷不改變原撤銷時間。",
        "operationId": "RevokeApiKey",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          },
          "401": {
            "description": "API key 缺少、無效、已過期或已撤銷。"
          },
          "429": {
            "description": "超過本租戶方案的速率限制。"
          }
        }
      }
    },
    "/v2/usage": {
      "get": {
        "tags": [
          "租戶"
        ],
        "summary": "本租戶的用量",
        "description": "依操作分列的呼叫次數與計量單位。成功的呼叫才計量；拒答是成功的呼叫。",
        "operationId": "GetUsage",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UsageSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "API key 缺少、無效、已過期或已撤銷。"
          },
          "429": {
            "description": "超過本租戶方案的速率限制。"
          }
        }
      }
    },
    "/v2/laws/{lawId}": {
      "get": {
        "tags": [
          "法規"
        ],
        "summary": "取得法規",
        "description": "`lawId` 為全國法規資料庫的 pcode（如 `O0020001`）；標題取自 `asOf` 當日有效的版本，省略 `asOf`（`YYYY-MM-DD`）表示現行。該日沒有有效的版本回 404，不會退回現行版本。成功計量為一次 `ontology.get_law`。",
        "operationId": "GetLaw",
        "parameters": [
          {
            "name": "lawId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "asOf",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LawDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "API key 缺少、無效、已過期或已撤銷。"
          },
          "429": {
            "description": "超過本租戶方案的速率限制。"
          },
          "402": {
            "description": "本租戶目前沒有有效的方案（完全付費制）。請聯絡業務啟用。"
          }
        }
      }
    },
    "/v2/laws/{lawId}/articles": {
      "get": {
        "tags": [
          "法規"
        ],
        "summary": "列出法規某日有效的各條",
        "description": "依條次排序；`number` 照來源寫法（如 `5-1`）。省略 `asOf`（`YYYY-MM-DD`）表示現行；該日沒有有效的版本回 404，不會退回現行版本。成功計量為一次 `ontology.list_articles`。",
        "operationId": "ListArticles",
        "parameters": [
          {
            "name": "lawId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "asOf",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ArticleDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "API key 缺少、無效、已過期或已撤銷。"
          },
          "429": {
            "description": "超過本租戶方案的速率限制。"
          },
          "402": {
            "description": "本租戶目前沒有有效的方案（完全付費制）。請聯絡業務啟用。"
          }
        }
      }
    },
    "/v2/search": {
      "post": {
        "tags": [
          "法規"
        ],
        "summary": "搜尋條文",
        "description": "以字面檢索查詢某日有效的條文，相關度高的在前。`query` 必填，為原始文字（服務端自行分詞）；`asOf` 為 ISO 8601 日期（`YYYY-MM-DD`），省略表示現行；`limit` 為 1–50，省略為 10。用 POST 是為了讓查詢文字不出現在網址裡；查詢文字不寫入日誌。成功計量為一次 `ontology.search`（0 筆命中也計一次）。",
        "operationId": "SearchArticles",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SearchHitDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "API key 缺少、無效、已過期或已撤銷。"
          },
          "429": {
            "description": "超過本租戶方案的速率限制。"
          },
          "402": {
            "description": "本租戶目前沒有有效的方案（完全付費制）。請聯絡業務啟用。"
          }
        }
      }
    },
    "/v2/reasoning/evaluate": {
      "post": {
        "tags": [
          "推論"
        ],
        "summary": "對案件事實推論",
        "description": "依行為日與裁處日當天有效、已通過驗證的規範陳述，對案件事實推論，回傳**候選**結論與依據；系統不裁量、不判決。`atDecision` 是裁處時之法律（行政罰法第 5 條的預設），`earlier` 是行為日到裁處日之間陳述組與裁處時不同的法律，「最有利於受處罰者」由呼叫端依第 5 條但書選擇。沒有通過驗證的陳述就沒有結論：`verdicts` 為空不表示合規。`uncoveredLawIds` 列出語料沒有當時版本的法規，其規定缺席不代表當時沒有規定。`administrativePenalty` 省略的欄位是「未知」，不是「否」。推論是唯讀、確定性的，重試安全。成功計量為一次 `reasoning.evaluate`；推論容量用盡回 503（`retryable`）。",
        "operationId": "EvaluateReasoning",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateReasoningRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReasoningResultDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "API key 缺少、無效、已過期或已撤銷。"
          },
          "429": {
            "description": "超過本租戶方案的速率限制。"
          },
          "402": {
            "description": "本租戶目前沒有有效的方案（完全付費制）。請聯絡業務啟用。"
          }
        }
      }
    },
    "/v2/ground": {
      "post": {
        "tags": [
          "接地"
        ],
        "summary": "為問句備妥可引用的法源，或拒答",
        "description": "有法源（`grounded`）與拒答（`refused`）都回 200，以 `outcome` 區分；拒答是結果、不是錯誤，兩者都計量為一次 `consult.ground`。每一筆法源有代號（`L1`、`L2`…），呼叫端的模型只能以代號引用。\n\n可帶 `Idempotency-Key`（1–255 個字元，限英數與 `-_.:~`）讓重送安全：同一租戶、同一 key 在視窗內重送，回放第一次的回應（加 `Idempotent-Replayed: true`）且不再計量；同一個 key 帶不同的請求內容回 422。只有成功的回應會被記住，錯誤（4xx／5xx）不會，重送會重新處理。",
        "operationId": "Ground",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GroundRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroundResultDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "API key 缺少、無效、已過期或已撤銷。"
          },
          "429": {
            "description": "超過本租戶方案的速率限制。"
          },
          "402": {
            "description": "本租戶目前沒有有效的方案（完全付費制）。請聯絡業務啟用。"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdministrativePenaltyFactsDto": {
        "required": [
          "intent",
          "negligence",
          "agentFault",
          "age",
          "incapable",
          "selfInduced",
          "pursuantToLaw",
          "superiorOrder",
          "knewIllegal",
          "statedOpinion",
          "selfDefense",
          "defenseExcessive",
          "necessity",
          "necessityExcessive",
          "capacityReduced",
          "ignoranceOfLaw"
        ],
        "type": "object",
        "properties": {
          "intent": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "negligence": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "agentFault": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "age": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "incapable": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "selfInduced": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "pursuantToLaw": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "superiorOrder": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "knewIllegal": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "statedOpinion": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "selfDefense": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "defenseExcessive": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "necessity": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "necessityExcessive": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "capacityReduced": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "ignoranceOfLaw": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "ApiKeySummary": {
        "required": [
          "id",
          "name",
          "prefix",
          "scopes",
          "createdAt",
          "expiresAt",
          "revokedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "revokedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "ArticleDto": {
        "required": [
          "uri",
          "number"
        ],
        "type": "object",
        "properties": {
          "uri": {
            "type": "string"
          },
          "number": {
            "type": "string"
          }
        }
      },
      "AuthorityDto": {
        "required": [
          "code",
          "uri",
          "citation",
          "text"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "citation": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "ConditionRoleDto": {
