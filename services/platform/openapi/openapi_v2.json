            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/OutcomeDto"
          }
        }
      },
      "EvaluateReasoningRequest": {
        "required": [
          "conductOn",
          "decidedOn",
          "facts",
          "administrativePenalty",
          "conductEndedOn",
          "resultOn"
        ],
        "type": "object",
        "properties": {
          "conductOn": {
            "type": [
              "null",
              "string"
            ]
          },
          "decidedOn": {
            "type": [
              "null",
              "string"
            ]
          },
          "facts": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/FactDto"
            }
          },
          "administrativePenalty": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AdministrativePenaltyFactsDto"
              }
            ]
          },
          "conductEndedOn": {
            "type": [
              "null",
              "string"
            ]
          },
          "resultOn": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ExcuseDto": {
        "enum": [
          "NoFault",
          "UnderFourteen",
          "Incapable",
          "PursuantToLaw",
          "SuperiorOrder",
          "SelfDefense",
          "Necessity"
        ]
      },
      "FactDto": {
        "required": [
          "concept",
          "numbers",
          "flags"
        ],
        "type": "object",
        "properties": {
          "concept": {
            "type": "string"
          },
          "numbers": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "flags": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "boolean"
            }
          },
          "concepts": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "FineIntervalDto": {
        "required": [
          "minAmount",
          "maxAmount"
