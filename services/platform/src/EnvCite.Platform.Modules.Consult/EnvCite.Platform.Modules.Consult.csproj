<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnvCite.Platform.SharedKernel\EnvCite.Platform.SharedKernel.csproj" />
    <ProjectReference Include="..\EnvCite.Platform.Modules.Ontology\EnvCite.Platform.Modules.Ontology.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Grpc.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Contract source of truth: the repo-root proto/. Server stubs are generated too, for test fakes. -->
    <Protobuf Include="../../../../proto/envcite/consult/v2/consult.proto"
              ProtoRoot="../../../../proto"
              GrpcServices="Both" />
    <Protobuf Include="../../../../proto/envcite/ontology/v2/ontology.proto"
              ProtoRoot="../../../../proto"
              CompileOutputs="false" />
  </ItemGroup>

</Project>
