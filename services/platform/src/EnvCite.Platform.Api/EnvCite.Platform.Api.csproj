<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- 對外 REST 的契約：建置時產生 openapi/openapi_v2.json 並提交進版控，CI 檢查它與程式碼一致。 -->
  <PropertyGroup>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi --openapi-version OpenApi3_1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <!--
    Razor 元件在 EnvCite.Platform.Web（RCL）裡，這個主機專案自己沒有 .razor 檔，SDK 不會自動判定
    它是 Blazor 應用，也就不會附上 _framework/blazor.web.js。明確要求，否則瀏覽器拿到 404，
    互動連線（circuit）建不起來。
  -->
  <PropertyGroup>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Finbuckle.MultiTenant.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnvCite.Platform.Modules.Tenancy\EnvCite.Platform.Modules.Tenancy.csproj" />
    <ProjectReference Include="..\EnvCite.Platform.Modules.ApiAccess\EnvCite.Platform.Modules.ApiAccess.csproj" />
    <ProjectReference Include="..\EnvCite.Platform.Modules.Audit\EnvCite.Platform.Modules.Audit.csproj" />
    <ProjectReference Include="..\EnvCite.Platform.Modules.Ontology\EnvCite.Platform.Modules.Ontology.csproj" />
    <ProjectReference Include="..\EnvCite.Platform.Modules.Metering\EnvCite.Platform.Modules.Metering.csproj" />
    <ProjectReference Include="..\EnvCite.Platform.Modules.Consult\EnvCite.Platform.Modules.Consult.csproj" />
    <ProjectReference Include="..\EnvCite.Platform.Modules.Conversations\EnvCite.Platform.Modules.Conversations.csproj" />
    <ProjectReference Include="..\EnvCite.Platform.Modules.Members\EnvCite.Platform.Modules.Members.csproj" />
    <ProjectReference Include="..\EnvCite.Platform.Data\EnvCite.Platform.Data.csproj" />
    <ProjectReference Include="..\EnvCite.Platform.Web\EnvCite.Platform.Web.csproj" />
  </ItemGroup>

</Project>
