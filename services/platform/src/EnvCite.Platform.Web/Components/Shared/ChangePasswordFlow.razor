@inherits FormPageBase<PasswordForm>
@* 改密碼的整段流程：說明、錯誤、表單、送出與成功後的導向。營運者（/ui/password）與客戶入口（/portal/{租戶}/password）共用，
   差別只剩外框（標題、卡片、登出鈕）、帳號服務（兩邊都是 IAccountLifecycle）、成功後去哪裡與初始密碼的提醒文字，由頁面以參數給。
   不論成敗，三個密碼欄都不寫回表單（理由見登入）：失敗時使用者重打，比把密碼回傳安全。 *@
@if (Pending)
{
    <FormAlert Kind="AlertKind.Info">@PendingText</FormAlert>
}
else
{
    <p class="ep-page-description">@L["改完後，其他裝置上的登入會失效。"]</p>
}

<FormAlert Message="@Error" />

<PostForm Model="Input" FormName="@FormName" OnValidSubmit="ChangeAsync">
    <FormField For="current" Label="@L["目前的密碼"]">
        <PasswordField Id="current" @bind-Value="Input.Current" AutoFocus="true" />
    </FormField>
    <NewPasswordField Id="new" Label="@L["新密碼"]" @bind-Value="Input.New" />
    <FormField For="confirm" Label="@L["再輸入一次新密碼"]">
        <PasswordField Id="confirm" @bind-Value="Input.Confirm" Autocomplete="new-password" />
    </FormField>
    <SubmitButton>@L["改密碼"]</SubmitButton>
</PostForm>

@code {
    [Parameter, EditorRequired]
    public IAccountLifecycle Account { get; set; } = default!;

    /// <summary>表單的名稱，在站內要唯一（框架靠它找到處理常式）。</summary>
    [Parameter, EditorRequired]
    public string FormName { get; set; } = string.Empty;

    /// <summary>改成功之後回到哪裡：還沒註冊驗證器的話，授權會把這個請求再導去註冊頁。</summary>
    [Parameter, EditorRequired]
    public string HomePath { get; set; } = string.Empty;

    /// <summary>初始密碼（經手的人看過）的提醒：還在等使用者改掉它時顯示。</summary>
    [Parameter, EditorRequired]
    public string PendingText { get; set; } = string.Empty;

    /// <summary>這個 session 是否還在等使用者改掉經手的密碼。</summary>
    private bool Pending => User.FindFirst(PlatformClaimTypes.PasswordChangeRequired) is not null;

    private async Task ChangeAsync()
    {
        var (current, next, confirm) = (Input.Current, Input.New, Input.Confirm);
        Input.Current = Input.New = Input.Confirm = string.Empty;

        if (!string.Equals(next, confirm, StringComparison.Ordinal))
        {
            Error = L["兩次輸入的新密碼不一樣。"];
            return;
        }

        var changed = await Account.ChangePasswordAsync(User, current, next, HttpContext.RequestAborted);
        if (changed.IsOk)
        {
            Navigation.NavigateTo(HomePath);
            return;
        }

        Error = Describe(changed, L["改密碼失敗。"]);
    }
}
