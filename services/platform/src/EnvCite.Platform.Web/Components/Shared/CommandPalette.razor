@* 切換器：搜尋後台的頁面與租戶，Enter 開啟第一筆，Esc 關閉。頂欄的按鈕或 ⌘K／Ctrl+K 開啟（見 wwwroot/design/shortcuts.js）。
   只用現有的資料（頁面清單與租戶目錄），沒有動作與假資料。 *@
@inject ITenantDirectory Directory
@inject NavigationManager Navigation

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_query" Immediate="true" AutoFocus="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Placeholder="@L["搜尋頁面與租戶"]" aria-label="@L["搜尋頁面與租戶"]" Clearable="true" OnKeyUp="OnKeyUp" />

        @if (Pages.Count == 0 && Tenants.Count == 0)
        {
            <p class="ep-page-description ep-palette-empty" role="status">@L["沒有符合「{0}」的頁面或租戶", _query!]</p>
        }
        else
        {
            @if (Pages.Count > 0)
            {
                <p class="ep-palette-group">@L["頁面"]</p>
                <ul class="ep-palette-list" aria-label="@L["頁面"]">
                    @foreach (var entry in Pages)
                    {
                        <li><a class="ep-palette-item" href="@entry.Href" @onclick="() => MudDialog.Close()">@entry.Label</a></li>
                    }
                </ul>
            }

            @if (Tenants.Count > 0)
            {
                <p class="ep-palette-group">@L["租戶"]</p>
                <ul class="ep-palette-list" aria-label="@L["租戶"]">
                    @foreach (var tenant in Tenants)
                    {
                        <li>
                            <a class="ep-palette-item" href="@TenantHref(tenant)" @onclick="() => MudDialog.Close()">
                                <span>@(tenant.Name ?? tenant.Identifier)</span>
                                <code class="ep-mono ep-secondary">@tenant.Identifier</code>
                            </a>
                        </li>
                    }
                </ul>
            }
        }
    </DialogContent>
</MudDialog>

@code {
    private const int MaxTenants = 8;

    private sealed record PageLink(string Href, string Label);

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private IReadOnlyList<TenantSummary> _all = [];
    private string? _query;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _all = await Directory.ListAsync(CancellationToken.None);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _all = []; // 租戶載入失敗時，頁面仍然可以搜尋。
        }
    }

    private bool HasQuery => !string.IsNullOrWhiteSpace(_query);

    private bool Match(string? text) => !HasQuery || (text?.Contains(_query!.Trim(), StringComparison.OrdinalIgnoreCase) ?? false);

    private IReadOnlyList<PageLink> Pages =>
        [.. new PageLink[]
        {
            new("/ui", L["總覽"]), new("/ui/tenants", L["租戶"]), new("/ui/operators", L["營運者"]), new("/ui/audit", L["稽核紀錄"]),
            new(UiEndpoints.PasswordPath, L["改密碼"]), new(UiEndpoints.SecurityPath, L["兩步驟驗證"]),
        }.Where(p => Match(p.Label))];

    private IReadOnlyList<TenantSummary> Tenants =>
        [.. _all.Where(t => Match(t.Name) || Match(t.Identifier)).OrderBy(t => t.Identifier, StringComparer.Ordinal).Take(MaxTenants)];

    private static string TenantHref(TenantSummary tenant) => $"/ui/tenants/{Uri.EscapeDataString(tenant.Id)}";

    private void OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key != "Enter")
        {
            return;
        }

        var first = Pages.Select(p => p.Href).Concat(Tenants.Select(TenantHref)).FirstOrDefault();
        if (first is not null)
        {
            MudDialog.Close();
            Navigation.NavigateTo(first);
        }
    }
}
