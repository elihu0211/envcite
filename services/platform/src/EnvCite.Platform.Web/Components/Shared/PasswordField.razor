@using System.Linq.Expressions

@* 密碼欄：輸入框加一顆「顯示／隱藏」眼睛鈕。入口與帳號頁是靜態渲染（沒有 circuit），所以切換由
   design/forms.js 做；沒有 JavaScript 時鈕不顯示（見樣式表的 html[data-js]），欄位仍是普通的密碼欄。
   標籤與說明文字由呼叫端的 <label for> 與 DescribedBy 負責，這裡只管欄位本身。 *@
<div class="ep-password">
    <InputText id="@Id" Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression" type="password" class="ep-input"
               autocomplete="@Autocomplete" required="@Required" autofocus="@AutoFocus" minlength="@MinLength" maxlength="@MaxLength" aria-describedby="@DescribedBy"
               spellcheck="false" autocapitalize="off" autocorrect="off" />
    <button type="button" class="ep-password-toggle" aria-controls="@Id" aria-label="@L["顯示密碼"]"
            data-label-show="@L["顯示密碼"]" data-label-hide="@L["隱藏密碼"]">
        <span class="ep-password-eye"><NavIcon Path="@Icons.Material.Outlined.Visibility" /></span>
        <span class="ep-password-eye-off"><NavIcon Path="@Icons.Material.Outlined.VisibilityOff" /></span>
    </button>
</div>
@* 大寫鎖定的提醒：先留著空的狀態區（螢幕閱讀器才會在內容出現時念出來），forms.js 在大寫鎖定開著時填字。 *@
<p class="ep-hint ep-password-caps" role="status" data-text="@L["Caps Lock 已開啟"]"></p>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<string?>>? ValueExpression { get; set; }

    /// <summary>瀏覽器與密碼管理員靠它分辨「目前的密碼」與「新密碼」：<c>current-password</c>、<c>new-password</c>。</summary>
    [Parameter]
    public string Autocomplete { get; set; } = "current-password";

    [Parameter]
    public bool Required { get; set; } = true;

    [Parameter]
    public bool AutoFocus { get; set; }

    [Parameter]
    public int? MinLength { get; set; }

    [Parameter]
    public int? MaxLength { get; set; }

    [Parameter]
    public string? DescribedBy { get; set; }
}
