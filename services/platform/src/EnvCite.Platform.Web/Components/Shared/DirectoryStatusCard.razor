@inject IDirectoryAvailability Availability
@inject TimeProvider Time
@* 目錄同步的狀態（營運者看租戶、客戶的擁有者看自己的組織都是這一張）：連線健不健康、最後一次收到請求、同步了多少人、
   SCIM 的網址與 token 的清單。只呈現，不做事：動作（簽發、撤銷、緊急關閉）由嵌它的頁面透過 Actions、TokenActions
   與 ChildContent 放進來，所以靜態的入口（普通表單）與互動的後台（按鈕）共用同一張。全部由 SectionCard、StatGrid、
   DataTable、StatusBadge、CopyButton 這些模板組成，沒有自己的標記與樣式。 *@
<SectionCard Id="@Id" Title="@L["目錄同步"]" Actions="Actions">
    <ChildContent>
        <p class="ep-page-description">@L["客戶的身分來源（Entra ID、Okta、Google Workspace）以 SCIM 把成員推進這個租戶。停用是停用，不是刪除；帳號與稽核紀錄都保留。"]</p>
        <p class="ep-meta">
            <StatusBadge Tone="@ConnectionTone">@ConnectionText</StatusBadge>
            @if (Status.LastFailureCode is { } failure)
            {
                <StatusBadge Tone="error">@L["最近被拒絕：{0}", OutcomeText.OfCode(failure)]</StatusBadge>
            }
        </p>

        <StatGrid Items="Stats" Label="@L["目錄同步摘要"]" />

        <div class="ep-copy-group">
            <CopyButton Id="@($"{Id}-scim-url")" Label="@L["複製 SCIM Base URL"]" Value="@BaseUrl" />
        </div>

        @if (Status.Tokens.Count == 0)
        {
            <p class="ep-page-description">@L["還沒有目錄同步 token。簽發一把交給身分來源，它才能連線。"]</p>
        }
        else
        {
            <DataTable Items="Status.Tokens" Columns="TokenColumns" Label="@L["目錄同步 token"]" Plain="Plain" />
        }

        <h3 class="ep-subsection-title">@L["群組"]</h3>
        @if (Status.Groups.Count == 0)
        {
            <p class="ep-page-description">@L["身分來源還沒有推送群組。推送之後，在這裡決定每個群組給什麼角色。"]</p>
        }
        else
        {
            <p class="ep-hint">@L["有對映角色的群組，其成員的角色依群組決定（屬於多個時取最高）；沒有對映的群組不影響任何人。"]</p>
            <DataTable Items="Status.Groups" Columns="GroupColumns" Label="@L["目錄同步群組"]" Plain="Plain" />
        }

        @ChildContent
    </ChildContent>
</SectionCard>

@code {
    [Parameter, EditorRequired]
    public DirectoryStatus Status { get; set; } = default!;

    /// <summary>身分來源要填的 SCIM Base URL（含 <c>/scim/v2</c>）。</summary>
    [Parameter, EditorRequired]
    public string BaseUrl { get; set; } = string.Empty;

    /// <summary>同一頁有不只一張時，每張的 id 不能重複。</summary>
    [Parameter]
    public string Id { get; set; } = "directory";

    /// <summary>入口（靜態渲染）用純表格外觀，後台用 MudBlazor 的表格。</summary>
    [Parameter]
    public bool Plain { get; set; }

    /// <summary>標題列右側的動作（例如營運者的緊急關閉）。</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>每把 token 那一列的動作（例如撤銷）；沒給就沒有動作欄。</summary>
    [Parameter]
    public RenderFragment<DirectoryTokenInfo>? TokenActions { get; set; }

    /// <summary>每個群組那一列的動作（例如選對映的角色）；沒給就沒有動作欄，營運者只看。</summary>
    [Parameter]
    public RenderFragment<DirectoryGroupInfo>? GroupActions { get; set; }

    /// <summary>卡片底部：設定與簽發的表單等。</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private DateTimeOffset Now => Time.GetUtcNow();

    private (string Tone, string Text) Connection =>
        !Status.Settings.Enabled ? ("neutral", L["已關閉"])
        : Status.LastRequestAt is not { } last ? ("warning", L["等待身分來源連線"])
        : Now - last > Availability.StaleAfter ? ("warning", L["久未收到請求"])
        : ("success", L["運作中"]);

    private string ConnectionTone => Connection.Tone;

    private string ConnectionText => Connection.Text;

    private IReadOnlyList<StatItem> Stats =>
    [
        new(L["受管成員"], Status.ManagedMembers.ToString("N0", System.Globalization.CultureInfo.CurrentCulture), L["由身分來源管理角色與停用"]),
        new(L["最後收到請求"], Status.LastRequestAt is { } last ? TaipeiTime.Clock(last) : "—",
            Status.LastRequestAt is { } at ? L["台北 {0}", TaipeiTime.Date(at)].Value : L["尚未連線"].Value),
        new(L["同步次數"], (Status.Created + Status.Updated + Status.Deactivated).ToString("N0", System.Globalization.CultureInfo.CurrentCulture),
            L["建立 {0}・更新 {1}・停用 {2}", Status.Created, Status.Updated, Status.Deactivated]),
        new(L["被拒絕"], Status.Rejected.ToString("N0", System.Globalization.CultureInfo.CurrentCulture), L["規則不允許的變更"]),
    ];

    private (string Tone, string Text) TokenState(DirectoryTokenInfo token) =>
        token.RevokedAt is not null ? ("neutral", L["已撤銷"])
        : token.ExpiresAt is { } expires && expires <= Now ? ("warning", L["已過期"])
        : ("success", L["有效"]);

    private IReadOnlyList<ColumnDef<DirectoryGroupInfo>> GroupColumns
    {
        get
        {
            List<ColumnDef<DirectoryGroupInfo>> columns =
            [
                new() { Title = L["名稱"], Class = "ep-keep", Labeled = false, Cell = group => @<text>@group.DisplayName</text> },
                new() { Title = L["成員數"], Class = "ep-num", Cell = group => @<text>@group.MemberCount.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)</text> },
                new()
                {
                    Title = L["對映的角色"],
                    Cell = group => @<text>
                        @if (group.Role is { } role)
                        {
                            <StatusBadge Tone="info">@PortalLabels.Role(role)</StatusBadge>
                        }
                        else
                        {
                            <StatusBadge>@L["不對映"]</StatusBadge>
                        }
                    </text>,
                },
            ];

            if (GroupActions is { } actions)
            {
                columns.Add(new() { Title = L["操作"], HideTitle = true, Labeled = false, Class = "ep-row-actions", Cell = group => actions(group) });
            }

            return columns;
        }
    }

    private IReadOnlyList<ColumnDef<DirectoryTokenInfo>> TokenColumns
    {
        get
        {
            List<ColumnDef<DirectoryTokenInfo>> columns =
            [
                new() { Title = L["名稱"], Class = "ep-keep", Labeled = false, Cell = token => @<text>@token.Name</text> },
                new() { Title = L["前綴"], Cell = token => @<text><code class="ep-mono">@token.Prefix</code></text> },
                new()
                {
                    Title = L["建立（台北）"], Label = L["建立"],
                    Cell = token => @<text><time datetime="@TaipeiTime.Full(token.CreatedAt)">@TaipeiTime.Format(token.CreatedAt)</time></text>,
                },
                new()
                {
                    Title = L["到期（台北）"], Label = L["到期"],
                    Cell = token => @<text>@(token.ExpiresAt is { } expires ? TaipeiTime.Format(expires) : L["不會到期"].Value)</text>,
                },
                new()
                {
                    Title = L["最後使用（台北）"], Label = L["最後使用"],
                    Cell = token => @<text>@(token.LastUsedAt is { } used ? TaipeiTime.Format(used) : "—")</text>,
                },
                new() { Title = L["狀態"], Cell = token => @<text><StatusBadge Tone="@TokenState(token).Tone">@TokenState(token).Text</StatusBadge></text> },
            ];

            if (TokenActions is { } actions)
            {
                columns.Add(new() { Title = L["操作"], HideTitle = true, Labeled = false, Class = "ep-row-actions", Cell = token => actions(token) });
            }

            return columns;
        }
    }
}
