@inherits FormPageBase<ActivateForm>
@* 啟用連結（邀請或驗證信箱）的整段流程：檢視連結、設定密碼或確認信箱、成功後回登入頁。營運者（/ui/activate）與客戶入口
   （/portal/{租戶}/activate）共用，差別由頁面以參數與外框（Layout）給：帳號服務（IAccountLifecycle）、表單名稱、登入頁網址。
   標題由連結的狀態決定，所以流程把標題與主體交給 Layout，頁面決定它們放在哪裡、包在什麼卡片裡。
   只是開啟網頁不會用掉連結（信件掃描器會預先開啟），送出表單才會；密碼不寫回表單。 *@
@Layout(new ActivationView(Heading, Body))

@code {
    [Parameter, EditorRequired]
    public IAccountLifecycle Account { get; set; } = default!;

    [Parameter, EditorRequired]
    public string FormName { get; set; } = string.Empty;

    /// <summary>登入頁：成功後帶著 <c>?activated=1</c> 回去，連結無效時的「回登入頁」也指向它。</summary>
    [Parameter, EditorRequired]
    public string LoginPath { get; set; } = string.Empty;

    /// <summary>頁面外框：收到標題與主體，決定排版。</summary>
    [Parameter, EditorRequired]
    public RenderFragment<ActivationView> Layout { get; set; } = default!;

    /// <summary>設定密碼時多一句說明（選填），例如營運者還要接著綁定驗證器。</summary>
    [Parameter]
    public string? SetPasswordNote { get; set; }

    [SupplyParameterFromQuery(Name = "userId")] private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "code")] private string? Code { get; set; }

    private ActivationState _state;

    private string Heading => _state switch
    {
        ActivationState.SetPassword => L["設定密碼"],
        ActivationState.ConfirmEmail => L["驗證信箱"],
        _ => L["連結無效"],
    };

    private RenderFragment Body => @<text>
        <FormAlert Message="@Error" />

        @switch (_state)
        {
            case ActivationState.SetPassword:
                <p class="ep-page-description">@L["設定你自己的密碼，並完成信箱驗證。這條連結只能使用一次。"]</p>
                @if (!string.IsNullOrEmpty(SetPasswordNote))
                {
                    <p class="ep-note">@SetPasswordNote</p>
                }
                <PostForm Model="Input" FormName="@FormName" OnValidSubmit="SubmitAsync">
                    <NewPasswordField Id="new" Label="@L["新密碼"]" @bind-Value="Input.New" AutoFocus="true" />
                    <FormField For="confirm" Label="@L["再輸入一次新密碼"]">
                        <PasswordField Id="confirm" @bind-Value="Input.Confirm" Autocomplete="new-password" />
                    </FormField>
                    <SubmitButton>@L["設定密碼"]</SubmitButton>
                </PostForm>
                break;
            case ActivationState.ConfirmEmail:
                <p class="ep-page-description">@L["按下確認，表示這個信箱是你的。"]</p>
                <PostForm Model="Input" FormName="@FormName" OnValidSubmit="SubmitAsync">
                    <SubmitButton>@L["確認信箱"]</SubmitButton>
                </PostForm>
                break;
            default:
                @* 表單要在 POST 時也存在，Blazor 才找得到處理常式：連結剛被用掉時重複送出（連按兩次、舊分頁），
                   就會落到這裡而不是一頁框架的錯誤訊息。這張表單沒有欄位、也不顯示。 *@
                <EditForm Model="Input" FormName="@FormName" OnValidSubmit="SubmitAsync" method="post" hidden="hidden"></EditForm>
                <FormAlert>@L["這個連結無效或已過期。請洽管理者重新寄送邀請。"]</FormAlert>
                <p><a class="ep-link" href="@LoginPath">@L["回登入頁"]</a></p>
                break;
        }
    </text>;

    protected override async Task OnInitializedAsync()
    {
        // 網址帶著權杖：不讓它經 Referer 流到別的網站（OWASP）。
        HttpContext.Response.Headers["Referrer-Policy"] = "no-referrer";

        // 只是檢視，不用掉連結：信件掃描器預先開啟網址不會讓它失效。
        _state = await Account.InspectActivationAsync(UserId, Code, HttpContext.RequestAborted);
    }

    private async Task SubmitAsync()
    {
        var (next, confirm) = (Input.New, Input.Confirm);
        Input.New = Input.Confirm = string.Empty; // 密碼不寫回表單

        if (_state == ActivationState.SetPassword && !string.Equals(next, confirm, StringComparison.Ordinal))
        {
            Error = L["兩次輸入的新密碼不一樣。"];
            return;
        }

        var activated = await Account.ActivateAsync(UserId, Code, next, HttpContext.RequestAborted);
        if (activated.IsOk)
        {
            Navigation.NavigateTo($"{LoginPath}?activated=1");
            return;
        }

        _state = await Account.InspectActivationAsync(UserId, Code, HttpContext.RequestAborted);

        // 連結已無效：頁面本身就說明了，不再重複一條錯誤。
        Error = _state == ActivationState.Invalid ? null : Describe(activated, L["操作失敗。"]);
    }
}
