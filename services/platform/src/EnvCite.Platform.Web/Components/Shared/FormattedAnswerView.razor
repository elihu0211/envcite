@using EnvCite.Platform.Web.Components.Shared.Answer
@* 強型別回答文件的呈現：依積木型別映射到各自的元件（Answer/）；引用代號的查找與點擊經 CitationContext 級聯下去。 *@
@if (Document is { Blocks.Count: > 0 })
{
    <CascadingValue Value="_citations">
        <div class="ep-ans-body">
            @foreach (var block in Document.Blocks)
            {
                @switch (block)
                {
                    case CalloutBlock callout:
                        <CalloutView Block="callout" />
                        break;
                    case ProseBlock prose:
                        <ProseView Block="prose" />
                        break;
                    case ChecklistBlock checklist:
                        <ChecklistView Block="checklist" />
                        break;
                    case ComparisonTableBlock table:
                        <ComparisonTableView Block="table" />
                        break;
                    case WorkflowBlock workflow:
                        <WorkflowView Block="workflow" />
                        break;
                }
            }
        </div>
    </CascadingValue>
}
