@using System.Linq.Expressions

@* 設定或修改密碼的「新密碼」欄位模板：標籤、密碼欄（眼睛鈕、大寫鎖定提醒、new-password）與一份短清單合在一起。
   所有要使用者想新密碼的頁面（啟用、改密碼；後台與入口）都用它，數字取自 PasswordPolicy（與伺服器端驗證同源），
   頁面不自己寫提示、minlength 或清單。清單只有三條：長度（有 JavaScript 時即時打勾，並說還差幾個）、
   不含 email、避開常見與規律的密碼——後兩條由伺服器檢查，說明永遠在、不假裝即時。沒有 JavaScript 也完整（minlength／maxlength 照舊）。
   螢幕閱讀器只在長度剛夠的那一刻被通知，不逐字念。 *@
<div class="ep-field-row">
    <label for="@Id" class="ep-label">@Label</label>
    <PasswordField Id="@Id" Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression" Autocomplete="new-password"
                   AutoFocus="@AutoFocus" MinLength="@PasswordPolicy.MinimumLength" MaxLength="@PasswordPolicy.MaximumLength" DescribedBy="@GuideId" />
    <div id="@GuideId" class="ep-password-guide" data-min="@PasswordPolicy.MinimumLength"
         data-text-short="@L["還差 {0} 個", "{0}"]" data-text-ok="@L["長度夠了"]">
        <ul class="ep-hint ep-password-rules">
            <li data-rule="length">
                <span>@L["至少 {0} 個字元", PasswordPolicy.MinimumLength]</span>
                <span class="ep-password-remaining" aria-hidden="true"></span>
            </li>
            <li><span>@L["不含你的 email"]</span></li>
            <li><span>@L["避開常見密碼與連續、重複的字元"]</span></li>
        </ul>
        <p class="ep-hint">@L["不必混用大小寫或符號，幾個不相干的詞連起來就好。"]</p>
        <p class="ep-visually-hidden ep-password-announce" role="status"></p>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    /// <summary>欄位的標籤（例如「新密碼」）。</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<string?>>? ValueExpression { get; set; }

    [Parameter]
    public bool AutoFocus { get; set; }

    private string GuideId => $"{Id}-guide";
}
