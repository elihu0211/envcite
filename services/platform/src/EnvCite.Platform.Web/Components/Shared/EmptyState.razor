@* 沒有資料時的畫面：說明現在是什麼狀態、下一步可以做什麼，而不是一片空白。只有文字，不放裝飾圖示。 *@
<div class="ep-empty">
    <h2 class="ep-empty-title">@Title</h2>
    @if (!string.IsNullOrEmpty(Description))
    {
        <p>@Description</p>
    }
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    /// <summary>下一步的動作（按鈕或連結）。</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
