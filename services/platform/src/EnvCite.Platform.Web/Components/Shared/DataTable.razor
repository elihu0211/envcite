@typeparam TItem
@* 資料表：欄位由 ColumnDef 清單宣告，標題列、窄螢幕的 data-label 與列的標記只在這裡寫。
   兩種外觀共用同一份欄位：預設是後台的 MudSimpleTable（ep-table ep-cards）；Plain 是客戶入口的純 table（靜態渲染，也能放進表單，
   儲存格裡的按鈕與欄位照常送出）。排序與翻頁不在這裡：需要時由頁面決定列的順序與範圍。 *@
@if (Plain)
{
    <div class="ep-table-wrap">
        <table class="ep-plain-table" aria-label="@Label">@Content</table>
    </div>
}
else
{
    <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="ep-table ep-cards" aria-label="@Label">@Content</MudSimpleTable>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<ColumnDef<TItem>> Columns { get; set; } = [];

    /// <summary>表格的名稱（aria-label）。</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>客戶入口的純 table 外觀。</summary>
    [Parameter]
    public bool Plain { get; set; }

    // 排序：只在後台（互動式）的表格。點標題依序切換 升冪 → 降冪 → 回到原順序；沒有點過就依 InitialSort。
    private ColumnDef<TItem>? _sortColumn;
    private bool _descending;
    private bool _sortTouched;

    protected override void OnParametersSet()
    {
        if (_sortTouched || Plain)
            return;

        var initial = Columns.FirstOrDefault(column => column.SortBy is not null && column.InitialSort != ColumnSort.None);
        (_sortColumn, _descending) = initial is null ? (null, false) : (initial, initial.InitialSort == ColumnSort.Descending);
    }

    private bool Sortable(ColumnDef<TItem> column) => !Plain && column.SortBy is not null && !column.HideTitle;

    private void ToggleSort(ColumnDef<TItem> column)
    {
        _sortTouched = true;
        if (!ReferenceEquals(_sortColumn, column))
            (_sortColumn, _descending) = (column, false);
        else if (!_descending)
            _descending = true;
        else
            (_sortColumn, _descending) = (null, false);
    }

    private string? AriaSort(ColumnDef<TItem> column) =>
        !Sortable(column) ? null : !ReferenceEquals(_sortColumn, column) ? "none" : _descending ? "descending" : "ascending";

    private string SortIcon(ColumnDef<TItem> column) =>
        !ReferenceEquals(_sortColumn, column) ? Icons.Material.Filled.UnfoldMore
            : _descending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward;

    /// <summary>目前要畫的列（排序見 <see cref="ColumnSorter"/>）。</summary>
    private IEnumerable<TItem> Rows => _sortColumn?.SortBy is { } sortBy ? ColumnSorter.Order(Items, sortBy, _descending) : Items;

    private static string? CellClass(ColumnDef<TItem> column) =>
        column.Numeric ? (column.Class is null ? "ep-num" : $"{column.Class} ep-num") : column.Class;

    private RenderFragment Content =>
        @<text>
            <thead>
                <tr>
                    @foreach (var column in Columns)
                    {
                        <th scope="col" class="@(column.Numeric ? "ep-num" : null)" aria-sort="@AriaSort(column)">
                            @if (column.HideTitle)
                            {
                                <span class="ep-visually-hidden">@column.Title</span>
                            }
                            else if (Sortable(column))
                            {
                                <button type="button" class="ep-sort" @onclick="() => ToggleSort(column)">
                                    <span>@column.Title</span><NavIcon Path="@SortIcon(column)" />
                                </button>
                            }
                            else
                            {
                                @column.Title
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Rows)
                {
                    <tr>
                        @foreach (var column in Columns)
                        {
                            <td class="@CellClass(column)" data-label="@(column.Labeled ? column.Label ?? column.Title : null)">@column.Cell(item)</td>
                        }
                    </tr>
                }
            </tbody>
        </text>;
}
