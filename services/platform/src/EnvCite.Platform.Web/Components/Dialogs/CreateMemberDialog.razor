@* 新增客戶入口的成員。建立後由頁面接著顯示一次性的初始密碼（PasswordRevealDialog）。 *@
@inherits FormDialogBase
@inject IMemberAdmin Members
@inject IMailSender Mail

<MudDialog DefaultFocus="DefaultFocus.FirstChild">
    <DialogContent>
        <MudTextField @bind-Value="_email" Label="@L["電子郵件"]" InputType="InputType.Email" Variant="Variant.Outlined" Required="true" OnlyValidateIfDirty="true"
                      Immediate="true" MaxLength="254" AutoFocus="true" Class="mb-3" OnKeyUp="OnKeyUp"
                      HelperText="@(Mail.Enabled ? L["會寄一封連結信給對方，由對方自己設定密碼並驗證信箱；不會寄出密碼。"].Value : L["同一個租戶內不能重複；同一個 email 在不同租戶是不同帳號。"].Value)" />
        <MudTextField @bind-Value="_displayName" Label="@L["顯示名稱（選填）"]" Variant="Variant.Outlined" Immediate="true" MaxLength="200"
                      Class="mb-3" OnKeyUp="OnKeyUp" />
        <MudSelect T="string" @bind-Value="_role" Label="@L["角色"]" Variant="Variant.Outlined">
            @foreach (var role in CustomerRoles.All)
            {
                <MudSelectItem T="string" Value="@role">@PortalLabels.RoleWithAbilities(role)</MudSelectItem>
            }
        </MudSelect>
        <DialogError Message="@Error" />
    </DialogContent>
    <DialogActions>
        <DialogSubmitActions Text="@(Mail.Enabled ? L["寄出邀請"] : L["建立成員"])" BusyText="@L["建立中…"]" Busy="Busy" OnSubmit="SubmitAsync" />
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public string TenantId { get; set; } = string.Empty;

    private string? _email;
    private string? _displayName;
    private string _role = CustomerRoles.Viewer;

    protected override async Task SubmitAsync() =>
        await CompleteAsync(
            async actor => Mail.Enabled
                ? DialogOutcome.From(await Members.InviteAsync(actor, TenantId, _email ?? string.Empty, _displayName, _role, CancellationToken.None), L["建立失敗。"])
                : DialogOutcome.From(await Members.CreateAsync(actor, TenantId, _email ?? string.Empty, _displayName, _role, CancellationToken.None), L["建立失敗。"]),
            L["建立失敗，請稍後再試。"]);
}
