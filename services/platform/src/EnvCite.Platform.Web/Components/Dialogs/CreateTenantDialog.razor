@* 建立租戶。識別碼建立後不能改（API 與稽核都用它），所以在欄位下直接說明規則。 *@
@inject ITenantProvisioner Tenants

<MudDialog DefaultFocus="DefaultFocus.FirstChild">
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="@L["名稱"]" Placeholder="@L["例如：某某環境顧問公司"]" Variant="Variant.Outlined"
                      Required="true" OnlyValidateIfDirty="true" Immediate="true" MaxLength="200" AutoFocus="true" Class="mb-3" OnKeyUp="OnKeyUp" />
        <MudTextField @bind-Value="_identifier" Label="@L["識別碼"]" Variant="Variant.Outlined" Required="true" OnlyValidateIfDirty="true" Immediate="true"
                      MaxLength="63" HelperText="@L["3–63 字元：小寫英文、數字、連字號。建立後不能修改。"]" OnKeyUp="OnKeyUp" />
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" role="alert">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">@L["取消"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">
            @(_busy ? L["建立中…"] : L["建立租戶"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private string? _name;
    private string? _identifier;
    private string? _error;
    private bool _busy;

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_busy)
        {
            await SubmitAsync();
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var actor = (await AuthenticationState).User;
            var created = await Tenants.CreateAsync(actor, _identifier?.Trim() ?? string.Empty, _name ?? string.Empty, CancellationToken.None);
            if (created.IsOk)
            {
                MudDialog.Close(DialogResult.Ok(created.Value!));
                return;
            }

            _error = created.Localized();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _error = L["建立失敗，請稍後再試。"] + " (" + exception.GetType().Name + ")";
        }
        finally
        {
            _busy = false;
        }
    }
}
