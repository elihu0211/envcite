@* 一次性密碼：只在建立或重設的當下顯示。不能用 Esc 或點背景關掉，只有「我已保存」。 *@
@inherits SecretDialogBase

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-3" role="status">
            @L["這組密碼只會顯示這一次。請交給 "]<strong>@Operator.Email</strong>@L["。對方第一次登入必須自己改掉，再綁定驗證器。"]
        </MudAlert>
        <MudTextField T="string" Value="@Password" ReadOnly="true" Label="@L["一次性密碼"]" Variant="Variant.Outlined" Class="ep-mono"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                      AdornmentAriaLabel="@L["複製一次性密碼"]" OnAdornmentClick="() => CopyAsync(Password)" />
        <p class="ep-status" role="status" aria-live="polite">@(Copied ? L["已複製到剪貼簿"] : string.Empty)</p>
        <p class="ep-page-description">@L["後台登入："]<code class="ep-mono">@LoginPath</code></p>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => MudDialog.Close()">@L["我已保存"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public OperatorInfo Operator { get; set; } = default!;

    [Parameter, EditorRequired] public string Password { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string LoginPath { get; set; } = string.Empty;
}
