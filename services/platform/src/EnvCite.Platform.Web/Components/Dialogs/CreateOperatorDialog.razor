@* 建立營運者。沒有自助註冊：這裡是後台建立帳號的途徑，初始密碼在下一個對話框只顯示一次。 *@
@inherits FormDialogBase
@inject IOperatorAdmin Operators
@inject IMailSender Mail

<MudDialog DefaultFocus="DefaultFocus.FirstChild">
    <DialogContent>
        <MudTextField @bind-Value="_email" Label="@L["電子郵件"]" Variant="Variant.Outlined" Required="true" OnlyValidateIfDirty="true" Immediate="true"
                      InputType="InputType.Email" AutoFocus="true" Class="mb-3" OnKeyUp="OnKeyUp"
                      HelperText="@(Mail.Enabled ? L["會寄一封連結信給對方，由對方自己設定密碼並驗證信箱；不會寄出密碼。"].Value : null)" />
        <MudTextField @bind-Value="_displayName" Label="@L["顯示名稱"]" Variant="Variant.Outlined" Immediate="true"
                      MaxLength="200" HelperText="@L["可以不填。最長 200 字元。"]" OnKeyUp="OnKeyUp" />
        <DialogError Message="@Error" />
    </DialogContent>
    <DialogActions>
        <DialogSubmitActions Text="@(Mail.Enabled ? L["寄出邀請"] : L["建立"])" BusyText="@L["建立中…"]" Busy="Busy" OnSubmit="SubmitAsync" />
    </DialogActions>
</MudDialog>

@code {
    private string? _email;
    private string? _displayName;

    protected override async Task SubmitAsync() =>
        await CompleteAsync(
            async actor => Mail.Enabled
                // 有寄信就邀請（對方自己設密碼）；沒有就發暫時密碼，由你親手交付。
                ? DialogOutcome.From(await Operators.InviteAsync(actor, _email ?? string.Empty, _displayName, CancellationToken.None), L["建立失敗。"])
                : DialogOutcome.From(await Operators.CreateAsync(actor, _email ?? string.Empty, _displayName, CancellationToken.None), L["建立失敗。"]),
            L["建立失敗，請稍後再試。"]);
}
