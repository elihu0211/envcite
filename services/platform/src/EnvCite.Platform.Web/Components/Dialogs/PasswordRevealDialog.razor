@* 一次性初始密碼：只在建立或重設的當下顯示。不能用 Esc 或點背景關掉（SetOptions 在 OnInitialized 設定），只有「我已交給對方」。 *@
@inherits SecretDialogBase

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-3" role="status">
            @L["這組密碼只會顯示這一次，關閉後無法再取回。請安全地交給 "]<strong>@Member.Email</strong>@L["（不要貼在公開的聊天室或工單裡）。"]
            @L["對方第一次登入時必須自己改掉；營運人員之後不會知道他的密碼。"]
        </MudAlert>
        <MudTextField T="string" Value="@Password" ReadOnly="true" Label="@L["初始密碼"]" Variant="Variant.Outlined" Class="ep-mono"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                      AdornmentAriaLabel="@L["複製初始密碼"]" OnAdornmentClick="() => CopyAsync(Password)" />
        <p class="ep-status" role="status" aria-live="polite">@(Copied ? L["已複製到剪貼簿"] : string.Empty)</p>
        <p class="ep-page-description">@L["入口登入網址："]<code class="ep-mono">@LoginPath</code></p>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => MudDialog.Close()">@L["我已交給對方"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public MemberInfo Member { get; set; } = default!;

    [Parameter, EditorRequired] public string Password { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string LoginPath { get; set; } = string.Empty;
}
