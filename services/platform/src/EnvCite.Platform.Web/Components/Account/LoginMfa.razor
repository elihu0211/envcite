@page "/ui/login/mfa"
@layout AccountLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(PlatformAuth.UiSignInRateLimit)]
@attribute [AllowAnonymous]

<PageTitle>@L["第二步驗證 · 環境知識"]</PageTitle>

<h1 class="ep-page-title">@L["第二步驗證"]</h1>
@if (Recovery)
{
    <p class="ep-page-description">@L["輸入一組復原碼。每一組只能用一次。"]</p>
}
else
{
    <p class="ep-page-description">@L["打開手機上的驗證器 App，輸入現在顯示的六位數。"]</p>
}

@if (_error is not null)
{
    @* 與登入同一個原則：不說是碼錯、過期還是帳號被鎖。 *@
    <p class="ep-alert ep-alert-error" role="alert">@_error</p>
}

<EditForm Model="Input" FormName="ui-mfa" OnValidSubmit="VerifyAsync" method="post" class="ep-form">
    <div class="ep-field-row">
        <label for="code" class="ep-label">@(Recovery ? L["復原碼"] : L["驗證碼"])</label>
        @if (Recovery)
        {
            <InputText id="code" @bind-Value="Input.Code" class="ep-input" required autofocus autocomplete="one-time-code" inputmode="text" maxlength="40" />
        }
        else
        {
            <OtpField Id="code" @bind-Value="Input.Code" AutoFocus="true" AutoSubmit="true" />
        }
    </div>
    <button type="submit" class="ep-btn ep-btn-primary">@L["驗證"]</button>
</EditForm>

<p class="ep-note">
    @if (Recovery)
    {
        <a href="@Link(recovery: false)">@L["改用驗證器的六位數"]</a>
    }
    else
    {
        <a href="@Link(recovery: true)">@L["手機不在身邊？用復原碼"]</a>
    }
    　·　<a href="@UiEndpoints.LoginPath">@L["重新輸入密碼"]</a>
</p>
