@page "/ui/login/mfa"
@layout AccountLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(PlatformAuth.UiSignInRateLimit)]
@attribute [AllowAnonymous]
@inject IOperatorTwoFactor TwoFactor

<DocumentTitle Text="@L["第二步驗證"]" />

<PageHeading>@L["第二步驗證"]</PageHeading>
<TwoFactorSignInFlow TwoFactor="TwoFactor" Routes="SignInRoutes.Operator" FormName="ui-mfa" />
