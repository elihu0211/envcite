@page "/ui/password"
@layout AccountLayout
@inherits StaticPageBase
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(PlatformAuth.UiSignInRateLimit)]
@attribute [Authorize(Policy = PlatformAuth.UiSessionPolicy)]
@inject IOperatorAccount Account

<DocumentTitle Text="@L["改密碼"]" />

<PageHeading>@L["改密碼"]</PageHeading>
<ChangePasswordFlow Account="Account" FormName="ui-password" HomePath="@UiEndpoints.HomePath"
                    PendingText="@L["這是系統管理者給你的初始密碼，其他人可能看過。請先設定只有你知道的新密碼，再註冊驗證器，才能使用後台。"]" />

<SignOutButton />
