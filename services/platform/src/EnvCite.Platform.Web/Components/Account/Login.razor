@page "/ui/login"
@layout AccountLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(PlatformAuth.UiSignInRateLimit)]
@attribute [AllowAnonymous]

<PageTitle>@L["登入 · 環境知識"]</PageTitle>

<h1 class="ep-page-title">@L["營運者登入"]</h1>

@if (_error is not null)
{
    @* role=alert：螢幕閱讀器立刻念出來；訊息不說是帳號還是密碼錯，也不說帳號有沒有被鎖。 *@
    <p class="ep-alert ep-alert-error" role="alert">@_error</p>
}

<EditForm Model="Input" FormName="ui-login" OnValidSubmit="SignInAsync" method="post" class="ep-form">
    <div class="ep-field-row">
        <label for="email" class="ep-label">@L["電子郵件"]</label>
        <InputText id="email" @bind-Value="Input.Email" type="email" class="ep-input" autocomplete="username" required autofocus />
    </div>
    <div class="ep-field-row">
        <label for="password" class="ep-label">@L["密碼"]</label>
        <PasswordField Id="password" @bind-Value="Input.Password" />
    </div>
    <button type="submit" class="ep-btn ep-btn-primary">@L["登入"]</button>
</EditForm>

<p class="ep-note">@L["沒有帳號、忘記密碼或弄丟了驗證器，請洽系統管理者。"]</p>
