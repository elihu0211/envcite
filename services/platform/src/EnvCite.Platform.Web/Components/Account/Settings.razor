@page "/ui/settings"
@layout AccountLayout
@inherits StaticPageBase
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = PlatformAuth.UiPolicy)]

@* 營運者的個人設定：目前只有外觀。靜態渲染（沒有 circuit）：選項是原生表單，換外觀由 /ui/appearance 寫 cookie；
   與改密碼、兩步驟驗證同一種帳號頁（一張置中的卡）。客戶入口的同名頁（Portal/Settings）共用同一個 AppearanceSetting。 *@
<DocumentTitle Text="@L["個人設定"]" />

<PageHeading>@L["個人設定"]</PageHeading>

<AppearanceSetting Action="@UiEndpoints.AppearancePath" />

<a class="ep-btn ep-btn-primary" href="@UiEndpoints.HomePath">@L["回後台"]</a>
