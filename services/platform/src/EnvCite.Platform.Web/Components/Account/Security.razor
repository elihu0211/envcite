@page "/ui/security"
@layout AccountLayout
@inherits StaticPageBase
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(PlatformAuth.UiSignInRateLimit)]
@attribute [Authorize(Policy = PlatformAuth.UiEnrollmentPolicy)]
@inject IOperatorTwoFactor TwoFactor

<DocumentTitle Text="@L["兩步驟驗證"]" />

<PageHeading>@L["兩步驟驗證"]</PageHeading>
<p class="ep-page-description">@L["登入時，除了密碼，還要輸入手機驗證器上的六位數。每位營運者都必須使用。"]</p>
<TwoFactorSetupFlow TwoFactor="TwoFactor" FormPrefix="ui-mfa" HomeHref="@UiEndpoints.HomePath" BackText="@L["回後台"]"
                    RequiredText="@L["請先完成下面的設定，才能使用後台。"]"
                    EnabledText="@L["之後登入都會要求驗證碼。手機遺失、也沒有復原碼時，請洽系統管理者為你重設。"]" />

<SignOutButton />
