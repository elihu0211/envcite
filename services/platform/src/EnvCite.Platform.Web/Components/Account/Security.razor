@page "/ui/security"
@layout AccountLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(PlatformAuth.UiSignInRateLimit)]
@attribute [Authorize(Policy = PlatformAuth.UiEnrollmentPolicy)]

<PageTitle>@L["兩步驟驗證 · {0}", Brand.Name]</PageTitle>

<h1 class="ep-page-title">@L["兩步驟驗證"]</h1>
<p class="ep-page-description">@L["登入時，除了密碼，還要輸入手機驗證器上的六位數。每位營運者都必須使用。"]</p>

@if (!_enabled)
{
    <p class="ep-alert ep-alert-info" role="status">@L["請先完成下面的設定，才能使用後台。"]</p>
}

@if (_recoveryCodes is not null)
{
    @* 只在啟用（或重新產生）的這一個回應裡出現，之後不會再顯示（頁面重新整理就沒了）。 *@
    <section aria-labelledby="codes-title">
        <h2 id="codes-title" class="ep-section-title">@_codesTitle</h2>
        <p class="ep-alert ep-alert-info" role="status">
            @L["這是你的復原碼。"]<strong>@L["只會顯示這一次"]</strong>@L["：請現在抄下或存進密碼管理員。"]
            @L["手機遺失時，每一組復原碼可以代替一次驗證碼，用過就失效。"]
        </p>
        <RecoveryCodes Codes="_recoveryCodes" />
        <a class="ep-btn ep-btn-primary" href="@UiEndpoints.HomePath">@L["我已保存"]</a>
    </section>
}
else if (_enabled)
{
    <section aria-labelledby="on-title">
        <h2 id="on-title" class="ep-section-title">@L["已啟用"]</h2>
        <p class="ep-page-description">
            @L["之後登入都會要求驗證碼。手機遺失、也沒有復原碼時，請洽系統管理者為你重設。"]
        </p>
    </section>

    @if (_error is not null)
    {
        <p class="ep-alert ep-alert-error" role="alert">@_error</p>
    }

    <section aria-labelledby="regen-title">
        <h2 id="regen-title" class="ep-section-title">@L["重新產生復原碼"]</h2>
        <p class="ep-page-description">@L["舊的復原碼會全部作廢。輸入驗證器上現在的六位數確認是你本人。"]</p>
        <EditForm Model="Regenerate" FormName="ui-mfa-regenerate" OnValidSubmit="RegenerateAsync" method="post" class="ep-form">
            <div class="ep-field-row">
                <label for="regen-code" class="ep-label">@L["驗證碼"]</label>
                <OtpField Id="regen-code" @bind-Value="Regenerate.Code" />
            </div>
            <button type="submit" class="ep-btn ep-btn-quiet">@L["重新產生"]</button>
        </EditForm>
    </section>

    <a class="ep-btn ep-btn-primary" href="@UiEndpoints.HomePath">@L["回後台"]</a>
}
else if (_setup is not null)
{
    <section aria-labelledby="setup-title">
        <h2 id="setup-title" class="ep-section-title">@L["啟用步驟"]</h2>
        <ol class="ep-steps">
            <li>@L["在手機安裝驗證器 App（例如 Google Authenticator、Microsoft Authenticator、1Password 或 Authy）。"]</li>
            <li>@L["用 App 掃描下面的 QR；掃不了就選「手動輸入」，輸入下面的金鑰。"]</li>
            <li>@L["輸入 App 上現在顯示的六位數，按「啟用」。"]</li>
        </ol>
        <div class="ep-qr" role="img" aria-label="@L["驗證器 QR"]">@((MarkupString)_qrSvg)</div>
        <p class="ep-hint">@L["金鑰（手動輸入用）："]<code class="ep-mono" id="shared-key">@_setup.SharedKey</code></p>

        @if (_error is not null)
        {
            <p class="ep-alert ep-alert-error" role="alert">@_error</p>
        }

        <EditForm Model="Input" FormName="ui-mfa-enable" OnValidSubmit="EnableAsync" method="post" class="ep-form">
            <div class="ep-field-row">
                <label for="code" class="ep-label">@L["驗證碼"]</label>
                <OtpField Id="code" @bind-Value="Input.Code" />
            </div>
            <button type="submit" class="ep-btn ep-btn-primary">@L["啟用"]</button>
        </EditForm>
    </section>
}

<SignOutButton />
