@page "/not-found"
@layout AnonymousLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

@* Router 的 NotFoundPage：NavigationManager.NotFound()（例如入口路徑上的租戶不存在）與互動導覽到不存在的路徑都畫這頁。
   後台與入口共用，所以不放任何一邊的導覽，也不說資源是否曾經存在。 *@
<PageTitle>@L["找不到頁面 · 環境知識"]</PageTitle>

<StatusPage Icon="@Icons.Material.Outlined.SearchOff" Title="@L["找不到頁面"]" Description="@L["這個網址沒有對應的頁面。請確認網址是否正確。"]" />
