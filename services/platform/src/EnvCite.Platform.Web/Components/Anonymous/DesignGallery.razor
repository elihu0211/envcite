@page "/design"
@layout BareLayout
@attribute [ExcludeFromInteractiveRouting]

@* 元件展示：只在 Development（其他環境是 404，見 WebModule），不需要登入，讓改完 token 能直接看每個元件在三種寬度的樣子。
   所有顏色、字級都取自 token（--ep-*），這裡不寫任何值。 *@
<PageTitle>元件展示 · 環境知識</PageTitle>

<PortalShell TenantName="展示租戶" HomeHref="/design" UserEmail="owner@example.test" RoleLabel="擁有者" AvatarText="O" ShowMenu="true" MenuItems="@_menu" NavItems="@_nav">
    <PageHeader Title="元件展示" Description="只在 Development 看得到。配色、字級與字型都來自 DesignTokens.cs（規格見 DESIGN.md）。左側是工作區，右上角的頭像是帳號選單。" />

    <section class="ep-card" aria-labelledby="g-ask">
        <h2 id="g-ask" class="ep-section-title">問答</h2>
        <div class="ep-thread">
            <p class="ep-bubble">噪音管制標準 <span class="ep-bubble-meta">現行</span></p>
            <div class="ep-answer">
                <p class="ep-status">找到 1 條（相關度高的在前）。</p>
                <article class="ep-card ep-hit">
                    <h2 class="ep-section-title">《噪音管制法》第 8 條</h2>
                    <p class="ep-hit-body">條文內文保留原本的換行（項、款、目），引用可以直接複製。</p>
                    <p class="ep-hint">引用：《噪音管制法》第 8 條（現行）</p>
                </article>
            </div>
        </div>
        <div class="ep-composer-form">
            <div class="ep-composer">
                <input class="ep-composer-input" type="search" placeholder="輸入關鍵字，例如：噪音管制標準" aria-label="關鍵字" />
                <button type="button" class="ep-send" aria-label="搜尋"><NavIcon Path="@Icons.Material.Filled.ArrowUpward" /></button>
            </div>
            <div class="ep-examples">
                <button type="button" class="ep-chip">固定污染源</button>
                <button type="button" class="ep-chip">廢棄物清理</button>
            </div>
        </div>
    </section>

    <section class="ep-card" aria-labelledby="g-color">
        <h2 id="g-color" class="ep-section-title">色彩</h2>
        <div class="ep-swatches">
            @foreach (var (name, label) in _colors)
            {
                <div class="ep-swatch">
                    <span class="ep-swatch-chip" style="background: var(--ep-@name)"></span>
                    <code class="ep-mono">--ep-@name</code>
                    <span class="ep-secondary">@label</span>
                </div>
            }
        </div>
    </section>

    <section class="ep-card" aria-labelledby="g-type">
        <h2 id="g-type" class="ep-section-title">字級</h2>
        <p class="ep-hint">@string.Join("，", DesignTokens.FontFamily)</p>
        @foreach (var (name, sample) in _types)
        {
            <p class="ep-type-row" style="font-size: var(--ep-@(name)-size); line-height: var(--ep-@(name)-leading); letter-spacing: var(--ep-@(name)-tracking); font-weight: var(--ep-@(name)-weight)">
                @sample <code class="ep-mono">@name</code>
            </p>
        }
    </section>

    <section class="ep-card" aria-labelledby="g-btn">
        <h2 id="g-btn" class="ep-section-title">按鈕與表單</h2>
        <div class="ep-actions">
            <button type="button" class="ep-btn ep-btn-primary">主要動作</button>
            <button type="button" class="ep-btn ep-btn-quiet">次要動作</button>
        </div>
        <div class="ep-form">
            <div class="ep-field-row">
                <label class="ep-label" for="g-email">電子郵件</label>
                <input id="g-email" class="ep-input" type="email" placeholder="name@example.com" />
                <p class="ep-hint">說明文字用次要色。</p>
            </div>
            <div class="ep-field-row">
                <label class="ep-label" for="g-role">角色</label>
                <select id="g-role" class="ep-input"><option>唯讀</option><option>開發者</option></select>
            </div>
        </div>
        <EditForm Model="_sample" FormName="design-sample" class="ep-form">
            <div class="ep-field-row">
                <label class="ep-label" for="g-password">密碼</label>
                <PasswordField Id="g-password" @bind-Value="_sample.Password" Autocomplete="new-password" />
                <p class="ep-hint">右側的眼睛鈕顯示或隱藏；大寫鎖定開著時，欄位下方會出現提醒。</p>
            </div>
        </EditForm>
    </section>

    <section class="ep-card" aria-labelledby="g-recovery">
        <h2 id="g-recovery" class="ep-section-title">復原碼</h2>
        <p class="ep-hint">工具列：下載（文字檔）、複製、列印。</p>
        <RecoveryCodes Codes="_sampleCodes" />
    </section>

    <section class="ep-card" aria-labelledby="g-badge">
        <h2 id="g-badge" class="ep-section-title">徽章與提示</h2>
        <p>
            <StatusBadge>中性</StatusBadge>
            <StatusBadge Tone="success">正常</StatusBadge>
            <StatusBadge Tone="warning">待改密碼</StatusBadge>
            <StatusBadge Tone="error">已鎖定</StatusBadge>
            <StatusBadge Tone="info">兩步驟</StatusBadge>
        </p>
        <p class="ep-alert" role="status">中性提示：邊框與文字說明承擔語意。</p>
        <p class="ep-alert ep-alert-success" role="status">成功：操作已完成。</p>
        <p class="ep-alert ep-alert-warning" role="status">注意：這個操作無法復原。</p>
        <p class="ep-alert ep-alert-error" role="alert">錯誤：請稍後再試。</p>
        <p class="ep-alert ep-alert-info" role="status">資訊：系統將於今晚進行維護。</p>
    </section>

    <section class="ep-card ep-table-card ep-cards" aria-labelledby="g-table">
        <h2 id="g-table" class="ep-section-title ep-card-title">表格（窄卡片時變成一列一張小卡）</h2>
        <div class="ep-table-wrap">
            <table class="ep-plain-table" aria-label="範例">
                <thead>
                    <tr><th scope="col">電子郵件</th><th scope="col">角色</th><th scope="col">狀態</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>owner@example.test</td>
                        <td data-label="角色">擁有者</td>
                        <td data-label="狀態"><StatusBadge Tone="success">正常</StatusBadge> <StatusBadge Tone="info">兩步驟</StatusBadge></td>
                    </tr>
                    <tr>
                        <td>viewer@example.test</td>
                        <td data-label="角色">唯讀</td>
                        <td data-label="狀態"><StatusBadge Tone="neutral">已停用</StatusBadge></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="ep-card" aria-labelledby="g-empty">
        <EmptyState Title="還沒有資料" Description="現在是什麼狀態、下一步可以做什麼。">
            <button type="button" class="ep-btn ep-btn-primary">新增</button>
        </EmptyState>
    </section>
</PortalShell>

