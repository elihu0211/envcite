    private readonly SampleForm _sample = new();

    private static readonly string[] _sampleCodes =
        ["G5QRJ-T8WRM", "DT2HN-WVRXY", "MGHP2-QXYFY", "6962B-99K82", "FJG9V-P68T7", "TTR3T-TGB6F", "N3TJQ-FFR2D", "Y6X6B-6H2TN", "QM3MJ-3K927", "QKHW5-2949G"];

    private sealed class SampleForm
    {
        public string Password { get; set; } = string.Empty;
    }

    private static readonly (string Name, string Label)[] _colors =
    [
        ("bg", "頁面底"), ("surface", "卡片"), ("surface-raised", "浮起表面"), ("surface-muted", "欄標題、展開列"),
        ("text", "主要文字"), ("text-secondary", "次要文字"), ("primary", "企業藍"), ("on-primary", "企業藍上的字"),
        ("link", "連結"), ("focus", "焦點環"), ("ink", "深色點綴"), ("on-ink", "深色上的字"), ("accent", "裝飾"),
        ("success", "成功"), ("warning", "警示"), ("error", "錯誤"), ("info", "資訊"),
        ("border-subtle", "髮絲線"), ("border-control", "控制項外框"), ("scrim", "遮罩"),
    ];

    private static readonly (string Name, string Sample)[] _types =
