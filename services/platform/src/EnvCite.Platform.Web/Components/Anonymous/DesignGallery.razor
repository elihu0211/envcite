@page "/design"
@layout BareLayout
@attribute [ExcludeFromInteractiveRouting]

@* 元件展示：只在 Development（其他環境是 404，見 WebModule），不需要登入，讓改完 token 能直接看每個元件在三種寬度的樣子。
   所有顏色、字級都取自 token（--ep-*），這裡不寫任何值。 *@
<DocumentTitle Text="元件展示" />

<PortalShell TenantName="展示租戶" HomeHref="/design" UserEmail="owner@example.test" RoleLabel="擁有者" AvatarText="O" ShowMenu="true" MenuItems="@_menu" NavItems="@_nav">
    <PageHeader Title="元件展示" Description="只在 Development 看得到。配色、字級與字型都來自 DesignTokens.cs（規格見 DESIGN.md）。左側是工作區，右上角的頭像是帳號選單。" />

    <SectionCard Id="g-ask" Title="問答">
        <div class="ep-thread">
            <p class="ep-bubble">噪音管制標準 <span class="ep-bubble-meta">現行</span></p>
            <div class="ep-answer">
                <p class="ep-status">找到 1 條（相關度高的在前）。</p>
                <article class="ep-card ep-hit">
                    <h2 class="ep-section-title">《噪音管制法》第 8 條</h2>
                    <p class="ep-hit-body">條文內文保留原本的換行（項、款、目），引用可以直接複製。</p>
                    <p class="ep-hint">引用：《噪音管制法》第 8 條（現行）</p>
                </article>
            </div>
        </div>
        <div class="ep-composer-form">
            <div class="ep-composer">
                <input class="ep-composer-input" type="search" placeholder="輸入關鍵字，例如：噪音管制標準" aria-label="關鍵字" />
                <button type="button" class="ep-send" aria-label="搜尋"><NavIcon Path="@Icons.Material.Filled.ArrowUpward" /></button>
            </div>
            <div class="ep-examples">
                <button type="button" class="ep-chip">固定污染源</button>
                <button type="button" class="ep-chip">廢棄物清理</button>
            </div>
        </div>
    </SectionCard>

    <SectionCard Id="g-color" Title="色彩">
        <div class="ep-swatches">
            @foreach (var (name, label) in _colors)
            {
                <div class="ep-swatch">
                    <span class="ep-swatch-chip" style="background: var(--ep-@name)"></span>
                    <code class="ep-mono">--ep-@name</code>
                    <span class="ep-secondary">@label</span>
                </div>
            }
        </div>
    </SectionCard>

    <SectionCard Id="g-type" Title="字級">
        <p class="ep-hint">@string.Join("，", DesignTokens.FontFamily)</p>
        @foreach (var (name, sample) in _types)
        {
            <p class="ep-type-row" style="font-size: var(--ep-@(name)-size); line-height: var(--ep-@(name)-leading); letter-spacing: var(--ep-@(name)-tracking); font-weight: var(--ep-@(name)-weight)">
                @sample <code class="ep-mono">@name</code>
            </p>
        }
    </SectionCard>

    <SectionCard Id="g-btn" Title="按鈕與表單">
        <div class="ep-actions">
            <button type="button" class="ep-btn ep-btn-primary">主要動作</button>
            <button type="button" class="ep-btn ep-btn-quiet">次要動作</button>
        </div>
        <div class="ep-form">
            <FormField For="g-email" Label="電子郵件" Hint="說明文字用次要色。">
                <input id="g-email" class="ep-input" type="email" placeholder="name@example.com" />
            </FormField>
            <FormField For="g-role" Label="角色">
                <OptionSelect Id="g-role" Name="g-role" Label="角色" Inline="false" Options="_roles" />
            </FormField>
        </div>
        <PostForm Model="_sample" FormName="design-sample">
            <FormField For="g-password" Label="密碼" Hint="右側的眼睛鈕顯示或隱藏；大寫鎖定開著時，欄位下方會出現提醒。">
                <PasswordField Id="g-password" @bind-Value="_sample.Password" Autocomplete="new-password" />
            </FormField>
            <NewPasswordField Id="g-new-password" Label="新密碼" @bind-Value="_sample.NewPassword" />
            <FormField For="g-otp" Label="驗證碼" Hint="六格輸入：底下是一個真的輸入框；點任一格、直接輸入或貼上。登入的第二步輸滿六位會自動送出。">
                <OtpField Id="g-otp" @bind-Value="_sample.Code" />
            </FormField>
        </PostForm>
    </SectionCard>

    <SectionCard Id="g-recovery" Title="復原碼">
        <p class="ep-hint">工具列：下載（文字檔）、複製、列印。</p>
        <RecoveryCodes Codes="_sampleCodes" />
    </SectionCard>

    <SectionCard Id="g-badge" Title="徽章與提示">
        <p>
            <StatusBadge>中性</StatusBadge>
            <StatusBadge Tone="success">正常</StatusBadge>
            <StatusBadge Tone="warning">待改密碼</StatusBadge>
            <StatusBadge Tone="error">已鎖定</StatusBadge>
            <StatusBadge Tone="info">兩步驟</StatusBadge>
        </p>
        <FormAlert Kind="AlertKind.Neutral">中性提示：邊框與文字說明承擔語意。</FormAlert>
        <FormAlert Kind="AlertKind.Success">成功：操作已完成。</FormAlert>
        <FormAlert Kind="AlertKind.Warning">注意：這個操作無法復原。</FormAlert>
        <FormAlert>錯誤：請稍後再試。</FormAlert>
        <FormAlert Kind="AlertKind.Info">資訊：系統將於今晚進行維護。</FormAlert>
    </SectionCard>

    <SectionCard Id="g-skeleton" Title="載入中（骨架屏）">
        <p class="ep-hint">內容還沒到時先畫出它的版面，灰塊緩緩一明一暗；內容到了取代它。</p>
        <Skeleton Kind="table" Rows="3" Label="載入中" />
    </SectionCard>

    <SectionCard Id="g-table" Title="表格（窄卡片時變成一列一張小卡）" Class="ep-table-card ep-cards" TitleClass="ep-card-title">
        <DataTable Items="_rows" Columns="_columns" Label="範例" Plain="true" />
    </SectionCard>

    <SectionCard Id="g-stats" Title="摘要磚">
        <StatGrid Items="_stats" Label="範例摘要" />
    </SectionCard>

    <SectionCard>
        <EmptyState Icon="@Icons.Material.Outlined.Inbox" Title="還沒有資料" Description="現在是什麼狀態、下一步可以做什麼。">
            <button type="button" class="ep-btn ep-btn-primary">新增</button>
        </EmptyState>
    </SectionCard>
</PortalShell>

@code {
    private readonly SampleForm _sample = new();

    private sealed record SampleRow(string Email, string Role, bool Active);

    private static readonly SampleRow[] _rows = [new("owner@example.test", "擁有者", true), new("viewer@example.test", "唯讀", false)];

    private static readonly ColumnDef<SampleRow>[] _columns =
    [
        new() { Title = "電子郵件", Labeled = false, Cell = row => @<text>@row.Email</text> },
        new() { Title = "角色", Cell = row => @<text>@row.Role</text> },
        new()
        {
            Title = "狀態",
            Cell = row => @<text>
                @if (row.Active)
                {
                    <StatusBadge Tone="success">正常</StatusBadge> <StatusBadge Tone="info">兩步驟</StatusBadge>
                }
                else
                {
                    <StatusBadge Tone="neutral">已停用</StatusBadge>
                }
            </text>,
        },
    ];

    private static readonly SelectOption[] _roles = [new("viewer", "唯讀"), new("developer", "開發者")];

    private static readonly StatItem[] _stats = [new("租戶", "12", "都有方案", "/design"), new("呼叫次數", "3,408", "近 30 天")];

    private static readonly string[] _sampleCodes =
        ["G5QRJ-T8WRM", "DT2HN-WVRXY", "MGHP2-QXYFY", "6962B-99K82", "FJG9V-P68T7", "TTR3T-TGB6F", "N3TJQ-FFR2D", "Y6X6B-6H2TN", "QM3MJ-3K927", "QKHW5-2949G"];

    private sealed class SampleForm
    {
        public string Password { get; set; } = string.Empty;

        public string NewPassword { get; set; } = string.Empty;

        public string Code { get; set; } = string.Empty;
    }

    private static readonly (string Name, string Label)[] _colors =
    [
        ("bg", "頁面底"), ("surface", "卡片"), ("surface-raised", "浮起表面"), ("surface-muted", "欄標題、展開列"),
        ("text", "主要文字"), ("text-secondary", "次要文字"), ("primary", "企業藍"), ("on-primary", "企業藍上的字"),
        ("link", "連結"), ("focus", "焦點環"), ("ink", "深色點綴"), ("on-ink", "深色上的字"), ("accent", "裝飾"),
        ("success", "成功"), ("warning", "警示"), ("error", "錯誤"), ("info", "資訊"),
        ("border-subtle", "髮絲線"), ("border-control", "控制項外框"), ("scrim", "遮罩"),
    ];

    private static readonly (string Name, string Sample)[] _types =
    [
        ("display-l", "展示大標"), ("display-m", "展示"), ("display-s", "展示小標"),
        ("headline-l", "頁面標題"), ("headline-m", "次級頁標題"), ("headline-s", "區塊標題"),
        ("title-l", "卡片標題"), ("title-m", "對話框標題"), ("title-s", "小標題"),
        ("body-l", "內文：臺灣環境法規的檢索與引用"), ("body-m", "說明與表格"), ("body-s", "輔助說明"),
        ("label-l", "按鈕"), ("label-m", "表頭"), ("label-s", "註記"),
    ];

    private static readonly IReadOnlyList<PortalShell.NavItem> _nav =
    [
        new("/design", "查詢", "服務", Exact: true, Icon: Icons.Material.Outlined.Search),
        new("#history", "對話紀錄", "服務", Icon: Icons.Material.Outlined.Forum),
        new("#members", "成員", "組織", Icon: Icons.Material.Outlined.Group),
        new("#account", "帳號與組織", "組織", Icon: Icons.Material.Outlined.ManageAccounts),
    ];

    private static readonly IReadOnlyList<PortalShell.MenuItem> _menu =
    [
        new("#security", "兩步驟驗證"),
        new("#password", "改密碼"),
    ];
}
