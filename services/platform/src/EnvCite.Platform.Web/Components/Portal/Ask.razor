@page "/portal/{Tenant}"
@page "/portal/{Tenant}/search"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = PlatformAuth.PortalPolicy)]
@inject IConversationHistory History
@inherits PortalFormPageBase<SearchForm>

<DocumentTitle Text="@L["查詢"]" />

@* 問答為主的首頁：一個輸入框。還沒問時是置中的招呼加輸入框；問了之後是「你的問題 → 找到的條文」，輸入框留在底部接著問。
   有設定模型端點（Platform:Answer）時，回答是模型只根據 consult 的封閉證據寫的、每個論點附出處代號，加上對應的條文卡片；
   沒有設定時只列有出處的條文（法規名、條號、查的是哪一天、條文網址）。 *@
<div class="ep-ask" data-state="@(_asked ? "result" : "empty")">
    @if (!_hasPlan)
    {
        <FormAlert Kind="AlertKind.Info">
            @L["你的組織目前沒有方案，不能使用搜尋。請洽我們的業務啟用。"]
        </FormAlert>
    }
    else
    {
        @if (!_asked)
        {
            <header class="ep-ask-hero">
                <h1 class="ep-ask-title">@(Name is null ? L["你好"] : L["你好，{0}", Name])</h1>
                <p class="ep-ask-lead">@L["想查哪一條法規？"]</p>
            </header>
        }
        else
        {
            <h1 class="ep-visually-hidden">@L["查詢結果"]</h1>
            <div class="ep-thread">
                <p class="ep-bubble">
                    @_question
                    <span class="ep-bubble-meta">@_asOfLabel</span>
                </p>

                <div class="ep-answer" aria-live="polite">
                    @if (Error is not null)
                    {
                        <FormAlert Message="@Error" />
                    }
                    else if (_answer is not null)
                    {
                        @if (_answer.Refused)
                        {
                            <FormAlert Kind="AlertKind.Info">@RefusalLabel(_answer.RefusalReason)</FormAlert>
                        }
                        else
                        {
                            <p class="ep-answer-text">@_answer.Text</p>
                            <p class="ep-hint">@L["這段回答由 AI 只根據下列法條產生，請核對出處再引用。"]</p>

                            @foreach (var source in _answer.Sources)
                            {
                                <article class="ep-card ep-hit" aria-label="@source.Citation">
                                    <h2 class="ep-section-title">[@source.Code] @source.Citation</h2>
                                    <p class="ep-hit-body">@source.Text</p>
                                    <p class="ep-hint">@L["引用：{0}（{1}）", source.Citation, _asOfLabel]<code class="ep-mono">@source.Uri</code></p>
                                </article>
                            }
                        }
                    }
                    else if (_hits is not null)
                    {
                        <p class="ep-status" role="status">
                            @(_hits.Count == 0 ? L["沒有符合的條文。試試其他說法，或換一天。"] : L["找到 {0} 條（相關度高的在前）。", _hits.Count])
                        </p>

                        @foreach (var hit in _hits)
                        {
                            <article class="ep-card ep-hit" aria-label="@L["《{0}》第 {1} 條", hit.LawTitle, hit.Number]">
                                <h2 class="ep-section-title">@L["《{0}》第 {1} 條", hit.LawTitle, hit.Number]</h2>
                                <p class="ep-hit-body">@hit.Content</p>
                                @if (hit.GuidanceDocuments > 0)
                                {
                                    <p class="ep-hint">@L["{0} 件函釋提到這個詞並解釋這一條；函釋不是依據，請以條文為準。", hit.GuidanceDocuments]</p>
                                }
                                @* 可直接複製的引用：法規名、條號、查的是哪一天、條文網址。 *@
                                <p class="ep-hint">@L["引用：《{0}》第 {1} 條（{2}）", hit.LawTitle, hit.Number, _asOfLabel]<code class="ep-mono">@hit.Uri</code></p>
                            </article>
                        }
                    }
                </div>
            </div>
        }

        @* POST：查詢全文是案件內容，不放進網址（網址會被各種日誌記下來）。 *@
        <PostForm Model="Input" FormName="portal-search" OnValidSubmit="SearchAsync" Class="ep-composer-form">
            @if (_conversationId is { } conversation)
            {
                <input type="hidden" name="Input.ConversationId" value="@conversation" />
            }
            <div class="ep-composer">
                <label for="query" class="ep-visually-hidden">@L["關鍵字"]</label>
                <InputText id="query" @bind-Value="Input.Query" type="search" class="ep-composer-input" maxlength="500" required
                           autofocus="@(!_asked)" autocomplete="off" enterkeyhint="search"
                           placeholder="@L["輸入關鍵字，例如：噪音管制標準"]" aria-describedby="query-hint" />
                <button type="submit" class="ep-send" aria-label="@L["搜尋"]"><NavIcon Path="@Icons.Material.Filled.ArrowUpward" /></button>
            </div>
            <div class="ep-composer-options">
                <label class="ep-date-chip" for="asof">
                    <span>@L["哪一天有效"]</span>
                    <InputText id="asof" @bind-Value="Input.AsOf" type="date" aria-describedby="query-hint" />
                </label>
            </div>

            @if (!_asked)
            {
                <div class="ep-examples" aria-label="@L["範例"]">
                    @foreach (var example in Examples)
                    {
                        <button type="submit" name="Input.Example" value="@example" formnovalidate class="ep-chip">@example</button>
                    }
                </div>
            }

            <p id="query-hint" class="ep-ask-note">@L["用條文裡會出現的詞，空白分隔。不填日期就是現行；查行為發生當時適用的條文，請填那一天。"]@if (History.Enabled)
            {
                <text>@L["你的提問會存在"]<a href="@($"{PortalPaths.Home(Tenant)}/history")">@L["對話紀錄"]</a>@L["，只有你看得到，{0} 天後自動刪除，也可以隨時自己刪。", History.RetentionDays]</text>
            }
            else
            {
                <text>@L["查詢文字不會被記錄，只記一次搜尋的次數。"]</text>
            }
            @if (_aiAnswer)
            {
                <text> @L["回答由 AI 產生：你的問題與相關條文會送到模型服務。"]</text>
            }</p>
        </PostForm>
    }
</div>
