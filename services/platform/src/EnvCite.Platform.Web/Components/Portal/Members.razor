@page "/portal/{Tenant}/members"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = PlatformAuth.PortalPolicy)]
@inherits PortalPageBase

<DocumentTitle Text="@L["成員"]" />

<PageHeader Title="@L["成員"]" />

@if (_team is null)
{
    <FormAlert Kind="AlertKind.Info">@L["只有擁有者與管理員能管理成員。"]</FormAlert>
}
else
{
    @if (_issued is not null)
    {
        @* 只在這一個回應裡出現，重新整理就沒了；資料庫只存雜湊。 *@
        <SectionCard Id="issued-title" Title="@_issuedTitle">
            <FormAlert Kind="AlertKind.Info">
                @L["這組密碼"]<strong>@L["只會顯示這一次"]</strong>@L["。請親手交給"] <strong>@_issued.Member.Email</strong>@L["（不要貼在公開的聊天室或工單裡）；"]
                @L["對方第一次登入時必須自己改掉，之後連你也不會知道他的密碼。"]
            </FormAlert>
            <SecretReveal Id="issued-password" Value="@_issuedPassword" />
        </SectionCard>
    }

    @if (_message is not null)
    {
        <FormAlert Kind="AlertKind.Info">@_message</FormAlert>
    }

    <FormAlert Message="@Error" />

    <SectionCard Id="add-title" Title="@L["新增成員"]">
        @* 四個控制項（電子郵件、名稱、角色、送出）排成一列，放不下才換行；不是三個欄位直排在一張滿寬卡的左邊。 *@
        <PostForm Model="Add" FormName="portal-member-add" OnValidSubmit="AddAsync" Class="ep-form ep-form-row">
            <FormField For="add-email" Label="@L["電子郵件"]">
                <InputText id="add-email" @bind-Value="Add.Email" type="email" class="ep-input" required maxlength="254" autocomplete="off" />
            </FormField>
            <FormField For="add-name" Label="@L["顯示名稱（選填）"]">
                <InputText id="add-name" @bind-Value="Add.DisplayName" class="ep-input" maxlength="200" autocomplete="off" />
            </FormField>
            <SelectField For="add-role" Label="@L["角色"]" Options="GrantableWithAbilities" @bind-Value="Add.Role" />
            <SubmitButton>@(mail.Enabled ? L["寄出邀請"] : L["新增成員"])</SubmitButton>
        </PostForm>
    </SectionCard>

    <SectionCard Id="list-title" Title="@L["目前的成員（{0}）", _team.Count]" Class="ep-table-card ep-cards" TitleClass="ep-card-title">
        @* 一個表單包住整個表：每個按鈕的 value 說明「對誰做什麼」，角色的下拉選單以 role-{id} 命名。 *@
        <form method="post" @onsubmit="ActAsync" @formname="portal-member-action">
            <AntiforgeryToken />
            <DataTable Items="_team" Columns="Columns" Label="@L["成員"]" Plain="true" />
        </form>
    </SectionCard>
}

@code {
    private IEnumerable<SelectOption> GrantableWithAbilities => _grantable.Select(role => new SelectOption(role, PortalLabels.RoleWithAbilities(role)));

    private IEnumerable<SelectOption> GrantableNames => _grantable.Select(role => new SelectOption(role, PortalLabels.Role(role)));

    private IReadOnlyList<ColumnDef<TeamMember>> Columns =>
    [
        new()
        {
            Title = L["電子郵件"], Class = "ep-keep", Labeled = false,
            Cell = row => @<text>@row.Member.Email@(row.Member.DisplayName is null ? "" : L["（{0}）", row.Member.DisplayName].Value)@(row.IsYou ? L["　· 你"].Value : "")</text>,
        },
        new() { Title = L["角色"], Cell = row => @<text>@PortalLabels.Role(row.Member.Role)</text> },
        new()
        {
            Title = L["狀態"],
            Cell = row => @<text>
                <StatusBadge Tone="@StateTone(row.Member)">@State(row.Member)</StatusBadge>
                @if (!row.Member.EmailConfirmed && !row.Member.Invited)
                {
                    <StatusBadge Tone="warning">@L["信箱未驗證"]</StatusBadge>
                }
                @if (row.Member.TwoFactorEnabled)
                {
                    <StatusBadge Tone="info">@L["兩步驟"]</StatusBadge>
                }
                @if (row.Member.Managed)
                {
                    <StatusBadge Tone="info">@L["由目錄同步管理"]</StatusBadge>
                }
            </text>,
        },
        new()
        {
            Title = L["操作"], HideTitle = true, Labeled = false, Class = "ep-row-actions",
            Cell = row => @<text>
                @if (row.CanManage)
                {
                    var member = row.Member;
                    @if (CanResend(member))
                    {
                        <button type="submit" name="Input.Action" value="@($"resend:{member.Id}")" class="ep-btn ep-btn-quiet"
                                aria-label="@(member.Invited ? L["重寄邀請給 {0}", member.Email] : L["寄驗證信給 {0}", member.Email])">@(member.Invited ? L["重寄邀請"] : L["寄驗證信"])</button>
                    }

                    @if (member.Managed)
                    {
                        @* 受目錄同步管理的人：角色與停用由身分來源決定，這裡不給改；擁有者可以先解除管理。 *@
                        @if (CanRelease)
                        {
                            <button type="submit" name="Input.Action" value="@($"release:{member.Id}")" class="ep-btn ep-btn-quiet"
                                    aria-label="@L["解除 {0} 的目錄同步管理", member.Email]">@L["解除管理"]</button>
                        }

                        <button type="submit" name="Input.Action" value="@($"reset:{member.Id}")" class="ep-btn ep-btn-quiet"
                                aria-label="@L["重設 {0} 的密碼", member.Email]">@L["重設密碼"]</button>
                    }
                    else
                    {
                        @if (member.Disabled)
                        {
                            <button type="submit" name="Input.Action" value="@($"enable:{member.Id}")" class="ep-btn ep-btn-quiet"
                                    aria-label="@L["重新啟用 {0}", member.Email]">@L["重新啟用"]</button>
                        }
                        else
                        {
                            <button type="submit" name="Input.Action" value="@($"disable:{member.Id}")" class="ep-btn ep-btn-quiet"
                                    aria-label="@L["停用 {0}", member.Email]">@L["停用"]</button>
                            <button type="submit" name="Input.Action" value="@($"reset:{member.Id}")" class="ep-btn ep-btn-quiet"
                                    aria-label="@L["重設 {0} 的密碼", member.Email]">@L["重設密碼"]</button>
                        }
                    }

                    @if (!member.Managed)
                    {
                        <OptionSelect Name="@($"role-{member.Id}")" Label="@L["{0} 的角色", member.Email]" Options="GrantableNames" Value="@member.Role" />
                        <button type="submit" name="Input.Action" value="@($"role:{member.Id}")" class="ep-btn ep-btn-quiet"
                                aria-label="@L["變更 {0} 的角色", member.Email]">@L["變更角色"]</button>
                    }
                }
            </text>,
        },
    ];
}
