@page "/portal/{Tenant}/login"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(PlatformAuth.PortalSignInRateLimit)]
@attribute [AllowAnonymous]
@inject IPortalAccount Account
@inject IAuthorizationService Authorization
@inject IGoogleSignInAvailability GoogleSignIn
@inherits PortalPageBase

<DocumentTitle Text="@L["登入"]" />

@if (Account.CurrentTenant is { } tenant)
{
    <section class="ep-login" aria-labelledby="login-title">
      <header>
        <h1 id="login-title" class="ep-display">@L["登入"]</h1>
        <p class="ep-login-tenant">@(tenant.Name ?? tenant.Identifier)</p>
      </header>
      <div>
        <LoginFlow Account="Account" Routes="SignInRoutes.Portal(tenant.Identifier)" FormName="portal-login"
                   GoogleAction="@(GoogleSignIn.Enabled ? PortalPaths.GoogleChallenge(tenant.Identifier) : null)"
                   Note="@L["沒有帳號或忘記密碼，請洽貴組織的管理員或我們的營運人員。"]" />
      </div>
    </section>
}

@code {
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // 路徑上的租戶不存在：這個頁面就不存在。
        if (Account.CurrentTenant is not { } tenant)
        {
            Navigation.NotFound();
            return;
        }

        // 已登入、可以正常使用的成員（同一份檢查：本租戶的成員、沒有待辦的強制步驟）不該再看到登入表單：
        // 外殼已經是已登入的樣子，登入網址被收藏或從信裡點開時，表單卻要人再登入一次。
        // 還有強制步驟的人不在這裡轉：他們的頁面由各自的授權導向，這裡留著表單讓他們能換帳號。
        if ((await Authorization.AuthorizeAsync(User, PlatformAuth.PortalPolicy)).Succeeded)
        {
            Navigation.NavigateTo(SignInRoutes.Portal(tenant.Identifier).SafeReturnUrl(ReturnUrl));
        }
    }
}
