@page "/portal/{Tenant}/login"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(PlatformAuth.PortalSignInRateLimit)]
@attribute [AllowAnonymous]
@inject IPortalAccount Account
@inherits PortalPageBase

<DocumentTitle Text="@L["登入"]" />

@if (Account.CurrentTenant is { } tenant)
{
    <section class="ep-login" aria-labelledby="login-title">
      <header>
        <h1 id="login-title" class="ep-display">@L["登入"]</h1>
        <p class="ep-login-tenant">@(tenant.Name ?? tenant.Identifier)</p>
      </header>
      <div>
        <LoginFlow Account="Account" Routes="SignInRoutes.Portal(tenant.Identifier)" FormName="portal-login"
                   Note="@L["沒有帳號或忘記密碼，請洽貴組織的管理員或我們的營運人員。"]" />
      </div>
    </section>
}

@code {
    // 路徑上的租戶不存在：這個頁面就不存在。
    protected override void OnInitialized()
    {
        if (Account.CurrentTenant is null)
        {
            Navigation.NotFound();
        }
    }
}
