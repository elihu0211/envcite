@page "/portal/{Tenant}/laws"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = PlatformAuth.PortalPolicy)]
@inherits PortalFormPageBase<NormativeReasoningForm>
@using System.Text.Json
@inject ITenantModules Modules
@inject ILawCorpusService LawCorpusService
@inject INormativeReasoningService ReasoningService

<DocumentTitle Text="@L["法規體系與合規"]" />

<PageHeader Title="@L["法規體系與合規"]" Description="@L["以凱爾森法規範位階（Stufenbau）呈現跨母法授權知識圖譜、條文結構與確定性合規推論。"]" />

@if (!HasCorpus && !HasReasoning)
{
    <FormAlert Kind="AlertKind.Info">@L["這個組織尚未開啟「法規沿革與條文瀏覽」模組。"]</FormAlert>
}
else
{
    <div class="ep-workbench-shell">
        @if (HasCorpus)
        {
            <form method="get" class="ep-workbench-bar" role="search" aria-label="@L["法規檢索與篩選"]">
                <input type="hidden" name="tab" value="@ResolvedTab" />
                <FormField For="f-law-cat" Label="@L["法規領域"]" Hint="@L["預設聚焦環境保護；改選「全部領域」可跨部會探索"]">
                    <OptionSelect Id="f-law-cat" Name="cat" Label="@L["法規領域"]" Inline="false"
                                  Options="CategoryOptions" Value="@SelectedCategoryValue" />
                </FormField>
                <FormField For="f-law-q" Label="@L["篩選法規"]" Hint="@L["輸入法規名稱或代碼"]">
                    <input id="f-law-q" name="q" class="ep-input" value="@Query" placeholder="@L["例如 空氣污染"]" />
                </FormField>
                <FormField For="f-law-as-of" Label="@L["基準日"]" Hint="@L["留空表示現行"]">
                    <input id="f-law-as-of" name="asOf" type="date" class="ep-input" value="@AsOf" />
                </FormField>
                <SubmitButton>@L["套用條件"]</SubmitButton>
            </form>
        }

        <div class="ep-workbench @(HasCorpus ? "has-catalog" : "no-catalog")">
            @if (HasCorpus)
            {
                <aside class="ep-workbench-catalog" aria-label="@L["法律樹結構"]">
                    <SectionCard Id="law-tree-title" Title="@CatalogTitle">
                        <div class="ep-facet-pills" aria-label="@L["快速切換領域"]">
                            @foreach (var cat in QuickCategoryLinks)
                            {
                                var active = string.Equals(SelectedCategoryValue, cat.Code, StringComparison.Ordinal);
                                <a class="ep-preset-chip @(active ? "is-active" : string.Empty)"
                                   href="@CategoryHref(cat.Code)"
                                   aria-current="@(active ? "page" : null)">@cat.Label</a>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(_treeError))
                        {
                            <FormAlert Message="@_treeError" />
                        }
                        else if (!_treeLoaded)
                        {
                            <FormAlert Kind="AlertKind.Info" Message="@L["目前無法取得法規目錄，請稍後再試或改用自然鍵查詢。"]" />
                        }
                        else if (_filteredRoots.Count == 0)
                        {
                            <FormAlert Kind="AlertKind.Info" Message="@L["指定條件沒有符合的法規版本。"]" />
                        }
                        else
                        {
                            <nav class="ep-law-tree" aria-label="@L["法規結構目錄"]">
                                @foreach (var root in _visibleRoots)
                                {
                                    @RenderTreeNode(root)
                                }
                            </nav>
                            @if (_filteredRoots.Count > MaxVisibleTreeRoots)
                            {
                                <p class="ep-hint">@L["已顯示前 {0} 筆母法體系（共 {1} 筆）；請輸入關鍵字或選擇單一領域縮小範圍。", MaxVisibleTreeRoots, _filteredRoots.Count]</p>
                            }
                        }

                        <details class="ep-tree-manual">
                            <summary class="ep-tree-manual-toggle">@L["依自然鍵直接查詢"]</summary>
                            <form method="get" class="ep-form">
                                <input type="hidden" name="cat" value="ALL" />
                                <input type="hidden" name="tab" value="@ResolvedTab" />
                                <FormField For="f-jurisdiction" Label="@L["管轄"]" Hint="@L["例如 TW-CENTRAL"]">
                                    <input id="f-jurisdiction" name="jurisdiction" class="ep-input" value="@(Jurisdiction ?? "TW-CENTRAL")" required />
                                </FormField>
                                <FormField For="f-scheme" Label="@L["識別碼方案"]" Hint="@L["例如 moj_pcode"]">
                                    <input id="f-scheme" name="idScheme" class="ep-input" value="@(IdScheme ?? "moj_pcode")" required />
                                </FormField>
                                <FormField For="f-local-id" Label="@L["法規代碼"]" Hint="@L["例如 O0020001"]">
                                    <input id="f-local-id" name="localId" class="ep-input" value="@LocalId" placeholder="O0020001" required />
                                </FormField>
                                <FormField For="f-manual-as-of" Label="@L["基準日"]" Hint="@L["留空表示現行"]">
                                    <input id="f-manual-as-of" name="asOf" type="date" class="ep-input" value="@AsOf" />
                                </FormField>
                                <SubmitButton>@L["查詢法規"]</SubmitButton>
                            </form>
                        </details>
                    </SectionCard>
                </aside>
            }

            <div class="ep-workbench-main">
                @if (HasCorpus)
                {
                    <PageTabs Items="WorkbenchTabs" Active="@ResolvedTab" Query="tab" HrefSelector="TabHref" Label="@L["工作台分頁"]" />

                    <TabPanel Key="graph" Active="@(ResolvedTab == "graph")">
                        <SectionCard Id="ontology-graph-title" Title="@GraphSectionTitle">
                            @if (_graphResult is { Available: true } graph && graph.Nodes.Count > 0)
                            {
                                var focusNode = FindFocusNode(graph);
                                <div class="ep-graph-summary-wrap">
                                    @if (focusNode is { InvalidationCount: > 0 })
                                    {
                                        <FormAlert Kind="AlertKind.Error"
                                                   Message="@L["本焦點法規含 {0} 項宣告違憲失效單元（資料來源：憲法法庭；未列出不等於無違憲失效）。", focusNode.InvalidationCount]" />
                                    }

                                    <StatGrid Items="GraphStats(graph, focusNode)" />

                                    <div class="ep-graph-legend" aria-label="@L["法規位階圖例"]">
                                        <span class="ep-legend-item"><span class="ep-legend-swatch" data-tier="0"></span>@L["Tier 0 憲法"]</span>
                                        <span class="ep-legend-item"><span class="ep-legend-swatch" data-tier="1"></span>@L["Tier 1 法律／條例"]</span>
                                        <span class="ep-legend-item"><span class="ep-legend-swatch" data-tier="2"></span>@L["Tier 2 法規命令"]</span>
                                        <span class="ep-legend-item"><span class="ep-legend-swatch" data-tier="3"></span>@L["Tier 3 再授權規則"]</span>
                                        <span class="ep-legend-item"><span class="ep-legend-line" data-kind="delegation"></span>@L["法律直接授權"]</span>
                                        <span class="ep-legend-item"><span class="ep-legend-line" data-kind="sub"></span>@L["再授權"]</span>
                                        <span class="ep-legend-item"><span class="ep-legend-swatch" data-tier="invalid"></span>@L["違憲失效（憲法法庭）"]</span>
                                    </div>

                                    @if (graph.Focus is not null)
                                    {
                                        <div class="ep-graph-filters">
                                            @if (graph.ChildGroups.Count > 0)
                                            {
                                                <div class="ep-chip-row" aria-label="@L["依定名種類篩選子法規"]">
                                                    <span class="ep-hint">@L["子法種類："]</span>
                                                    <a class="ep-preset-chip @(string.IsNullOrEmpty(DocType) ? "is-active" : string.Empty)"
                                                       href="@BuildFocusUrl(graph.Focus, docType: string.Empty)">
                                                        @L["全部 ({0})", graph.ChildGroups.Sum(g => g.Count)]
                                                    </a>
                                                    @foreach (var grp in graph.ChildGroups)
                                                    {
                                                        var activeDoc = string.Equals(DocType, grp.DocumentType, StringComparison.Ordinal);
                                                        <a class="ep-preset-chip @(activeDoc ? "is-active" : string.Empty)"
                                                           href="@BuildFocusUrl(graph.Focus, docType: grp.DocumentType)">
                                                            @($"{grp.DocumentType} ({grp.Count})")
                                                        </a>
                                                    }
                                                </div>
                                            }
                                            <div class="ep-chip-row" aria-label="@L["展開深度與數量"]">
                                                <span class="ep-hint">@L["子法上限："]</span>
                                                @foreach (var cap in new[] { 20, 40, 60 })
                                                {
                                                    <a class="ep-preset-chip @(ResolvedChildLimit == cap ? "is-active" : string.Empty)"
                                                       href="@BuildFocusUrl(graph.Focus, childLimit: cap)">@cap</a>
                                                }
                                                <span class="ep-hint">@L["階層深度："]</span>
                                                @foreach (var depth in new[] { 1, 2, 4 })
                                                {
                                                    <a class="ep-preset-chip @(ResolvedUpDepth == depth && ResolvedDownDepth == depth ? "is-active" : string.Empty)"
                                                       href="@BuildFocusUrl(graph.Focus, upDepth: depth, downDepth: depth)">
                                                        @L["上下各 {0} 層", depth]
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="ep-graph-host" data-graph-host="true">
                                    <div class="ep-graph-toolbar">
                                        <div class="ep-chip-row">
                                            <button type="button" class="ep-preset-chip" data-graph-action="layout-stufenbau" aria-pressed="true">@L["位階分層（Stufenbau）"]</button>
                                            <button type="button" class="ep-preset-chip" data-graph-action="layout-concentric" aria-pressed="false">@L["焦點星系（同心圓）"]</button>
                                            <button type="button" class="ep-preset-chip" data-graph-action="toggle-edge-labels" aria-pressed="false">@L["顯示授權條號"]</button>
                                        </div>
                                        <div class="ep-graph-zoom-actions">
                                            <button type="button" class="ep-btn ep-btn-quiet" data-graph-action="zoom-in" aria-label="@L["放大圖譜"]">+</button>
                                            <button type="button" class="ep-btn ep-btn-quiet" data-graph-action="zoom-out" aria-label="@L["縮小圖譜"]">-</button>
                                            <button type="button" class="ep-btn ep-btn-quiet" data-graph-action="fit">@L["適應視窗"]</button>
                                        </div>
                                    </div>

                                    <div class="ep-graph-canvas" data-ontology-graph="@BuildGraphJson(graph)"
                                         role="region" aria-label="@L["法律授權知識圖譜"]"></div>

                                    <section class="ep-graph-inspector" data-graph-inspector="true" aria-live="polite" aria-label="@L["節點法學檢視"]">
                                        <p class="ep-page-description">@L["點選圖譜中的任一法規範節點檢視法學位階、授權條文依據與關係細節；雙擊節點可直接以其為中心深入展開。"]</p>
                                    </section>
                                </div>

                                @if (graph.ViolationLinks.Count > 0)
                                {
                                    <div class="ep-graph-subpanel">
                                        <h3 class="ep-subpanel-title">@L["罰則與義務／授權條文連動 ({0})", graph.ViolationLinks.Count]</h3>
                                        <DataTable Items="graph.ViolationLinks" Columns="ViolationColumns" Label="@L["罰則與義務條文連動"]" Plain="true" />
                                    </div>
                                }

                                @if (graph.GuidanceLinks.Count > 0)
                                {
                                    <div class="ep-graph-subpanel">
                                        <h3 class="ep-subpanel-title">@L["現行有效行政函釋錨點 ({0})", graph.GuidanceLinks.Count]</h3>
                                        <FormAlert Kind="AlertKind.Info" Message="@L["行政規則僅供參考（行政程序法第 159 條），不拘束法院審判；法規命令須經法律明確授權。"]" />
                                        <DataTable Items="graph.GuidanceLinks" Columns="GuidanceColumns" Label="@L["現行有效行政函釋"]" Plain="true" />
                                    </div>
                                }
                            }
                            else if (_graphResult is { Available: false })
                            {
                                <FormAlert Kind="AlertKind.Info" Message="@L["目前無法取得授權知識圖譜，請稍後再試或切換至「編章節條文」分頁。"]" />
                            }
                            else
                            {
                                <EmptyState Icon="@Icons.Material.Outlined.AccountTree"
                                            Title="@L["此範圍尚無授權關聯節點"]"
                                            Description="@L["請切換「法規領域」、清空關鍵字，或從左側法規階層目錄點選任一部法規作為焦點。"]" />
                            }
                        </SectionCard>
                    </TabPanel>

                    <TabPanel Key="structure" Active="@(ResolvedTab == "structure")">
                        @if (!string.IsNullOrEmpty(_lookupError))
                        {
                            <FormAlert Message="@_lookupError" />
                        }
                        else if (_result is { } law)
                        {
                            var focusNode = _graphResult is not null ? FindFocusNode(_graphResult) : null;
                            if (focusNode is { InvalidationCount: > 0 })
                            {
                                <FormAlert Kind="AlertKind.Error"
                                           Message="@L["本焦點法規含 {0} 項宣告違憲失效單元（資料來源：憲法法庭；未列出不等於無違憲失效）。", focusNode.InvalidationCount]" />
                            }
                            <SectionCard Id="law-detail-title" Title="@law.Title">
                                <div class="ep-structure-header">
                                    <p class="ep-page-description">
                                        @if (!string.IsNullOrEmpty(law.DateDocument))
                                        {
                                            <span>@L["制定日："]@law.DateDocument</span>
                                            <span> · </span>
                                        }
                                        @if (!string.IsNullOrEmpty(law.Language))
                                        {
                                            <span>@L["語言"]：@law.Language</span>
                                            <span> · </span>
                                        }
                                        @if (HasSelectedLaw)
                                        {
                                            <span>@L["自然鍵"]：<code class="ep-mono">@($"{Jurisdiction}/{IdScheme}/{LocalId}")</code></span>
                                            <span> · </span>
                                        }
                                        <span class="ep-mono">@law.Uri</span>
                                    </p>
                                    @if (_graphResult?.Focus is not null)
                                    {
                                        <a class="ep-btn ep-btn-quiet" href="@BuildFocusUrl(_graphResult.Focus, tab: "graph")">@L["在授權知識圖譜檢視"]</a>
                                    }
                                </div>

                                <StatGrid Items="StructureStats(law, focusNode)" />

                                @if (law.Articles.Count == 0)
                                {
                                    <FormAlert Kind="AlertKind.Info" Message="@L["這部法規在指定日期沒有條文。"]" />
                                }
                                else
                                {
                                    @if (law.Structure.Count > 0)
                                    {
                                        <details class="ep-structure-box" open>
                                            <summary class="ep-tree-manual-toggle">@L["法規結構目錄"]</summary>
                                            <ul class="ep-structure-list">
                                                @foreach (var heading in law.Structure)
                                                {
                                                    @RenderStructureNode(heading, 0)
                                                }
                                            </ul>
                                        </details>
                                    }
                                    <DataTable Items="law.Articles" Columns="ArticleColumns" Label="@L["條文清單"]" Plain="true" />
                                }
                            </SectionCard>
                        }
                        else
                        {
                            <SectionCard Id="law-detail-empty" Title="@L["編章節與有效條文"]">
                                <EmptyState Icon="@Icons.Material.Outlined.MenuBook"
                                            Title="@L["從左側目錄或知識圖譜選擇法規"]"
                                            Description="@L["點選左側法規階層目錄中的任一部法規，或在「授權知識圖譜」分頁中雙擊節點，即可檢視編章節結構與有效條文清單。"]" />
                            </SectionCard>
                        }
                    </TabPanel>

                    @if (HasReasoning)
                    {
                        <TabPanel Key="reasoning" Active="@(ResolvedTab == "reasoning")">
                            @RenderReasoningWorkspace()
                        </TabPanel>
                    }
                }
                else if (HasReasoning)
                {
                    @RenderReasoningWorkspace()
                }
            </div>
        </div>
    </div>
}

@code {
    private const int MaxVisibleTreeRoots = 250;

    private static readonly string[] DomainCodes = ["O", "ALL", "A", "D", "G", "J", "K", "L", "N"];

    [SupplyParameterFromQuery(Name = "jurisdiction")] public string? Jurisdiction { get; set; }
    [SupplyParameterFromQuery(Name = "idScheme")] public string? IdScheme { get; set; }
    [SupplyParameterFromQuery(Name = "localId")] public string? LocalId { get; set; }
    [SupplyParameterFromQuery(Name = "asOf")] public string? AsOf { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "cat")] public string? Category { get; set; }
    [SupplyParameterFromQuery(Name = "upDepth")] public int? UpDepth { get; set; }
    [SupplyParameterFromQuery(Name = "downDepth")] public int? DownDepth { get; set; }
    [SupplyParameterFromQuery(Name = "childLimit")] public int? ChildLimit { get; set; }
    [SupplyParameterFromQuery(Name = "docType")] public string? DocType { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? ActiveTabQuery { get; set; }

    private bool _treeLoaded;
    private string? _treeError;
    private IReadOnlyList<PortalLawTreeNode> _treeRoots = [];
    private IReadOnlyList<PortalLawTreeNode> _filteredRoots = [];
    private IReadOnlyList<PortalLawTreeNode> _visibleRoots = [];
    private PortalLawGraphResult? _graphResult;
    private PortalLawCorpusResult? _result;
    private PortalReasoningOutcome? _reasoningOutcome;
    private string? _lookupError;
    private readonly HashSet<string> _activeBranchKeys = new(StringComparer.Ordinal);

    private bool HasCorpus => Modules.IsEnabled(Tenant, ModuleKeys.LawCorpus);
    private bool HasReasoning => Modules.IsEnabled(Tenant, ModuleKeys.NormativeReasoning);
    private bool HasSelectedLaw =>
        !string.IsNullOrWhiteSpace(Jurisdiction)
        && !string.IsNullOrWhiteSpace(IdScheme)
        && !string.IsNullOrWhiteSpace(LocalId);

    private int ResolvedUpDepth => Math.Clamp(UpDepth ?? 2, 1, 4);
    private int ResolvedDownDepth => Math.Clamp(DownDepth ?? 2, 1, 4);
    private int ResolvedChildLimit => Math.Clamp(ChildLimit ?? 20, 1, 60);

    private string SelectedCategoryValue
    {
        get
        {
            if (string.Equals(Category, "ALL", StringComparison.OrdinalIgnoreCase))
                return "ALL";
            if (!string.IsNullOrWhiteSpace(Category) && Category.Trim().Length == 1 && char.IsAsciiLetterUpper(Category.Trim()[0]))
                return Category.Trim();
            if (!string.IsNullOrWhiteSpace(Query) || HasSelectedLaw)
                return "ALL";
            return "O";
        }
    }

    private string? EffectiveCategoryPrefix => SelectedCategoryValue == "ALL" ? null : SelectedCategoryValue;

    private string ResolvedTab
    {
        get
        {
            if (_reasoningOutcome is not null || !string.IsNullOrEmpty(Error))
                return HasReasoning ? "reasoning" : "graph";
            if (string.Equals(ActiveTabQuery, "structure", StringComparison.OrdinalIgnoreCase))
                return "structure";
            if (string.Equals(ActiveTabQuery, "reasoning", StringComparison.OrdinalIgnoreCase) && HasReasoning)
                return "reasoning";
            return "graph";
        }
    }

    private string CatalogTitle => L["法律樹結構 ({0})", _filteredRoots.Count];

    private string GraphSectionTitle => _graphResult?.Focus is not null && FindFocusNode(_graphResult) is { } focus
        ? L["授權知識圖譜 · {0}", focus.Title]
        : SelectedCategoryValue == "ALL"
            ? L["授權知識圖譜 · 全域總覽"]
            : L["授權知識圖譜 · {0}", DomainLabel(SelectedCategoryValue)];

    private string DomainLabel(string code) => code switch
    {
        "O" => L["O · 環境保護"],
        "ALL" => L["全部領域"],
        "A" => L["A · 憲政體制"],
        "D" => L["D · 內政營建"],
        "G" => L["G · 財政賦稅"],
        "J" => L["J · 經濟能源"],
        "K" => L["K · 交通運輸"],
        "L" => L["L · 衛生食藥"],
        "N" => L["N · 勞動職安"],
        _ => code,
    };

    private IReadOnlyList<SelectOption> CategoryOptions =>
        [.. DomainCodes.Select(code => new SelectOption(code, DomainLabel(code)))];

    private IReadOnlyList<(string Code, string Label)> QuickCategoryLinks =>
        [.. DomainCodes.Select(code => (code, DomainLabel(code)))];

    private IReadOnlyList<TabItem> WorkbenchTabs
    {
        get
        {
            var items = new List<TabItem>
            {
                new("graph", L["授權知識圖譜"], _graphResult?.Nodes.Count),
                new("structure", L["編章節條文"], _result?.Articles.Count),
            };
            if (HasReasoning)
                items.Add(new("reasoning", L["合規推論試算"], _reasoningOutcome?.Verdicts.Count));
            return items;
        }
    }

    private IReadOnlyList<SelectOption> TriStateOptions =>
    [
        new(string.Empty, L["未知（省略）"]),
        new("true", L["是"]),
        new("false", L["否"]),
    ];

    private IReadOnlyList<ColumnDef<PortalLawArticle>> ArticleColumns =>
    [
        new() { Title = L["條號"], Class = "ep-keep", Labeled = false, Cell = a => @<text><code class="ep-mono">@a.Number</code></text> },
        new() { Title = L["網址"], Cell = a => @<text><code class="ep-mono">@a.Uri</code></text> },
    ];

    private IReadOnlyList<ColumnDef<PortalArticleViolationLink>> ViolationColumns =>
    [
        new() { Title = L["處罰條文"], Class = "ep-keep", Labeled = false, Cell = v => @<text><code class="ep-mono">@v.PenaltyArticle</code></text> },
        new()
        {
            Title = L["連動類型"],
            Cell = v => @<text><StatusBadge Tone="@(v.Kind == "duty" ? "warning" : "info")">@ViolationKindLabel(v.Kind)</StatusBadge></text>,
        },
        new() { Title = L["被連動義務／規範條文"], Cell = v => @<text><code class="ep-mono">@v.TargetArticle</code> <span class="ep-hint">@v.TargetPath</span></text> },
    ];

    private IReadOnlyList<ColumnDef<PortalGuidanceLink>> GuidanceColumns =>
    [
        new() { Title = L["關聯條號"], Class = "ep-keep", Labeled = false, Cell = g => @<text><code class="ep-mono">@g.ArticleNumber</code></text> },
        new() { Title = L["發文字號"], Cell = g => @<text><code class="ep-mono">@g.DocumentNo</code></text> },
        new() { Title = L["機關與日期"], Cell = g => @<text>@g.Issuer · @g.IssuedOn</text> },
        new()
        {
            Title = L["主旨"],
            Cell = g => @<text>
                @if (!string.IsNullOrEmpty(g.SourceUrl))
                {
                    <a class="ep-link" href="@g.SourceUrl" target="_blank" rel="noopener noreferrer">@g.Subject</a>
                }
                else
                {
                    @g.Subject
                }
            </text>,
        },
    ];

    private IReadOnlyList<ColumnDef<PortalReasoningVerdict>> VerdictColumns =>
    [
