@page "/portal/{Tenant}/laws"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = PlatformAuth.PortalPolicy)]
@inherits PortalFormPageBase<NormativeReasoningForm>

<DocumentTitle Text="@L["法規體系與合規"]" />

<PageHeader Title="@L["法規體系與合規"]" Description="@L["以凱爾森法規範位階（Stufenbau）呈現跨母法授權知識圖譜、條文結構與確定性合規推論。"]" />

@if (!HasCorpus && !HasReasoning)
{
    <FormAlert Kind="AlertKind.Info">@L["這個組織尚未開啟「法規沿革與條文瀏覽」模組。"]</FormAlert>
}
else
{
    <div class="ep-workbench-shell">
        @if (HasCorpus)
        {
            <form method="get" class="ep-workbench-bar" role="search" aria-label="@L["法規檢索與篩選"]">
                <input type="hidden" name="tab" value="@ResolvedTab" />
                <FormField For="f-law-cat" Label="@L["法規領域"]" Hint="@L["預設聚焦環境保護；改選「全部領域」可跨部會探索"]">
                    <OptionSelect Id="f-law-cat" Name="cat" Label="@L["法規領域"]" Inline="false"
                                  Options="CategoryOptions" Value="@SelectedCategoryValue" />
                </FormField>
                <FormField For="f-law-q" Label="@L["篩選法規"]" Hint="@L["輸入法規名稱或代碼"]">
                    <input id="f-law-q" name="q" class="ep-input" value="@Query" placeholder="@L["例如 空氣污染"]" />
                </FormField>
                <FormField For="f-law-as-of" Label="@L["基準日"]" Hint="@L["留空表示現行"]">
                    <input id="f-law-as-of" name="asOf" type="date" class="ep-input" value="@AsOf" />
                </FormField>
                <div class="ep-workbench-bar-actions">
                    <SubmitButton>@L["套用條件"]</SubmitButton>
                    <button type="button" class="ep-btn ep-btn-quiet ep-workbench-catalog-toggle"
                            data-workbench-toggle="catalog" aria-expanded="false" aria-controls="ep-workbench-catalog">
                        <NavIcon Path="@Icons.Material.Outlined.AccountTree" />
                        <span>@CatalogTitle</span>
                    </button>
                </div>
            </form>
        }

        <div class="ep-workbench @(HasCorpus ? "has-catalog" : "no-catalog")" data-workbench-root="true">
            @if (HasCorpus)
            {
                <div class="ep-workbench-backdrop" data-workbench-close="catalog" aria-hidden="true"></div>
                <aside id="ep-workbench-catalog" class="ep-workbench-catalog" aria-label="@L["法律樹結構"]">
                    <div class="ep-workbench-catalog-drawer-head">
                        <span class="ep-workbench-catalog-drawer-title">@CatalogTitle</span>
                        <button type="button" class="ep-btn ep-btn-quiet ep-workbench-catalog-close"
                                data-workbench-close="catalog" aria-label="@L["關閉"]">
                            @L["關閉"]
                        </button>
                    </div>
                    <SectionCard Id="law-tree-title" Title="@CatalogTitle">
                        <div class="ep-facet-pills" aria-label="@L["快速切換領域"]">
                            @foreach (var cat in QuickCategoryLinks)
                            {
                                var active = string.Equals(SelectedCategoryValue, cat.Code, StringComparison.Ordinal);
                                <a class="ep-preset-chip @(active ? "is-active" : string.Empty)"
                                   href="@CategoryHref(cat.Code)"
                                   aria-current="@(active ? "page" : null)">@cat.Label</a>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(_treeError))
                        {
                            <FormAlert Message="@_treeError" />
                        }
                        else if (!_treeLoaded)
                        {
                            <FormAlert Kind="AlertKind.Info" Message="@L["目前無法取得法規目錄，請稍後再試或改用自然鍵查詢。"]" />
                        }
                        else if (_filteredRoots.Count == 0)
                        {
                            <FormAlert Kind="AlertKind.Info" Message="@L["指定條件沒有符合的法規版本。"]" />
                        }
                        else
                        {
                            <nav class="ep-law-tree" aria-label="@L["法規結構目錄"]">
                                @foreach (var root in _visibleRoots)
                                {
                                    @RenderTreeNode(root)
                                }
                            </nav>
                            @if (_filteredRoots.Count > MaxVisibleTreeRoots)
                            {
                                <p class="ep-hint">@L["已顯示前 {0} 筆母法體系（共 {1} 筆）；請輸入關鍵字或選擇單一領域縮小範圍。", MaxVisibleTreeRoots, _filteredRoots.Count]</p>
                            }
                        }

                        <details class="ep-tree-manual">
                            <summary class="ep-tree-manual-toggle">@L["依自然鍵直接查詢"]</summary>
                            <form method="get" class="ep-form">
                                <input type="hidden" name="cat" value="ALL" />
                                <input type="hidden" name="tab" value="@ResolvedTab" />
                                <FormField For="f-jurisdiction" Label="@L["管轄"]" Hint="@L["例如 TW-CENTRAL"]">
                                    <input id="f-jurisdiction" name="jurisdiction" class="ep-input" value="@(Jurisdiction ?? "TW-CENTRAL")" required />
                                </FormField>
                                <FormField For="f-scheme" Label="@L["識別碼方案"]" Hint="@L["例如 moj_pcode"]">
                                    <input id="f-scheme" name="idScheme" class="ep-input" value="@(IdScheme ?? "moj_pcode")" required />
                                </FormField>
                                <FormField For="f-local-id" Label="@L["法規代碼"]" Hint="@L["例如 O0020001"]">
                                    <input id="f-local-id" name="localId" class="ep-input" value="@LocalId" placeholder="O0020001" required />
                                </FormField>
                                <FormField For="f-manual-as-of" Label="@L["基準日"]" Hint="@L["留空表示現行"]">
                                    <input id="f-manual-as-of" name="asOf" type="date" class="ep-input" value="@AsOf" />
                                </FormField>
                                <SubmitButton>@L["查詢法規"]</SubmitButton>
                            </form>
                        </details>
                    </SectionCard>
                </aside>
            }

            <div class="ep-workbench-main">
                @if (HasCorpus)
                {
                    <PageTabs Items="WorkbenchTabs" Active="@ResolvedTab" Query="tab" HrefSelector="TabHref" Label="@L["工作台分頁"]" />

                    <TabPanel Key="graph" Active="@(ResolvedTab == "graph")">
                        <SectionCard Id="ontology-graph-title" Title="@GraphSectionTitle">
                            @if (_graphResult is { Available: true } graph && graph.Nodes.Count > 0)
                            {
                                var focusNode = FindFocusNode(graph);
                                <div class="ep-graph-summary-wrap">
                                    @if (focusNode is { InvalidationCount: > 0 })
                                    {
                                        <FormAlert Kind="AlertKind.Error"
                                                   Message="@L["本焦點法規含 {0} 項宣告違憲失效單元（資料來源：憲法法庭；未列出不等於無違憲失效）。", focusNode.InvalidationCount]" />
                                    }

                                    @if (graph.Focus is not null)
                                    {
                                        <div class="ep-graph-filters">
                                            @if (graph.ChildGroups.Count > 0)
                                            {
                                                <div class="ep-chip-row" aria-label="@L["依定名種類篩選子法規"]">
                                                    <span class="ep-hint">@L["子法種類："]</span>
                                                    <a class="ep-preset-chip @(string.IsNullOrEmpty(DocType) ? "is-active" : string.Empty)"
                                                       href="@BuildFocusUrl(graph.Focus, docType: string.Empty)">
                                                        @L["全部 ({0})", graph.ChildGroups.Sum(g => g.Count)]
                                                    </a>
                                                    @foreach (var grp in graph.ChildGroups)
                                                    {
                                                        var activeDoc = string.Equals(DocType, grp.DocumentType, StringComparison.Ordinal);
                                                        <a class="ep-preset-chip @(activeDoc ? "is-active" : string.Empty)"
                                                           href="@BuildFocusUrl(graph.Focus, docType: grp.DocumentType)">
                                                            @($"{grp.DocumentType} ({grp.Count})")
                                                        </a>
                                                    }
                                                </div>
                                            }
                                            <div class="ep-chip-row" aria-label="@L["展開深度與數量"]">
                                                <span class="ep-hint">@L["子法上限："]</span>
                                                @foreach (var cap in new[] { 20, 40, 60 })
                                                {
                                                    <a class="ep-preset-chip @(ResolvedChildLimit == cap ? "is-active" : string.Empty)"
                                                       href="@BuildFocusUrl(graph.Focus, childLimit: cap)">@cap</a>
                                                }
                                                <span class="ep-hint">@L["階層深度："]</span>
                                                @foreach (var depth in new[] { 1, 2, 4 })
                                                {
                                                    <a class="ep-preset-chip @(ResolvedUpDepth == depth && ResolvedDownDepth == depth ? "is-active" : string.Empty)"
                                                       href="@BuildFocusUrl(graph.Focus, upDepth: depth, downDepth: depth)">
                                                        @L["上下各 {0} 層", depth]
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="ep-graph-host" data-graph-host="true" data-inspector-open="false">
                                    <div class="ep-graph-stage">
                                        <div class="ep-graph-toolbar">
                                            <div class="ep-chip-row">
                                                <button type="button" class="ep-preset-chip" data-graph-action="layout-stufenbau" aria-pressed="true">@L["位階分層（Stufenbau）"]</button>
                                                <button type="button" class="ep-preset-chip" data-graph-action="layout-indented" aria-pressed="false">@L["法律樹結構"]</button>
                                                <button type="button" class="ep-preset-chip" data-graph-action="layout-concentric" aria-pressed="false">@L["焦點星系（同心圓）"]</button>
                                            </div>
                                            <div class="ep-graph-toolbar-end">
                                                <input type="search" class="ep-input ep-graph-search" data-graph-search="true"
                                                       placeholder="@L["篩選法規"]" aria-label="@L["篩選法規"]" />
                                            </div>
                                        </div>

                                        <div class="ep-graph-canvas-wrap">
                                            <div class="ep-graph-swimlanes" data-graph-swimlanes="true"
                                                 data-graph-summary="@($"{L["圖譜節點"]} {graph.Nodes.Count} · {L["授權連線"]} {graph.Edges.Count}")"></div>
                                            <div class="ep-graph-canvas" data-ontology-graph="@BuildGraphJson(graph)"
                                                 role="region" aria-label="@L["法律授權知識圖譜"]"></div>
                                            <div class="ep-graph-floating-controls" role="toolbar" aria-label="@L["圖譜視角控制"]">
                                                <button type="button" class="ep-preset-chip" data-graph-action="toggle-edge-labels" aria-pressed="false">@L["顯示授權條號"]</button>
                                                <button type="button" class="ep-btn ep-btn-quiet" data-graph-action="zoom-in" aria-label="@L["放大圖譜"]">+</button>
                                                <button type="button" class="ep-btn ep-btn-quiet" data-graph-action="zoom-out" aria-label="@L["縮小圖譜"]">-</button>
                                                <button type="button" class="ep-btn ep-btn-quiet" data-graph-action="fit">@L["適應視窗"]</button>
                                                <button type="button" class="ep-btn ep-btn-quiet" data-graph-action="fullscreen">@L["全螢幕"]</button>
                                            </div>
                                        </div>
                                    </div>

                                    <section class="ep-graph-inspector" aria-live="polite" aria-label="@L["節點法學檢視"]">
                                        <div class="ep-inspector-sheet-bar">
                                            <span class="ep-inspector-sheet-handle" aria-hidden="true"></span>
                                            <button type="button" class="ep-btn ep-btn-quiet ep-inspector-close"
                                                    data-inspector-close="true" aria-label="@L["關閉"]">@L["關閉"]</button>
                                        </div>
                                        <div class="ep-inspector-body" data-graph-inspector="true">
                                            <p class="ep-page-description">@L["點選圖譜中的任一法規範節點檢視法學位階、授權條文依據與關係細節；雙擊節點可直接以其為中心深入展開。"]</p>
                                        </div>
                                    </section>
                                </div>

                                @if (graph.ViolationLinks.Count > 0)
                                {
                                    <div class="ep-graph-subpanel">
                                        <h3 class="ep-subpanel-title">@L["罰則與義務／授權條文連動 ({0})", graph.ViolationLinks.Count]</h3>
                                        <DataTable Items="graph.ViolationLinks" Columns="ViolationColumns" Label="@L["罰則與義務條文連動"]" Plain="true" />
                                    </div>
                                }

                                @if (graph.GuidanceLinks.Count > 0)
                                {
                                    <div class="ep-graph-subpanel">
                                        <h3 class="ep-subpanel-title">@L["現行有效行政函釋錨點 ({0})", graph.GuidanceLinks.Count]</h3>
                                        <FormAlert Kind="AlertKind.Info" Message="@L["行政規則僅供參考（行政程序法第 159 條），不拘束法院審判；法規命令須經法律明確授權。"]" />
                                        <DataTable Items="graph.GuidanceLinks" Columns="GuidanceColumns" Label="@L["現行有效行政函釋"]" Plain="true" />
                                    </div>
                                }
                            }
                            else if (_graphResult is { Available: false })
                            {
                                <FormAlert Kind="AlertKind.Info" Message="@L["目前無法取得授權知識圖譜，請稍後再試或切換至「編章節條文」分頁。"]" />
                            }
                            else
                            {
                                <EmptyState Icon="@Icons.Material.Outlined.AccountTree"
                                            Title="@L["此範圍尚無授權關聯節點"]"
                                            Description="@L["請切換「法規領域」、清空關鍵字，或從左側法規階層目錄點選任一部法規作為焦點。"]" />
                            }
                        </SectionCard>
                    </TabPanel>

                    <TabPanel Key="structure" Active="@(ResolvedTab == "structure")">
                        @if (!string.IsNullOrEmpty(_lookupError))
                        {
                            <FormAlert Message="@_lookupError" />
                        }
                        else if (_result is { } law)
                        {
                            var focusNode = _graphResult is not null ? FindFocusNode(_graphResult) : null;
                            if (focusNode is { InvalidationCount: > 0 })
                            {
                                <FormAlert Kind="AlertKind.Error"
                                           Message="@L["本焦點法規含 {0} 項宣告違憲失效單元（資料來源：憲法法庭；未列出不等於無違憲失效）。", focusNode.InvalidationCount]" />
                            }
                            <SectionCard Id="law-detail-title" Title="@law.Title">
                                <div class="ep-structure-header">
                                    <p class="ep-page-description">
                                        @if (!string.IsNullOrEmpty(law.DateDocument))
                                        {
                                            <span>@L["制定日："]@law.DateDocument</span>
                                            <span> · </span>
                                        }
                                        @if (!string.IsNullOrEmpty(law.Language))
                                        {
                                            <span>@L["語言"]：@law.Language</span>
                                            <span> · </span>
                                        }
                                        @if (HasSelectedLaw)
                                        {
                                            <span>@L["自然鍵"]：<code class="ep-mono">@($"{Jurisdiction}/{IdScheme}/{LocalId}")</code></span>
                                            <span> · </span>
                                        }
                                        <span class="ep-mono">@law.Uri</span>
                                    </p>
                                    <div class="ep-structure-actions">
                                        @if (Modules.IsEnabled(Tenant, ModuleKeys.LawSearch) || Modules.IsEnabled(Tenant, ModuleKeys.GroundedAnswer))
                                        {
                                            <a class="ep-btn ep-btn-quiet ep-structure-ask" href="@AskLawHref(law.Title)">
                                                <NavIcon Path="@Icons.Material.Outlined.Forum" />
                                                <span>@L["問問 AI"]</span>
                                            </a>
                                        }
                                        @if (_graphResult?.Focus is not null)
                                        {
                                            <a class="ep-btn ep-btn-quiet" href="@BuildFocusUrl(_graphResult.Focus, tab: "graph")">@L["在授權知識圖譜檢視"]</a>
                                        }
                                    </div>
                                </div>

                                <StatGrid Items="StructureStats(law, focusNode)" />

                                @if (law.Articles.Count == 0)
                                {
                                    <FormAlert Kind="AlertKind.Info" Message="@L["這部法規在指定日期沒有條文。"]" />
                                }
                                else
                                {
                                    @if (law.Structure.Count > 0)
                                    {
                                        <details class="ep-structure-box" open>
                                            <summary class="ep-tree-manual-toggle">@L["法規結構目錄"]</summary>
                                            <ul class="ep-structure-list">
                                                @foreach (var heading in law.Structure)
                                                {
                                                    @RenderStructureNode(heading, 0)
                                                }
                                            </ul>
                                        </details>
                                    }
                                    <DataTable Items="law.Articles" Columns="ArticleColumns" Label="@L["條文清單"]" Plain="true" />
                                }
                            </SectionCard>
                        }
                        else
                        {
                            <SectionCard Id="law-detail-empty" Title="@L["編章節與有效條文"]">
                                <EmptyState Icon="@Icons.Material.Outlined.MenuBook"
                                            Title="@L["從左側目錄或知識圖譜選擇法規"]"
                                            Description="@L["點選左側法規階層目錄中的任一部法規，或在「授權知識圖譜」分頁中雙擊節點，即可檢視編章節結構與有效條文清單。"]" />
                            </SectionCard>
                        }
                    </TabPanel>

                    @if (HasReasoning)
                    {
                        <TabPanel Key="reasoning" Active="@(ResolvedTab == "reasoning")">
                            @RenderReasoningWorkspace()
                        </TabPanel>
                    }
                }
                else if (HasReasoning)
                {
                    @RenderReasoningWorkspace()
                }
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<ColumnDef<PortalLawArticle>> ArticleColumns =>
    [
        new() { Title = L["條號"], Class = "ep-keep", Labeled = false, Cell = a => @<text><code class="ep-mono">@a.Number</code></text> },
        new() { Title = L["網址"], Cell = a => @<text><code class="ep-mono">@a.Uri</code></text> },
    ];

    private IReadOnlyList<ColumnDef<PortalArticleViolationLink>> ViolationColumns =>
    [
        new() { Title = L["處罰條文"], Class = "ep-keep", Labeled = false, Cell = v => @<text><code class="ep-mono">@v.PenaltyArticle</code></text> },
        new()
        {
            Title = L["連動類型"],
            Cell = v => @<text><StatusBadge Tone="@(v.Kind == "duty" ? "warning" : "info")">@ViolationKindLabel(v.Kind)</StatusBadge></text>,
        },
        new() { Title = L["被連動義務／規範條文"], Cell = v => @<text><code class="ep-mono">@v.TargetArticle</code> <span class="ep-hint">@v.TargetPath</span></text> },
    ];

    private IReadOnlyList<ColumnDef<PortalGuidanceLink>> GuidanceColumns =>
    [
        new() { Title = L["關聯條號"], Class = "ep-keep", Labeled = false, Cell = g => @<text><code class="ep-mono">@g.ArticleNumber</code></text> },
        new() { Title = L["發文字號"], Cell = g => @<text><code class="ep-mono">@g.DocumentNo</code></text> },
        new() { Title = L["機關與日期"], Cell = g => @<text>@g.Issuer · @g.IssuedOn</text> },
        new()
        {
            Title = L["主旨"],
            Cell = g => @<text>
                @if (!string.IsNullOrEmpty(g.SourceUrl))
                {
                    <a class="ep-link" href="@g.SourceUrl" target="_blank" rel="noopener noreferrer">@g.Subject</a>
                }
                else
                {
                    @g.Subject
                }
            </text>,
        },
    ];

    private IReadOnlyList<ColumnDef<PortalReasoningVerdict>> VerdictColumns =>
    [
        new() { Title = L["法規"], Class = "ep-keep", Labeled = false, Cell = v => @<text>@v.LawTitle</text> },
        new() { Title = L["陳述"], Cell = v => @<text><code class="ep-mono">@v.StatementId</code></text> },
        new() { Title = L["候選判定"], Cell = v => @<text><StatusBadge Tone="@VerdictTone(v.Verdict)">@VerdictLabel(v.Verdict)</StatusBadge></text> },
        new() { Title = L["缺漏事實數"], Numeric = true, Cell = v => @<text>@v.MissingCount</text> },
    ];

    private RenderFragment RenderReasoningWorkspace() =>
        @<SectionCard Id="reasoning-panel-title" Title="@L["合規推論試算"]">
            <p class="ep-page-description">@L["選擇常見情境或輸入事實，由確定性推論引擎評估候選風險與缺漏要件。"]</p>
            <div class="ep-preset-row">
                <button type="button" class="ep-preset-chip" data-reasoning-preset="daily">@L["日常合規自評"]</button>
                <button type="button" class="ep-preset-chip" data-reasoning-preset="incident">@L["設備異常通報"]</button>
                <button type="button" class="ep-preset-chip" data-reasoning-preset="benefit">@L["超標與不法利得"]</button>
            </div>
            <FormAlert Message="@Error" />
            <PostForm Model="Input" FormName="portal-reasoning" OnValidSubmit="EvaluateAsync">
                <div class="ep-reasoning-grid">
                    <FormField For="r-conduct-on" Label="@L["行為日"]" Hint="@L["YYYY-MM-DD（必填）"]">
                        <input id="r-conduct-on" name="Input.ConductOn" type="date" class="ep-input" value="@Input.ConductOn" required />
                    </FormField>
                    <FormField For="r-decided-on" Label="@L["裁處日"]" Hint="@L["YYYY-MM-DD（必填，不得早於行為日）"]">
                        <input id="r-decided-on" name="Input.DecidedOn" type="date" class="ep-input" value="@Input.DecidedOn" required />
                    </FormField>
                    <FormField For="r-benefit" Label="@L["違法所得利益"]" Hint="@L["元，十進位數字（選填，第 18 條第 2 項）"]">
                        <input id="r-benefit" name="Input.GainedBenefit" class="ep-input" value="@Input.GainedBenefit" />
                    </FormField>
                </div>
                <details class="ep-tree-manual">
                    <summary class="ep-tree-manual-toggle">@L["進階：裁處與時效參數"]</summary>
                    <div class="ep-reasoning-grid">
                        <FormField For="r-conduct-ended" Label="@L["行為終了日"]" Hint="@L["YYYY-MM-DD（選填，起算裁處權時效）"]">
                            <input id="r-conduct-ended" name="Input.ConductEndedOn" type="date" class="ep-input" value="@Input.ConductEndedOn" />
                        </FormField>
                        <SelectField For="r-criminal" Label="@L["同時觸犯刑事法律（第 26 條第 1 項）"]"
                                     Options="TriStateOptions" @bind-Value="Input.CriminalOffense" />
                        <SelectField For="r-confiscated" Label="@L["法院已宣告沒收（第 26 條第 1 項但書）"]"
                                     Options="TriStateOptions" @bind-Value="Input.CourtConfiscated" />
                        <FormField For="r-payment" Label="@L["刑事命支付金額"]" Hint="@L["元，十進位數字（選填）"]">
                            <input id="r-payment" name="Input.CriminalPayment" class="ep-input" value="@Input.CriminalPayment" />
                        </FormField>
                        <FormField For="r-pollutant-code" Label="@L["污染物／計量項目"]" Hint="@L["如 cod、bod、sox"]">
                            <input id="r-pollutant-code" name="Input.PollutantCode" class="ep-input" value="@Input.PollutantCode" />
                        </FormField>
                        <FormField For="r-pollutant-value" Label="@L["實測值"]" Hint="@L["十進位數值（選填）"]">
                            <input id="r-pollutant-value" name="Input.PollutantValue" class="ep-input ep-tabular" value="@Input.PollutantValue" />
                        </FormField>
                        <FormField For="r-pollutant-unit" Label="@L["計量單位"]" Hint="@L["如 mg/L、ppm、mg/Nm3"]">
                            <input id="r-pollutant-unit" name="Input.PollutantUnit" class="ep-input" value="@Input.PollutantUnit" />
                        </FormField>
                        <FormField For="r-scoring-matrix" Label="@L["裁罰矩陣代碼"]" Hint="@L["如 water_effluent、air_stationary、construction_demerit"]">
                            <input id="r-scoring-matrix" name="Input.ScoringMatrixCode" class="ep-input" value="@Input.ScoringMatrixCode" />
                        </FormField>
                    </div>
                </details>
                <SubmitButton>@L["執行推論評估"]</SubmitButton>
            </PostForm>

            @if (_reasoningOutcome is { } result)
            {
                <div class="ep-reasoning-result">
                    <StatGrid Items="SummaryStats(result)" />
                    <div class="ep-tier-strip" role="region" aria-label="@L["行政罰法三階審查"]">
                        <div class="ep-tier-node is-active">
                            <span class="ep-tier-kicker">@L["第一階 · 構成要件該當性"]</span>
                            <strong class="ep-tier-value ep-tabular">@result.Verdicts.Count @L["項候選"]</strong>
                        </div>
                        <div class="ep-tier-node @(result.ThreeTierDefenses?.Any(d => d.Tier == "Tier2_Illegality") == true ? "is-cleared" : "is-active")">
                            <span class="ep-tier-kicker">@L["第二階 · 違法性（§§11–13）"]</span>
                            <strong class="ep-tier-value ep-tabular">@((result.ThreeTierDefenses ?? []).Count(d => d.Tier == "Tier2_Illegality")) @L["項阻卻違法"]</strong>
                        </div>
                        <div class="ep-tier-node @(result.ThreeTierDefenses?.Any(d => d.Tier == "Tier3_Culpability") == true ? "is-cleared" : "is-active")">
                            <span class="ep-tier-kicker">@L["第三階 · 有責性（§§7–9）"]</span>
                            <strong class="ep-tier-value ep-tabular">@((result.ThreeTierDefenses ?? []).Count(d => d.Tier == "Tier3_Culpability")) @L["項阻卻責任"]</strong>
                        </div>
                    </div>
                    @if (result.ScoringResults is { Count: > 0 })
                    {
                        <div class="ep-scoring-grid">
                            @foreach (var sc in result.ScoringResults)
                            {
                                <article class="ep-scoring-card">
                                    <header class="ep-scoring-header">
                                        <strong>@sc.LawTitle</strong>
                                        <code class="ep-mono">@sc.FormulaKind</code>
                                    </header>
                                    <p class="ep-hint">@sc.EquationSummary</p>
                                    <div class="ep-scoring-metrics ep-tabular">
                                        @if (sc.ClampedMin is not null || sc.ClampedMax is not null)
                                        {
                                            <span>@L["裁罰區間"]：NT$ @(sc.ClampedMin?.ToString("N0") ?? "?") ～ NT$ @(sc.ClampedMax?.ToString("N0") ?? "?")</span>
                                        }
                                        <span>@L["環境講習"]：@sc.LectureHoursMin ～ @sc.LectureHoursMax @L["小時"]</span>
                                        @if (sc.DemeritTotal is not null)
                                        {
                                            <span>@L["缺失記點"]：@sc.DemeritTotal @L["點"]（@(sc.DemeritTriggered == true ? L["已達 10 點門檻"] : L["未達 10 點"])）</span>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                    @if (result.Verdicts.Count == 0)
                    {
                        <p class="ep-page-description">@L["沒有已確認的規範陳述產生裁處結論；這不代表合規。"]</p>
                    }
                    else
                    {
                        <DataTable Items="result.Verdicts" Columns="VerdictColumns" Label="@L["候選結論"]" Plain="true" />
                    }
                </div>
            }
        </SectionCard>;

    private RenderFragment RenderTreeNode(PortalLawTreeNode node) => __builder =>
    {
        var key = NodeKey(node.Jurisdiction, node.IdScheme, node.LocalId);
        var active = string.Equals(Jurisdiction, node.Jurisdiction, StringComparison.Ordinal)
            && string.Equals(IdScheme, node.IdScheme, StringComparison.Ordinal)
            && string.Equals(LocalId, node.LocalId, StringComparison.Ordinal);
        var href = BuildNodeHref(node);
        var kindText = string.IsNullOrEmpty(node.DocumentType) ? NormKindLabel(node.NormKind) : node.DocumentType;

        if (node.Children.Count > 0)
        {
            <details class="ep-tree-group" open="@IsBranchOpen(key)">
                <summary class="ep-tree-summary">
                    <a class="ep-tree-link" href="@href" aria-current="@(active ? "page" : null)">
                        <span>@node.Title</span>
                        <span class="ep-tree-kind">@kindText</span>
                        @if (node.ChildCount > 0 || node.Children.Count > 0)
                        {
                            <span class="ep-tree-count">@(node.ChildCount > 0 ? node.ChildCount : node.Children.Count)</span>
                        }
                    </a>
                </summary>
                <ul class="ep-tree-children">
                    @foreach (var child in node.Children)
                    {
                        <li>@RenderTreeNode(child)</li>
                    }
                </ul>
            </details>
        }
        else
        {
            <div class="ep-tree-leaf">
                <a class="ep-tree-link" href="@href" aria-current="@(active ? "page" : null)">
                    <span>@node.Title</span>
                    <span class="ep-tree-kind">@kindText</span>
                    @if (node.ChildCount > 0)
                    {
                        <span class="ep-tree-count">@node.ChildCount</span>
                    }
                </a>
            </div>
        }
    };

    private RenderFragment RenderStructureNode(PortalStructureNode node, int depth) => __builder =>
    {
        <li class="ep-structure-item">
            <details open="@(depth <= 1)">
                <summary class="ep-structure-heading">@($"{node.HeadingNo} {node.Title}".Trim())</summary>
                @if (node.Articles.Count > 0)
                {
                    <div class="ep-structure-articles">
                        @foreach (var art in node.Articles)
                        {
                            <code class="ep-mono ep-article-chip">@art.Number</code>
                        }
                    </div>
                }
                @if (node.Children.Count > 0)
                {
                    <ul class="ep-structure-list">
                        @foreach (var child in node.Children)
                        {
                            @RenderStructureNode(child, depth + 1)
                        }
                    </ul>
                }
            </details>
        </li>
    };
}
