@page "/portal/{Tenant}/laws"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = PlatformAuth.PortalPolicy)]
@inherits PortalFormPageBase<NormativeReasoningForm>
@using System.Text.Json
@inject ITenantModules Modules
@inject ILawCorpusService LawCorpusService
@inject INormativeReasoningService ReasoningService

<DocumentTitle Text="@L["法規體系與合規"]" />

<PageHeader Title="@L["法規體系與合規"]" Description="@L["整合法律位階授權知識圖譜、編章節條文瀏覽與確定性規範推論評估。"]" />

@if (!HasCorpus && !HasReasoning)
{
    <FormAlert Kind="AlertKind.Info">@L["這個組織尚未開啟「法規沿革與條文瀏覽」模組。"]</FormAlert>
}
else
{
    <div class="ep-stack">
        <FormAlert Message="@Error" />

        <form method="get" class="ep-workbench-bar">
            @if (!string.IsNullOrWhiteSpace(LocalId))
            {
                <input type="hidden" name="jurisdiction" value="@EffectiveJurisdiction" />
                <input type="hidden" name="idScheme" value="@EffectiveScheme" />
                <input type="hidden" name="localId" value="@LocalId" />
            }
            <FormField For="wb-query" Label="@L["篩選法規"]" Hint="@L["輸入法規名稱或代碼"]">
                <input id="wb-query" name="q" class="ep-input" value="@Query" placeholder="@L["例如 空氣污染"]" />
            </FormField>
            <FormField For="law-as-of" Label="@L["基準日"]" Hint="@L["留空表示現行"]">
                <input id="law-as-of" name="asOf" type="date" class="ep-input" value="@AsOf" />
            </FormField>
            <SubmitButton>@L["套用條件"]</SubmitButton>
        </form>

        <div class="ep-workbench @(HasReasoning ? "has-inspector" : "")">
            @if (HasCorpus)
            {
                <SectionCard Id="law-tree-title" Title="@L["法律樹結構"]">
                    @if (_filteredRoots.Count > 0)
                    {
                        <nav class="ep-law-tree" aria-label="@L["法律樹結構"]">
                            @foreach (var root in _filteredRoots)
                            {
                                var isRootActive = IsSelected(root);
                                var hasActiveChild = root.Children.Any(IsSelected);
                                @if (root.Children.Count > 0)
                                {
                                    <details class="ep-tree-group" open="@(isRootActive || hasActiveChild || !string.IsNullOrWhiteSpace(Query))">
                                        <summary class="ep-tree-summary">
                                            <a class="ep-tree-link" href="@LawHref(root)" aria-current="@(isRootActive ? "page" : null)">
                                                <span>@root.Title</span>
                                                <span class="ep-tree-kind">@NormKindLabel(root.NormKind)</span>
                                            </a>
                                        </summary>
                                        <ul class="ep-tree-children">
                                            @foreach (var child in root.Children)
                                            {
                                                var isChildActive = IsSelected(child);
                                                <li class="ep-tree-leaf">
                                                    <a class="ep-tree-link" href="@LawHref(child)" aria-current="@(isChildActive ? "page" : null)">
                                                        <span>@child.Title</span>
                                                        <span class="ep-tree-kind">@NormKindLabel(child.NormKind)</span>
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </details>
                                }
                                else
                                {
                                    <div class="ep-tree-leaf">
                                        <a class="ep-tree-link" href="@LawHref(root)" aria-current="@(isRootActive ? "page" : null)">
                                            <span>@root.Title</span>
                                            <span class="ep-tree-kind">@NormKindLabel(root.NormKind)</span>
                                        </a>
                                    </div>
                                }
                            }
                        </nav>
                    }
                    else if (_tree is { CatalogAvailable: true })
                    {
                        <p class="ep-page-description">@L["指定日期沒有有效的法規版本。"]</p>
                    }

                    <details class="ep-tree-manual" open="@(_tree is null || !_tree.CatalogAvailable)">
                        <summary class="ep-tree-manual-toggle">@L["依自然鍵直接查詢"]</summary>
                        <form method="get" class="ep-form">
                            <FormField For="law-jurisdiction" Label="@L["管轄"]" Hint="@L["例如 TW-CENTRAL"]">
                                <input id="law-jurisdiction" name="jurisdiction" class="ep-input" value="@EffectiveJurisdiction" />
                            </FormField>
                            <FormField For="law-scheme" Label="@L["識別碼方案"]" Hint="@L["例如 moj_pcode"]">
                                <input id="law-scheme" name="idScheme" class="ep-input" value="@EffectiveScheme" />
                            </FormField>
                            <FormField For="law-local-id" Label="@L["法規代碼"]" Hint="@L["例如 O0020001"]">
                                <input id="law-local-id" name="localId" class="ep-input" value="@LocalId" />
                            </FormField>
                            <input type="hidden" name="asOf" value="@AsOf" />
                            <SubmitButton>@L["查詢法規"]</SubmitButton>
                        </form>
                    </details>
                </SectionCard>

                <div class="ep-workbench-main">
                    <SectionCard Id="ontology-graph-title" Title="@L["法律授權知識圖譜"]">
                        @if (_graphJson is { Length: > 0 } graphJson)
                        {
                            <details open>
                                <summary class="ep-tree-manual-toggle">@L["展開或收合互動圖譜"]</summary>
                                <div class="ep-graph-host" data-graph-host>
                                    <div class="ep-graph-toolbar">
                                        <span class="ep-page-description">@L["點選圖譜節點可直接檢視該法規條文與編章節結構。"]</span>
                                        <div>
                                            <button type="button" class="ep-preset-chip" data-graph-action="zoom-in">+</button>
                                            <button type="button" class="ep-preset-chip" data-graph-action="zoom-out">-</button>
                                            <button type="button" class="ep-preset-chip" data-graph-action="fit">@L["適應視窗"]</button>
                                        </div>
                                    </div>
                                    <div class="ep-graph-canvas" data-ontology-graph="@graphJson"></div>
                                </div>
                            </details>
                        }
                        else
                        {
                            <p class="ep-page-description">@L["請從左側「法律樹結構」點選法規，或輸入關鍵字篩選，以檢視局部授權關聯圖譜。"]</p>
                        }
                    </SectionCard>

                    @if (_result is { } law)
                    {
                        <SectionCard Id="law-detail-title" Title="@law.Title">
                            <dl class="ep-detail">
                                <dt>@L["自然鍵"]</dt><dd><code class="ep-mono">@EffectiveJurisdiction / @EffectiveScheme / @LocalId</code></dd>
                                <dt>@L["網址"]</dt><dd><code class="ep-mono">@law.Uri</code></dd>
                                <dt>@L["語言"]</dt><dd>@law.Language</dd>
                                @if (law.DateDocument is { Length: > 0 } docDate)
                                {
                                    <dt>@L["制定日："]</dt><dd>@docDate</dd>
                                }
                            </dl>
                            @if (law.Articles.Count == 0 && law.Structure.Count == 0)
                            {
                                <p class="ep-page-description">@L["這部法規在指定日期沒有條文。"]</p>
                            }
                            else if (law.Structure.Count > 0)
                            {
                                <div class="ep-tree" role="region" aria-label="@L["法規結構目錄"]">
                                    @foreach (var heading in law.Structure)
                                    {
                                        @RenderStructureNode(heading)
                                    }
                                </div>
                            }
                            else
                            {
                                <DataTable Items="law.Articles" Columns="ArticleColumns" Label="@L["條文清單"]" Plain="true" />
                            }
                        </SectionCard>
                    }
                    else if (string.IsNullOrWhiteSpace(LocalId))
                    {
                        <EmptyState Icon="@Icons.Material.Outlined.AccountTree" Title="@L["從左側法律樹選擇法規"]" Description="@L["展開母法查看授權命令與子法規，點選任一法規即可檢視有效條文清單。"]" />
                    }
                </div>
            }

            @if (HasReasoning)
            {
                <div class="ep-workbench-inspector">
                    <SectionCard Id="reasoning-inspector-title" Title="@L["合規推論試算"]">
                        <p class="ep-page-description">@L["選擇常見情境或輸入事實，由確定性推論引擎評估候選風險與缺漏要件。"]</p>
                        <div class="ep-preset-row">
                            <button type="button" class="ep-preset-chip" data-reasoning-preset="daily">@L["日常合規自評"]</button>
                            <button type="button" class="ep-preset-chip" data-reasoning-preset="incident">@L["設備異常通報"]</button>
                            <button type="button" class="ep-preset-chip" data-reasoning-preset="benefit">@L["超標與不法利得"]</button>
                        </div>

                        <PostForm Model="Input" FormName="portal-reasoning" OnValidSubmit="EvaluateAsync">
                            <div data-reasoning-form>
                                <FormField For="r-conduct-on" Label="@L["行為日"]" Hint="@L["YYYY-MM-DD（必填）"]">
                                    <input id="r-conduct-on" name="Input.ConductOn" type="date" class="ep-input" value="@Input.ConductOn" required />
                                </FormField>
                                <FormField For="r-decided-on" Label="@L["裁處日"]" Hint="@L["YYYY-MM-DD（必填，不得早於行為日）"]">
                                    <input id="r-decided-on" name="Input.DecidedOn" type="date" class="ep-input" value="@Input.DecidedOn" required />
                                </FormField>
                                <FormField For="r-benefit" Label="@L["違法所得利益"]" Hint="@L["元，十進位數字（選填，第 18 條第 2 項）"]">
                                    <input id="r-benefit" name="Input.GainedBenefit" class="ep-input" value="@Input.GainedBenefit" />
                                </FormField>

                                <details class="ep-tree-manual">
                                    <summary class="ep-tree-manual-toggle">@L["進階：裁處與時效參數"]</summary>
                                    <FormField For="r-conduct-ended" Label="@L["行為終了日"]" Hint="@L["YYYY-MM-DD（選填，起算裁處權時效）"]">
                                        <input id="r-conduct-ended" name="Input.ConductEndedOn" type="date" class="ep-input" value="@Input.ConductEndedOn" />
                                    </FormField>
                                    <SelectField For="r-criminal" Label="@L["同時觸犯刑事法律（第 26 條第 1 項）"]"
                                                 Options="TriStateOptions" @bind-Value="Input.CriminalOffense" />
                                    <SelectField For="r-confiscated" Label="@L["法院已宣告沒收（第 26 條第 1 項但書）"]"
                                                 Options="TriStateOptions" @bind-Value="Input.CourtConfiscated" />
                                    <FormField For="r-payment" Label="@L["刑事命支付金額"]" Hint="@L["元，十進位數字（選填）"]">
                                        <input id="r-payment" name="Input.CriminalPayment" class="ep-input" value="@Input.CriminalPayment" />
                                    </FormField>
                                </details>

                                <SubmitButton>@L["執行推論評估"]</SubmitButton>
                            </div>
                        </PostForm>
                    </SectionCard>

                    @if (_outcome is { } result)
                    {
                        <SectionCard Id="reasoning-result-title" Title="@L["推論候選結果"]">
                            <StatGrid Items="SummaryStats(result)" />
                            @if (result.Verdicts.Count == 0)
                            {
                                <p class="ep-page-description">@L["沒有已確認的規範陳述產生裁處結論；這不代表合規。"]</p>
                            }
                            else
                            {
                                <DataTable Items="OrderedVerdicts(result)" Columns="VerdictColumns" Label="@L["候選結論"]" Plain="true" />
                            }
                        </SectionCard>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "jurisdiction")] public string? Jurisdiction { get; set; }
    [SupplyParameterFromQuery(Name = "idScheme")] public string? IdScheme { get; set; }
    [SupplyParameterFromQuery(Name = "localId")] public string? LocalId { get; set; }
    [SupplyParameterFromQuery(Name = "asOf")] public string? AsOf { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    private PortalLawTreeResult? _tree;
    private IReadOnlyList<PortalLawTreeNode> _filteredRoots = [];
    private string? _graphJson;
    private PortalLawCorpusResult? _result;
    private PortalReasoningOutcome? _outcome;

    private bool HasCorpus => Modules.IsEnabled(Tenant, ModuleKeys.LawCorpus);
    private bool HasReasoning => Modules.IsEnabled(Tenant, ModuleKeys.NormativeReasoning);

    private string EffectiveJurisdiction => string.IsNullOrWhiteSpace(Jurisdiction) ? "TW-CENTRAL" : Jurisdiction.Trim();
    private string EffectiveScheme => string.IsNullOrWhiteSpace(IdScheme) ? "moj_pcode" : IdScheme.Trim();

    private IReadOnlyList<ColumnDef<PortalLawArticle>> ArticleColumns =>
    [
        new() { Title = L["條號"], Class = "ep-keep", Labeled = false, Cell = a => @<text>@a.Number</text> },
        new() { Title = "URI", Cell = a => @<text><code class="ep-mono">@a.Uri</code></text> },
    ];

    private IReadOnlyList<SelectOption> TriStateOptions =>
    [
        new(string.Empty, L["未知（省略）"]),
        new("true", L["是"]),
        new("false", L["否"]),
    ];

    private IReadOnlyList<ColumnDef<PortalReasoningVerdict>> VerdictColumns =>
    [
        new() { Title = L["法規"], Class = "ep-keep", Labeled = false, Cell = v => @<text>@v.LawTitle</text> },
        new() { Title = L["候選判定"], Cell = v => @<text><StatusBadge Tone="@VerdictTone(v.Verdict)">@VerdictLabel(v.Verdict)</StatusBadge></text> },
        new() { Title = L["缺漏事實數"], Cell = v => @<text>@v.MissingCount</text> },
    ];

    private IReadOnlyList<StatItem> SummaryStats(PortalReasoningOutcome r) =>
    [
        new(L["裁處時結論"], r.Verdicts.Count.ToString()),
        new(L["期間法律變更組"], r.EarlierCount.ToString()),
        new(L["違憲失效排除"], r.InvalidatedCount.ToString()),
        new(L["授權鏈缺口"], r.DelegationGapCount.ToString()),
        new(L["語料未涵蓋法規"], r.UncoveredLawCount.ToString()),
    ];

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();
        var defaultDate = !string.IsNullOrWhiteSpace(AsOf)
            ? AsOf.Trim()
            : DateOnly.FromDateTime(DateTime.UtcNow.AddHours(8)).ToString("yyyy-MM-dd");
        if (string.IsNullOrEmpty(Input.ConductOn))
            Input.ConductOn = defaultDate;
        if (string.IsNullOrEmpty(Input.DecidedOn))
            Input.DecidedOn = defaultDate;

        if (!HasCorpus)
            return;

        var asOf = string.IsNullOrWhiteSpace(AsOf) ? null : AsOf.Trim();
        var treeOutcome = await LawCorpusService.TreeAsync(User, null, asOf, CancellationToken.None);
        if (treeOutcome is { IsOk: true, Value: { } tree })
        {
            _tree = tree;
            _filteredRoots = FilterTree(tree.Roots, Query);
            _graphJson = BuildGraphJson(_filteredRoots);
        }

        if (string.IsNullOrWhiteSpace(LocalId))
            return;

        var outcome = await LawCorpusService.BrowseAsync(
            User,
            EffectiveJurisdiction,
            EffectiveScheme,
            LocalId.Trim(),
            asOf,
            CancellationToken.None);

        if (!outcome.IsOk)
        {
            Error = outcome.Localized() ?? L["查詢法規失敗。"];
            return;
        }

        _result = outcome.Value;
    }

    private async Task EvaluateAsync()
    {
        if (!HasReasoning)
            return;

        var evaluated = await ReasoningService.EvaluateAsync(
            User,
            new PortalReasoningInput(
                Input.ConductOn,
                Input.DecidedOn,
                Input.ConductEndedOn,
                ParseTriState(Input.CriminalOffense),
                ParseTriState(Input.CourtConfiscated),
                Input.CriminalPayment,
                Input.GainedBenefit),
            CancellationToken.None);

        if (!evaluated.IsOk)
        {
            Error = evaluated.Localized() ?? L["推論評估失敗，請稍後再試。"];
            return;
        }

        _outcome = evaluated.Value;
    }

    private static IReadOnlyList<PortalLawTreeNode> FilterTree(IReadOnlyList<PortalLawTreeNode> roots, string? query)
    {
        if (string.IsNullOrWhiteSpace(query))
            return roots;
        var q = query.Trim();
        bool Matches(PortalLawTreeNode n) =>
            n.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
            || n.LocalId.Contains(q, StringComparison.OrdinalIgnoreCase);

        var filtered = new List<PortalLawTreeNode>();
        foreach (var root in roots)
        {
            var kids = root.Children.Where(Matches).ToList();
            if (Matches(root) || kids.Count > 0)
                filtered.Add(root with { Children = kids.Count > 0 ? kids : root.Children });
        }
        return filtered;
    }

    private string? BuildGraphJson(IReadOnlyList<PortalLawTreeNode> roots)
    {
        if (roots.Count == 0)
            return null;

        const int maxEgoNodes = 30;
        const int maxFilteredNodes = 35;

        IReadOnlyList<PortalLawTreeNode> targetRoots;
        if (!string.IsNullOrWhiteSpace(LocalId))
        {
            var matchedRoot = FindContainingRoot(roots);
            if (matchedRoot is null)
                return null;
            targetRoots = [TrimEgoSubtree(matchedRoot, maxEgoNodes)];
        }
        else if (!string.IsNullOrWhiteSpace(Query))
        {
            if (CountNodes(roots) > maxFilteredNodes)
                return null;
            targetRoots = roots;
        }
        else
        {
            return null;
        }

        var nodes = new List<object>();
        var edges = new List<object>();
        var seen = new HashSet<string>(StringComparer.Ordinal);

        void Visit(PortalLawTreeNode node, string? parentId)
        {
            var id = $"{node.Jurisdiction}:{node.IdScheme}:{node.LocalId}";
            if (seen.Add(id))
            {
                nodes.Add(new
                {
                    id,
                    label = node.Title,
                    kind = node.NormKind,
                    href = LawHref(node),
                    active = IsSelected(node),
                });
            }
            if (parentId is not null)
                edges.Add(new { source = parentId, target = id });
            foreach (var child in node.Children)
                Visit(child, id);
        }

        foreach (var root in targetRoots)
            Visit(root, null);

        return JsonSerializer.Serialize(new { nodes, edges });
    }

    private PortalLawTreeNode? FindContainingRoot(IReadOnlyList<PortalLawTreeNode> roots)
    {
        foreach (var root in roots)
        {
            if (ContainsSelected(root))
                return root;
        }
        return null;
    }

    private bool ContainsSelected(PortalLawTreeNode node) =>
        IsSelected(node) || node.Children.Any(ContainsSelected);

    private PortalLawTreeNode TrimEgoSubtree(PortalLawTreeNode root, int maxNodes)
    {
        if (root.Children.Count <= maxNodes - 1)
            return root;

        var kept = root.Children
            .OrderByDescending(ContainsSelected)
            .Take(maxNodes - 1)
            .ToList();
        return root with { Children = kept };
    }

    private static int CountNodes(IReadOnlyList<PortalLawTreeNode> roots)
    {
        var count = 0;
        foreach (var root in roots)
            count += 1 + CountNodes(root.Children);
        return count;
    }

    private static IReadOnlyList<PortalReasoningVerdict> OrderedVerdicts(PortalReasoningOutcome result) =>
        [.. result.Verdicts.OrderBy(v => v.Verdict switch
        {
            "Violation" => 0,
            "ConditionalViolation" => 1,
            "Undetermined" => 2,
            "ConditionalCompliant" => 3,
            "Compliant" => 4,
            _ => 5,
        })];

    private bool IsSelected(PortalLawTreeNode node) =>
        !string.IsNullOrWhiteSpace(LocalId)
        && string.Equals(node.Jurisdiction, EffectiveJurisdiction, StringComparison.Ordinal)
        && string.Equals(node.IdScheme, EffectiveScheme, StringComparison.Ordinal)
        && string.Equals(node.LocalId, LocalId.Trim(), StringComparison.Ordinal);

    private string LawHref(PortalLawTreeNode node)
    {
        var baseUrl = $"{PortalPaths.Home(Tenant)}/laws?jurisdiction={Uri.EscapeDataString(node.Jurisdiction)}&idScheme={Uri.EscapeDataString(node.IdScheme)}&localId={Uri.EscapeDataString(node.LocalId)}";
        if (!string.IsNullOrWhiteSpace(AsOf))
            baseUrl = $"{baseUrl}&asOf={Uri.EscapeDataString(AsOf.Trim())}";
        if (!string.IsNullOrWhiteSpace(Query))
            baseUrl = $"{baseUrl}&q={Uri.EscapeDataString(Query.Trim())}";
        return baseUrl;
    }

    private string NormKindLabel(string normKind) => normKind switch
    {
        "constitution" => L["憲法"],
        "statute" or "law" => L["法律"],
        "local_ordinance" => L["自治條例"],
        "local_regulation" => L["自治規則"],
        "administrative_rule" => L["行政規則"],
        "regulation" or "order" => L["命令"],
        _ => normKind,
    };

    private string VerdictLabel(string verdict) => verdict switch
    {
        "Violation" => L["違反"],
        "ConditionalViolation" => L["附條件違反"],
        "Compliant" => L["合規"],
        "ConditionalCompliant" => L["附條件合規"],
        "Undetermined" => L["事實不足"],
        "Excluded" => L["排除"],
        "NotApplicable" => L["不適用"],
        _ => verdict,
    };

    private static string VerdictTone(string verdict) => verdict switch
    {
        "Violation" or "ConditionalViolation" => "danger",
        "Compliant" or "ConditionalCompliant" => "ok",
        "Undetermined" => "warn",
        _ => "neutral",
    };

    private static bool? ParseTriState(string? value) => value switch
    {
        "true" => true,
        "false" => false,
        _ => null,
    };

    private RenderFragment RenderStructureNode(PortalStructureNode node) => @<details class="ep-tree-branch" open>
        <summary class="ep-tree-summary">
            <span class="ep-tree-badge">@node.HeadingNo</span>
            @if (!string.IsNullOrWhiteSpace(node.Title))
            {
                <span class="ep-tree-title">@node.Title</span>
            }
        </summary>
        <div class="ep-tree-children">
            @if (node.Articles.Count > 0)
            {
                <DataTable Items="node.Articles" Columns="ArticleColumns" Label="@node.HeadingNo" Plain="true" />
            }
            @foreach (var child in node.Children)
            {
                @RenderStructureNode(child)
            }
        </div>
    </details>;
}
