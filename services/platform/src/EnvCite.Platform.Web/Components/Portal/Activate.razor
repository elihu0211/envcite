@page "/portal/{Tenant}/activate"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(PlatformAuth.PortalSignInRateLimit)]
@attribute [AllowAnonymous]
@inherits PortalPageBase<IPortalAccount>

<DocumentTitle Text="@L["啟用帳號"]" />

@if (Service.CurrentTenant is { } tenant)
{
    <ActivationFlow Account="Service" FormName="portal-activate" LoginPath="@PortalPaths.Login(tenant.Identifier)">
        <Layout Context="view">
            <section class="ep-login" aria-labelledby="activate-title">
                <header>
                    <h1 id="activate-title" class="ep-display">@view.Heading</h1>
                    <p class="ep-login-tenant">@(tenant.Name ?? tenant.Identifier)</p>
                </header>
                <div>@view.Body</div>
            </section>
        </Layout>
    </ActivationFlow>
}

@code {
    protected override void OnInitialized()
    {
        // 路徑上的租戶不存在：這個頁面就不存在。
        if (Service.CurrentTenant is null)
        {
            Navigation.NotFound();
        }
    }
}
