@page "/portal/{Tenant}/reasoning"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = PlatformAuth.PortalPolicy)]
@inherits PortalFormPageBase<NormativeReasoningForm>
@inject ITenantModules Modules
@inject INormativeReasoningService ReasoningService

<DocumentTitle Text="@L["規範推論評估"]" />

<PageHeader Title="@L["規範推論評估"]" Description="@L["依行為日與裁處日有效之已驗證陳述，對案件事實進行確定性涵攝推論（僅供候選參考，系統不裁量）。"]" />

@if (!Modules.IsEnabled(Tenant, ModuleKeys.NormativeReasoning))
{
    <FormAlert Kind="AlertKind.Info">@L["這個組織尚未開啟「規範推論評估」模組。"]</FormAlert>
}
else
{
    <SectionCard Id="reasoning-form-title" Title="@L["案件事實與時點"]">
        <FormAlert Kind="AlertKind.Info">@L["案件事實透過加密表單送出，不會寫入網址或日誌。未填欄位視為「未知」，不會當作「否」或 0。"]</FormAlert>
        <FormAlert Message="@Error" />
        <PostForm Model="Input" FormName="portal-reasoning" OnValidSubmit="EvaluateAsync">
            <FormField For="r-conduct-on" Label="@L["行為日"]" Hint="@L["YYYY-MM-DD（必填）"]">
                <input id="r-conduct-on" name="Input.ConductOn" type="date" class="ep-input" value="@Input.ConductOn" required />
            </FormField>
            <FormField For="r-decided-on" Label="@L["裁處日"]" Hint="@L["YYYY-MM-DD（必填，不得早於行為日）"]">
                <input id="r-decided-on" name="Input.DecidedOn" type="date" class="ep-input" value="@Input.DecidedOn" required />
            </FormField>
            <FormField For="r-conduct-ended" Label="@L["行為終了日"]" Hint="@L["YYYY-MM-DD（選填，起算裁處權時效）"]">
                <input id="r-conduct-ended" name="Input.ConductEndedOn" type="date" class="ep-input" value="@Input.ConductEndedOn" />
            </FormField>
            <SelectField For="r-criminal" Label="@L["同時觸犯刑事法律（第 26 條第 1 項）"]"
                         Options="TriStateOptions" @bind-Value="Input.CriminalOffense" />
            <SelectField For="r-confiscated" Label="@L["法院已宣告沒收（第 26 條第 1 項但書）"]"
                         Options="TriStateOptions" @bind-Value="Input.CourtConfiscated" />
            <FormField For="r-payment" Label="@L["刑事命支付金額"]" Hint="@L["元，十進位數字（選填）"]">
                <input id="r-payment" name="Input.CriminalPayment" class="ep-input" value="@Input.CriminalPayment" />
            </FormField>
            <FormField For="r-benefit" Label="@L["違法所得利益"]" Hint="@L["元，十進位數字（選填，第 18 條第 2 項）"]">
                <input id="r-benefit" name="Input.GainedBenefit" class="ep-input" value="@Input.GainedBenefit" />
            </FormField>
            <SubmitButton Label="@L["執行推論評估"]" />
        </PostForm>
    </SectionCard>

    @if (_outcome is { } result)
    {
        <SectionCard Id="reasoning-result-title" Title="@L["推論候選結果"]">
            <StatGrid Items="SummaryStats(result)" />
            @if (result.Verdicts.Count == 0)
            {
                <p class="ep-page-description">@L["沒有已確認的規範陳述產生裁處結論；這不代表合規。"]</p>
            }
            else
            {
                <DataTable Items="result.Verdicts" Columns="VerdictColumns" Label="@L["候選結論"]" Plain="true" />
            }
        </SectionCard>
    }
}

@code {
    private PortalReasoningOutcome? _outcome;

    private IReadOnlyList<SelectOption> TriStateOptions =>
    [
        new(string.Empty, L["未知（省略）"]),
        new("true", L["是"]),
        new("false", L["否"]),
    ];

    private IReadOnlyList<ColumnDef<PortalReasoningVerdict>> VerdictColumns =>
    [
        new() { Title = L["法規"], Class = "ep-keep", Labeled = false, Cell = v => @<text>@v.LawTitle</text> },
        new() { Title = L["陳述"], Cell = v => @<text><code class="ep-mono">@v.StatementId</code></text> },
        new() { Title = L["候選判定"], Cell = v => @<text>@v.Verdict</text> },
        new() { Title = L["缺漏事實數"], Cell = v => @<text>@v.MissingCount</text> },
    ];

    private IReadOnlyList<StatItem> SummaryStats(PortalReasoningOutcome r) =>
    [
        new(L["裁處時結論"], r.Verdicts.Count.ToString()),
        new(L["期間法律變更組"], r.EarlierCount.ToString()),
        new(L["違憲失效排除"], r.InvalidatedCount.ToString()),
        new(L["授權鏈缺口"], r.DelegationGapCount.ToString()),
        new(L["語料未涵蓋法規"], r.UncoveredLawCount.ToString()),
    ];

    protected override void OnInitialized()
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(8)).ToString("yyyy-MM-dd");
        if (string.IsNullOrEmpty(Input.ConductOn))
            Input.ConductOn = today;
        if (string.IsNullOrEmpty(Input.DecidedOn))
            Input.DecidedOn = today;
    }

    private async Task EvaluateAsync()
    {
        if (!Modules.IsEnabled(Tenant, ModuleKeys.NormativeReasoning))
            return;

        var evaluated = await ReasoningService.EvaluateAsync(
            User,
            new PortalReasoningInput(
                Input.ConductOn,
                Input.DecidedOn,
                Input.ConductEndedOn,
                ParseTriState(Input.CriminalOffense),
                ParseTriState(Input.CourtConfiscated),
                Input.CriminalPayment,
                Input.GainedBenefit),
            CancellationToken.None);

        if (!evaluated.IsOk)
        {
            Error = evaluated.Localized() ?? L["推論評估失敗，請稍後再試。"];
            return;
        }

        _outcome = evaluated.Value;
    }

    private static bool? ParseTriState(string? value) => value switch
    {
        "true" => true,
        "false" => false,
        _ => null,
    };
}
