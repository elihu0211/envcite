@page "/portal/{Tenant}/history"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = PlatformAuth.PortalPolicy)]
@inject IConversationHistory Store
@inherits PortalFormPageBase<DeleteForm>

<DocumentTitle Text="@L["對話紀錄"]" />

<PageHeader Title="@L["對話紀錄"]" Description="@L["只有你看得到。"]" />

@if (!Store.Enabled)
{
    <FormAlert Kind="AlertKind.Info">@L["這個環境沒有開啟對話紀錄。"]</FormAlert>
}
else
{
    <p class="ep-hint">@L["超過 {0} 天沒有更新的對話會自動刪除。", Store.RetentionDays]</p>

    @if (_message is not null)
    {
        <FormAlert Kind="AlertKind.Info">@_message</FormAlert>
    }

    @if (_items.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Forum" Title="@L["還沒有對話"]" Description="@L["在首頁問一個問題，它就會出現在這裡。"]">
            <a class="ep-btn ep-btn-primary" href="@PortalPaths.Home(Tenant)">@L["查詢"]</a>
        </EmptyState>
    }
    else
    {
        <PostForm Model="Input" FormName="portal-history-delete" OnValidSubmit="DeleteAsync" Class="@null">
            <ul class="ep-history" aria-label="@L["對話"]">
                @foreach (var item in _items)
                {
                    <li class="ep-card ep-history-item">
                        <a class="ep-history-link" href="@($"{PortalPaths.Home(Tenant)}/history/{item.Id}")">
                            <span class="ep-history-title">@item.Title</span>
                            <time class="ep-secondary" datetime="@TaipeiTime.Full(item.UpdatedAt)">@TaipeiTime.Format(item.UpdatedAt)</time>
                        </a>
                        <button type="submit" name="Input.Delete" value="@item.Id" formnovalidate class="ep-btn ep-btn-quiet"
                                aria-label="@L["刪除對話：{0}", item.Title]">@L["刪除"]</button>
                    </li>
                }
            </ul>
        </PostForm>
    }
}
