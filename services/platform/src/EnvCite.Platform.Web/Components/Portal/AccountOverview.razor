@page "/portal/{Tenant}/account"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = PlatformAuth.PortalPolicy)]
@inherits PortalPageBase
@inject ITenantModules Modules

<DocumentTitle Text="@L["帳號與組織"]" />

<PageHeader Title="@L["帳號與組織"]" Description="@L["組織方案、個人身分與已啟用模組。"]" />

<div class="ep-stack">
    <SectionCard Id="org-title" Title="@L["你的組織與帳號"]">
        <dl class="ep-detail">
            <dt>@L["組織"]</dt><dd>@(_tenant?.Name ?? Tenant)（<code class="ep-mono">@Tenant</code>）</dd>
            <dt>@L["方案"]</dt>
            <dd>
                @if (_tenant?.Plan is { } plan)
                {
                    <strong>@plan</strong>
                }
                else
                {
                    <span>@L["目前沒有方案：資料端點會回 402。請洽我們的業務啟用。"]</span>
                }
            </dd>
            @if (GivenName is not null)
            {
                <dt>@L["名稱"]</dt><dd>@GivenName</dd>
            }
            <dt>@L["電子郵件"]</dt><dd>@Email</dd>
            <dt>@L["角色"]</dt><dd>@RoleLabel</dd>
            <dt>@L["兩步驟驗證"]</dt>
            <dd>
                @if (_twoFactor)
                {
                    <StatusBadge Tone="success">@L["已啟用"]</StatusBadge>
                }
                else
                {
                    <StatusBadge Tone="warning">@L["尚未啟用"]</StatusBadge> <a href="@($"{PortalPaths.Home(Tenant)}/security")">@L["設定"]</a>
                }
            </dd>
            <dt>@L["密碼"]</dt><dd><a href="@PortalPaths.Password(Tenant)">@L["改密碼"]</a></dd>
        </dl>
    </SectionCard>

    <SectionCard Id="modules-title" Title="@L["已啟用功能模組"]">
        <dl class="ep-detail">
            @foreach (var module in ModuleCatalog.All)
            {
                var enabled = Modules.IsEnabled(Tenant, module.Key);
                <dt>@ModuleName(module.Key)</dt>
                <dd>
                    @if (enabled)
                    {
                        <StatusBadge Tone="success">@L["已啟用"]</StatusBadge>
                        @if (ModuleHref(module.Key) is { } href)
                        {
                            <span> </span><a href="@href">@L["前往使用"]</a>
                        }
                    }
                    else
                    {
                        <StatusBadge Tone="neutral">@L["未啟用"]</StatusBadge>
                    }
                </dd>
            }
        </dl>
    </SectionCard>

    <SectionCard Id="keys-title" Title="API keys">
        @if (!CanSeeKeys)
        {
            <p class="ep-page-description">@L["你的角色不能查看 API key。"]</p>
        }
        else if (_keys.Count == 0)
        {
            <p class="ep-page-description">@L["還沒有 API key。請洽我們的營運人員簽發。"]</p>
        }
        else
        {
            <DataTable Items="_keys" Columns="KeyColumns" Label="API keys" Plain="true" />
            <p class="ep-hint">@L["完整的 key 只在簽發當下出現一次，這裡只顯示前綴。"]</p>
        }
    </SectionCard>
</div>

@code {
    private IReadOnlyList<ColumnDef<ApiKeyInfo>> KeyColumns =>
    [
        new() { Title = L["名稱"], Labeled = false, Cell = key => @<text>@key.Name</text> },
        new() { Title = L["前綴"], Cell = key => @<text><code class="ep-mono">@key.Prefix</code></text> },
        new()
        {
            Title = L["建立（台北）"], Label = L["建立"],
            Cell = key => @<text><time datetime="@TaipeiTime.Full(key.CreatedAt)">@TaipeiTime.Format(key.CreatedAt)</time></text>,
        },
        new() { Title = L["狀態"], Cell = key => @<text><StatusBadge Tone="@StatusTone(key)">@Status(key)</StatusBadge></text> },
    ];

    private string ModuleName(string key) => key switch
    {
        ModuleKeys.LawSearch => L["法規條文檢索"],
        ModuleKeys.LawCorpus => L["法規沿革與條文瀏覽"],
        ModuleKeys.EvidenceGrounding => L["法源接地"],
        ModuleKeys.GroundedAnswer => L["AI 法源問答"],
        ModuleKeys.NormativeReasoning => L["規範推論評估"],
        _ => key,
    };

    private string? ModuleHref(string key) => key switch
    {
        ModuleKeys.LawSearch or ModuleKeys.EvidenceGrounding or ModuleKeys.GroundedAnswer => PortalPaths.Home(Tenant),
        ModuleKeys.LawCorpus => $"{PortalPaths.Home(Tenant)}/laws",
        ModuleKeys.NormativeReasoning => $"{PortalPaths.Home(Tenant)}/reasoning",
        _ => null,
    };
}
