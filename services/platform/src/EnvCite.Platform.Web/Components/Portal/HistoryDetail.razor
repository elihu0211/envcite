@page "/portal/{Tenant}/history/{Id:guid}"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = PlatformAuth.PortalPolicy)]
@inherits PortalPageBase

<DocumentTitle Text="@L["對話"]" />

@if (_conversation is null)
{
    @* 不是自己的、已刪除、已過期、沒開啟：都是同一個畫面，不洩漏它存不存在。 *@
    <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="@L["找不到這個對話"]" Description="@L["它可能已經被刪除，或已超過保留期限。"]">
        <a class="ep-btn ep-btn-primary" href="@($"{PortalPaths.Home(Tenant)}/history")">@L["回到對話紀錄"]</a>
    </EmptyState>
}
else
{
    <PageHeader Title="@_conversation.Title" Description="@L["最後更新 {0}", TaipeiTime.Format(_conversation.UpdatedAt)]" />

    <div class="ep-thread">
        @foreach (var message in _conversation.Messages)
        {
            @if (message.Role == "user")
            {
                <p class="ep-bubble">@message.Content</p>
            }
            else
            {
                <div class="ep-answer">
                    @foreach (var line in message.Content.Split('\n'))
                    {
                        <p class="ep-hint">@line</p>
                    }
                </div>
            }
        }
    </div>

    <p><a class="ep-btn ep-btn-quiet" href="@($"{PortalPaths.Home(Tenant)}/history")">@L["回到對話紀錄"]</a></p>
}
