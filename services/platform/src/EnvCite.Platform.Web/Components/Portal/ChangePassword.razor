@page "/portal/{Tenant}/password"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(PlatformAuth.PortalSignInRateLimit)]
@attribute [Authorize(Policy = PlatformAuth.PortalSessionPolicy)]
@inherits PortalPageBase<IPortalAccount>

<DocumentTitle Text="@L["改密碼"]" />

<section class="ep-portal-card" aria-labelledby="password-title">
    <PageHeading Id="password-title">@L["改密碼"]</PageHeading>
    <ChangePasswordFlow Account="Service" FormName="portal-password" HomePath="@PortalPaths.Home(Tenant)"
                        PendingText="@L["這是營運人員給你的初始密碼，其他人可能看過。請先設定只有你知道的新密碼，才能使用入口。"]" />
</section>
