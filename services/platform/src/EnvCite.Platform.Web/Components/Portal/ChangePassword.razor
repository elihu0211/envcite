@page "/portal/{Tenant}/password"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(PlatformAuth.PortalSignInRateLimit)]
@attribute [Authorize(Policy = PlatformAuth.PortalSessionPolicy)]

<PageTitle>@L["改密碼 · {0}", Brand.Name]</PageTitle>

<section class="ep-portal-card" aria-labelledby="password-title">
    <h1 id="password-title" class="ep-page-title">@L["改密碼"]</h1>
    @if (Pending)
    {
        <p class="ep-alert ep-alert-info" role="status">
            @L["這是營運人員給你的初始密碼，其他人可能看過。請先設定只有你知道的新密碼，才能使用入口。"]
        </p>
    }
    else
    {
        <p class="ep-page-description">@L["改完後，其他裝置上的登入會失效。"]</p>
    }

    @if (_error is not null)
    {
        <p class="ep-alert ep-alert-error" role="alert">@_error</p>
    }

    <EditForm Model="Input" FormName="portal-password" OnValidSubmit="ChangeAsync" method="post" class="ep-form">
        <div class="ep-field-row">
            <label for="current" class="ep-label">@L["目前的密碼"]</label>
            <PasswordField Id="current" @bind-Value="Input.Current" AutoFocus="true" />
        </div>
        <NewPasswordField Id="new" Label="@L["新密碼"]" @bind-Value="Input.New" />
        <div class="ep-field-row">
            <label for="confirm" class="ep-label">@L["再輸入一次新密碼"]</label>
            <PasswordField Id="confirm" @bind-Value="Input.Confirm" Autocomplete="new-password" />
        </div>
        <button type="submit" class="ep-btn ep-btn-primary">@L["改密碼"]</button>
    </EditForm>
</section>
