@page "/portal/{Tenant}/password"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(PlatformAuth.PortalSignInRateLimit)]
@attribute [Authorize(Policy = PlatformAuth.PortalSessionPolicy)]

<PageTitle>改密碼 · 環境知識</PageTitle>

<section class="ep-card ep-portal-card" aria-labelledby="password-title">
    <h1 id="password-title" class="ep-page-title">改密碼</h1>
    @if (Pending)
    {
        <p class="ep-alert ep-alert-info" role="status">
            這是營運人員給你的初始密碼，其他人可能看過。請先設定只有你知道的新密碼，才能使用入口。
        </p>
    }
    else
    {
        <p class="ep-page-description">改完後，其他裝置上的登入會失效。</p>
    }

    @if (_error is not null)
    {
        <p class="ep-alert ep-alert-error" role="alert">@_error</p>
    }

    <EditForm Model="Input" FormName="portal-password" OnValidSubmit="ChangeAsync" method="post" class="ep-form">
        <div class="ep-field-row">
            <label for="current" class="ep-label">目前的密碼</label>
            <InputText id="current" @bind-Value="Input.Current" type="password" class="ep-input" autocomplete="current-password" required autofocus />
        </div>
        <div class="ep-field-row">
            <label for="new" class="ep-label">新密碼</label>
            <InputText id="new" @bind-Value="Input.New" type="password" class="ep-input" autocomplete="new-password" required minlength="12" aria-describedby="new-hint" />
            <p id="new-hint" class="ep-hint">至少 12 個字元。長度比符號重要：幾個不相干的詞連起來就很好。</p>
        </div>
        <div class="ep-field-row">
            <label for="confirm" class="ep-label">再輸入一次新密碼</label>
            <InputText id="confirm" @bind-Value="Input.Confirm" type="password" class="ep-input" autocomplete="new-password" required />
        </div>
        <button type="submit" class="ep-btn ep-btn-primary">改密碼</button>
    </EditForm>
</section>
