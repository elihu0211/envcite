@using Microsoft.JSInterop
@page "/portal/{Tenant}"
@page "/portal/{Tenant}/c/{Id:guid}"
@layout WorkspaceLayout
@attribute [Authorize(Policy = PlatformAuth.PortalPolicy)]
@implements IAsyncDisposable
@inherits WorkspacePageBase

<DocumentTitle Text="@L["法規諮詢"]" />

@* 問答為主的工作區（Interactive Server）：一串對話，每個回合是「你的問題 → 回答與出處」，輸入框黏在底部接著問，
   側欄列出最近的對話。有設定模型端點、租戶也同意時，回答是模型只根據 consult 的封閉證據寫的、每個論點附出處代號，
   加上對應的條文卡片；沒有就只列有出處的條文。互動頁面需要 JavaScript（連線），沒有它時只留這則說明。 *@
<noscript>
    <FormAlert Kind="AlertKind.Info">@L["這個頁面需要 JavaScript 才能使用。"]</FormAlert>
</noscript>

<div class="ep-ask" data-state="@(Session.Turns.Count > 0 ? "result" : "empty")">
    @if (_notFound)
    {
        @* 不是自己的、已刪除、已過期、沒開啟：都是同一個畫面，不洩漏它存不存在。 *@
        <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="@L["找不到這個對話"]" Description="@L["它可能已經被刪除，或已超過保留期限。"]">
            <a class="ep-btn ep-btn-primary" href="@PortalPaths.Home(Tenant)">@L["新對話"]</a>
        </EmptyState>
    }
    else if (!Session.Ready)
    {
        <p class="ep-status" role="status">@L["載入中…"]</p>
    }
    else if (!Session.Capabilities.HasPlan)
    {
        <FormAlert Kind="AlertKind.Info">
            @L["你的組織目前沒有方案，不能使用搜尋。請洽我們的業務啟用。"]
        </FormAlert>
    }
    else if (!Session.Capabilities.HasModule(ModuleKeys.LawSearch) && !Session.Capabilities.AiAnswer)
    {
        <FormAlert Kind="AlertKind.Info">
            @L["目前尚未開啟任何查詢模組，請洽系統管理員。"]
        </FormAlert>
    }
    else
    {
        @if (Session.Turns.Count == 0)
        {
            <header class="ep-ask-hero">
                <span class="ep-ask-mark" aria-hidden="true"><BrandMark /></span>
                <h1 class="ep-ask-title">@(_name is null ? L["你好"] : L["你好，{0}", _name])</h1>
                <p class="ep-ask-scope">
                    @(Session.Capabilities.AiAnswer ? L["AI 法源接地問答 · 中央環境法規"] : L["中央法規檢索"])
                </p>
            </header>
        }
        else
        {
            <h1 class="ep-visually-hidden">@L["查詢結果"]</h1>
            <div class="ep-thread">
                @for (var turnIndex = 0; turnIndex < Session.Turns.Count; turnIndex++)
                {
                    var turn = Session.Turns[turnIndex];
                    var turnSources = TurnSourcesOf(turn);
                    var copyText = CopyTextOf(turn);
                    var copyId = $"ep-turn-copy-{turnIndex}";
                    var copyStatusId = $"ep-turn-copy-status-{turnIndex}";
                    <div class="ep-turn">
                        <p class="ep-bubble">@turn.Question</p>

                        <div class="ep-answer" aria-live="polite">
                            @if (turn.State != TurnState.Pending)
                            {
                                <div class="ep-answer-head">
                                    <span class="ep-answer-badge" aria-hidden="true"><BrandMark /></span>
                                    <span class="ep-answer-brand">@Brand.Name</span>
                                    @if (!string.IsNullOrEmpty(turn.AsOfLabel))
                                    {
                                        <span class="ep-answer-asof">@turn.AsOfLabel</span>
                                    }
                                </div>
                            }

                            @switch (turn.State)
                            {
                                case TurnState.Pending:
                                    <div class="ep-turn-pending">
                                        <div class="ep-answer-head">
                                            <span class="ep-answer-badge" aria-hidden="true"><BrandMark /></span>
                                            <span class="ep-answer-brand">@Brand.Name</span>
                                        </div>
                                        <p class="ep-status" role="status">@PendingText(turn)</p>
                                        <div class="ep-turn-skeleton" aria-hidden="true">
                                            <span class="ep-skeleton-block ep-skeleton-line"></span>
                                            <span class="ep-skeleton-block ep-skeleton-line"></span>
                                        </div>
                                    </div>
                                    break;
                                case TurnState.Failed:
                                    <FormAlert Message="@turn.Error" />
                                    break;
                                case TurnState.Refused:
                                    <FormAlert Kind="AlertKind.Info">@Session.RefusalLabel(turn.Answer!.RefusalReason)</FormAlert>
                                    @* 找到法源但不足以回答時帶著法條名稱清單：點擊後於右側抽屜依索引 API 載入全文。 *@
                                    <SourceCards Sources="turn.Answer!.Sources" AsOfLabel="@turn.AsOfLabel" OnSelect="@(s => OpenDrawerAsync(s, turn.AsOfLabel, turnSources))" />
                                    break;
                                case TurnState.Answered when turn.StoredAnswer is not null:
                                    @* 從歷史載入的回答：新格式帶著原始 Markdown／圖表本文與引用清單，以排版引擎還原；舊資料拆出正文與出處行。 *@
                                    @if (turn.MemoryText is not null)
                                    {
                                        <FormattedAnswerView Content="@turn.MemoryText"
                                                            Sources="@turnSources"
                                                            OnCitationSelect="@(s => OpenDrawerAsync(s, turn.AsOfLabel, turnSources))" />
                                        @foreach (var line in turn.StoredAnswer.Split('\n').Where(IsCitationLine))
                                        {
                                            <p class="ep-hint">@line</p>
                                        }
                                        @if (turnSources.Count > 0)
                                        {
                                            <SourceCards Sources="@turnSources"
                                                         AsOfLabel="@turn.AsOfLabel"
                                                         OnSelect="@(s => OpenDrawerAsync(s, turn.AsOfLabel, turnSources))" />
                                        }
                                    }
                                    else
                                    {
                                        @foreach (var segment in LegacySegmentsOf(turn.StoredAnswer))
                                        {
                                            if (segment.IsCitation)
                                            {
                                                <p class="ep-hint">@segment.Text</p>
                                            }
                                            else
                                            {
                                                <FormattedAnswerView Content="@segment.Text" />
                                            }
                                        }
                                        @if (turn.MemoryCitations.Count > 0)
                                        {
                                            <SourceCards Sources="@turnSources"
                                                         AsOfLabel="@turn.AsOfLabel"
                                                         OnSelect="@(s => OpenDrawerAsync(s, turn.AsOfLabel, turnSources))" />
                                        }
                                    }

                                    break;
                                case TurnState.Answered:
                                    <FormattedAnswerView Content="@turn.Answer!.Text"
                                                        Sources="turn.Answer.Sources"
                                                        OnCitationSelect="@(s => OpenDrawerAsync(s, turn.AsOfLabel, turnSources))" />
                                    <p class="ep-hint">@L["這段回答由 AI 只根據下列法條產生，請核對出處再引用。"]</p>
                                    <SourceCards Sources="turn.Answer.Sources" AsOfLabel="@turn.AsOfLabel" OnSelect="@(s => OpenDrawerAsync(s, turn.AsOfLabel, turnSources))" />
                                    break;
                                case TurnState.Listed:
                                    <p class="ep-status" role="status">
                                        @(turn.Hits!.Count == 0 ? L["沒有符合的條文。試試其他說法。"] : L["找到 {0} 條（相關度高的在前）。", turn.Hits.Count])
                                    </p>
                                    @foreach (var hit in turn.Hits)
                                    {
                                        <article class="ep-card ep-hit" aria-label="@L["《{0}》第 {1} 條", hit.LawTitle, hit.Number]">
                                            <h2 class="ep-section-title">@L["《{0}》第 {1} 條", hit.LawTitle, hit.Number]</h2>
                                            <p class="ep-hit-body">@hit.Content</p>
                                            @if (hit.GuidanceDocuments > 0)
                                            {
                                                <p class="ep-hint">@L["{0} 件函釋提到這個詞並解釋這一條；函釋不是依據，請以條文為準。", hit.GuidanceDocuments]</p>
                                            }
                                            @* 可直接複製的引用：法規名、條號、查的是哪一天、條文網址。 *@
                                            <p class="ep-hint">@L["引用：《{0}》第 {1} 條（{2}）", hit.LawTitle, hit.Number, turn.AsOfLabel!]<code class="ep-mono">@hit.Uri</code></p>
                                        </article>
                                    }

                                    break;
                            }

                            @if (!string.IsNullOrWhiteSpace(copyText) || turnSources.Count > 0)
                            {
                                <div class="ep-answer-actions">
                                    @if (!string.IsNullOrWhiteSpace(copyText))
                                    {
                                        <button type="button"
                                                class="ep-answer-action ep-js-only"
                                                data-copy-target="@copyId"
                                                data-copy-status="@copyStatusId"
                                                data-done="@L["已複製"]"
                                                data-failed="@L["無法自動複製，已選取文字，請按 Ctrl+C（Mac 按 ⌘C）。"]">
                                            <NavIcon Path="@Icons.Material.Outlined.ContentCopy" />
                                            <span>@L["複製回答"]</span>
                                        </button>
                                        <span id="@copyId" class="ep-visually-hidden">@copyText</span>
                                        <span id="@copyStatusId" class="ep-visually-hidden" role="status" aria-live="polite"></span>
                                    }
                                    @if (turnSources.Count > 0)
                                    {
                                        <button type="button"
                                                class="ep-answer-action"
                                                @onclick="() => OpenDrawerAsync(turnSources[0], turn.AsOfLabel, turnSources)">
                                            <NavIcon Path="@Icons.Material.Outlined.MenuBook" />
                                            <span>@L["法源依據（{0}）", turnSources.Count]</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @* 輸入框交由共用 AskComposer 模板渲染；首頁另有「使用說明」原生 popover 與 AI 提示。 *@
        <AskComposer @ref="_composer"
                     @bind-Value="_query"
                     Placeholder="@L["問問{0}", Brand.Name]"
                     InputLabel="@L["關鍵字"]"
                     SendLabel="@L["搜尋"]"
                     Rows="@(Session.Turns.Count == 0 ? 2 : 1)"
                     Disabled="@(Session.Busy || !_interactive)"
                     Busy="@Session.Busy"
                     Examples="@(Session.Turns.Count == 0 ? Examples : [])"
                     OnExampleSelect="AskAsync"
                     OnSubmit="SubmitAsync">
            <FooterContent>
                @if (Session.Turns.Count == 0)
                {
                    @* 首頁只留一行極簡提示；完整說明（怎麼輸入、紀錄、資料送到哪裡）收在原生 popover，點「使用說明」才開。
                       資料外送的揭露不能消失，所以在面板裡；每則 AI 回答自己另有「請核對出處」的提示。 *@
                    <div class="ep-ask-foot">
                        @if (Session.Capabilities.AiAnswer)
                        {
                            <p class="ep-ask-note">@L["回答由 AI 產生，請核對出處。"]</p>
                        }
                        <button type="button" class="ep-text-button" popovertarget="ask-info">@L["使用說明"]</button>
                    </div>

                    <div id="ask-info" class="ep-sheet" popover role="dialog" aria-labelledby="ask-info-title">
                        <h2 id="ask-info-title" class="ep-section-title ep-sheet-title">@L["使用說明"]</h2>
                        <ul class="ep-sheet-list">
                            <li>@L["用條文裡會出現的詞，空白分隔。"]</li>
                            <li>@L["你的提問會存在"]<a href="@($"{PortalPaths.Home(Tenant)}/history")">@L["對話紀錄"]</a>@L["，只有你看得到，{0} 天後自動刪除，也可以隨時自己刪。", Settings.RetentionDays]</li>
                            @if (Session.Capabilities.AiAnswer)
                            {
                                <li>@L["回答由 AI 產生：你的問題與相關條文會送到模型服務。"]</li>
                            }
                        </ul>
                        <div class="ep-sheet-actions">
                            <button type="button" class="ep-btn ep-btn-quiet" popovertarget="ask-info" popovertargetaction="hide">@L["關閉說明"]</button>
                        </div>
                    </div>
                }
            </FooterContent>
        </AskComposer>
    }
</div>

<CitationDrawer IsOpen="@_drawerOpen"
                Code="@_drawerCode"
                Title="@_drawerTitle"
                Uri="@_drawerUri"
                AsOfLabel="@_drawerAsOfLabel"
                Content="@_drawerContent"
                Article="@_drawerArticle"
                IsLoading="@_drawerLoading"
                ErrorMessage="@_drawerError"
                Sources="@_drawerSources"
                OnSelectSource="SelectDrawerSourceAsync"
                OnAskFollowUp="FollowUpFromDrawer"
                OnClose="CloseDrawer" />
