@using Microsoft.JSInterop
@page "/portal/{Tenant}"
@page "/portal/{Tenant}/c/{Id:guid}"
@layout WorkspaceLayout
@attribute [Authorize(Policy = PlatformAuth.PortalPolicy)]
@implements IAsyncDisposable
@inherits WorkspacePageBase
@inject ChatSession Session
@inject IConversationHistoryAvailability History
@inject IJSRuntime JS

<DocumentTitle Text="@L["查詢"]" />

@* 問答為主的工作區（Interactive Server）：一串對話，每個回合是「你的問題 → 回答與出處」，輸入框黏在底部接著問，
   側欄列出最近的對話。有設定模型端點、租戶也同意時，回答是模型只根據 consult 的封閉證據寫的、每個論點附出處代號，
   加上對應的條文卡片；沒有就只列有出處的條文。互動頁面需要 JavaScript（連線），沒有它時只留這則說明。 *@
<noscript>
    <FormAlert Kind="AlertKind.Info">@L["這個頁面需要 JavaScript 才能使用。"]</FormAlert>
</noscript>

<div class="ep-ask" data-state="@(Session.Turns.Count > 0 ? "result" : "empty")">
    @if (_notFound)
    {
        @* 不是自己的、已刪除、已過期、沒開啟：都是同一個畫面，不洩漏它存不存在。 *@
        <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="@L["找不到這個對話"]" Description="@L["它可能已經被刪除，或已超過保留期限。"]">
            <a class="ep-btn ep-btn-primary" href="@PortalPaths.Home(Tenant)">@L["新對話"]</a>
        </EmptyState>
    }
    else if (!Session.Ready)
    {
        <p class="ep-status" role="status">@L["載入中…"]</p>
    }
    else if (!Session.Capabilities.HasPlan)
    {
        <FormAlert Kind="AlertKind.Info">
            @L["你的組織目前沒有方案，不能使用搜尋。請洽我們的業務啟用。"]
        </FormAlert>
    }
    else
    {
        @if (Session.Turns.Count == 0)
        {
            <header class="ep-ask-hero">
                <h1 class="ep-ask-title">@(_name is null ? L["你好"] : L["你好，{0}", _name])</h1>
                <p class="ep-ask-lead">@L["想查哪一條法規？"]</p>
            </header>
        }
        else
        {
            <h1 class="ep-visually-hidden">@L["查詢結果"]</h1>
            <div class="ep-thread">
                @foreach (var turn in Session.Turns)
                {
                    <div class="ep-turn">
                        <p class="ep-bubble">
                            @turn.Question
                            @if (!string.IsNullOrEmpty(turn.AsOfLabel))
                            {
                                <span class="ep-bubble-meta">@turn.AsOfLabel</span>
                            }
                        </p>

                        <div class="ep-answer" aria-live="polite">
                            @switch (turn.State)
                            {
                                case TurnState.Pending:
                                    <p class="ep-status" role="status">@L["正在查找法源…"]</p>
                                    break;
                                case TurnState.Failed:
                                    <FormAlert Message="@turn.Error" />
                                    break;
                                case TurnState.Refused:
                                    <FormAlert Kind="AlertKind.Info">@Session.RefusalLabel(turn.Answer!.RefusalReason)</FormAlert>
                                    break;
                                case TurnState.Answered when turn.StoredAnswer is not null:
                                    @* 從歷史載入的回答：當時存下來的文字（正文與出處行）。 *@
                                    @foreach (var line in turn.StoredAnswer.Split('\n'))
                                    {
                                        <p class="@(IsCitationLine(line) ? "ep-hint" : "ep-answer-text")">@line</p>
                                    }

                                    break;
                                case TurnState.Answered:
                                    <p class="ep-answer-text">@turn.Answer!.Text</p>
                                    <p class="ep-hint">@L["這段回答由 AI 只根據下列法條產生，請核對出處再引用。"]</p>
                                    @foreach (var source in turn.Answer.Sources)
                                    {
                                        <article class="ep-card ep-hit" aria-label="@source.Citation">
                                            <h2 class="ep-section-title">[@source.Code] @source.Citation</h2>
                                            <p class="ep-hit-body">@source.Text</p>
                                            <p class="ep-hint">@L["引用：{0}（{1}）", source.Citation, turn.AsOfLabel!]<code class="ep-mono">@source.Uri</code></p>
                                        </article>
                                    }

                                    break;
                                case TurnState.Listed:
                                    <p class="ep-status" role="status">
                                        @(turn.Hits!.Count == 0 ? L["沒有符合的條文。試試其他說法，或換一天。"] : L["找到 {0} 條（相關度高的在前）。", turn.Hits.Count])
                                    </p>
                                    @foreach (var hit in turn.Hits)
                                    {
                                        <article class="ep-card ep-hit" aria-label="@L["《{0}》第 {1} 條", hit.LawTitle, hit.Number]">
                                            <h2 class="ep-section-title">@L["《{0}》第 {1} 條", hit.LawTitle, hit.Number]</h2>
                                            <p class="ep-hit-body">@hit.Content</p>
                                            @if (hit.GuidanceDocuments > 0)
                                            {
                                                <p class="ep-hint">@L["{0} 件函釋提到這個詞並解釋這一條；函釋不是依據，請以條文為準。", hit.GuidanceDocuments]</p>
                                            }
                                            @* 可直接複製的引用：法規名、條號、查的是哪一天、條文網址。 *@
                                            <p class="ep-hint">@L["引用：《{0}》第 {1} 條（{2}）", hit.LawTitle, hit.Number, turn.AsOfLabel!]<code class="ep-mono">@hit.Uri</code></p>
                                        </article>
                                    }

                                    break;
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <form class="ep-composer-form" @onsubmit="SubmitAsync">
            <div class="ep-composer">
                <label for="query" class="ep-visually-hidden">@L["關鍵字"]</label>
                <input id="query" type="search" class="ep-composer-input" maxlength="500" required autocomplete="off" enterkeyhint="search"
                       placeholder="@L["輸入關鍵字，例如：噪音管制標準"]" aria-describedby="query-hint"
                       @ref="_input" @bind="_query" @bind:event="oninput" disabled="@Session.Busy" />
                <div class="ep-composer-bar">
                    <label class="ep-date-chip" for="asof">
                        <span>@L["哪一天有效"]</span>
                        <input id="asof" type="date" value="@_asOf" @onchange="e => _asOf = e.Value?.ToString() ?? string.Empty" aria-describedby="query-hint" />
                    </label>
                    @if (Session.Turns.Count > 0)
                    {
                        <button type="button" class="ep-chip" @onclick="NewConversation">@L["新對話"]</button>
                    }
                    <button type="submit" class="ep-send" aria-label="@L["搜尋"]" disabled="@Session.Busy"><NavIcon Path="@Icons.Material.Filled.ArrowUpward" /></button>
                </div>
            </div>

            @if (Session.Turns.Count == 0)
            {
                <div class="ep-examples" aria-label="@L["範例"]">
                    @foreach (var example in Examples)
                    {
                        <button type="button" class="ep-chip" @onclick="() => AskAsync(example)">@example</button>
                    }
                </div>
            }

            <p id="query-hint" class="ep-ask-note">@L["用條文裡會出現的詞，空白分隔。不填日期就是現行；查行為發生當時適用的條文，請填那一天。"]@if (History.Enabled)
            {
                <text>@L["你的提問會存在"]<a href="@($"{PortalPaths.Home(Tenant)}/history")">@L["對話紀錄"]</a>@L["，只有你看得到，{0} 天後自動刪除，也可以隨時自己刪。", History.RetentionDays]</text>
            }
            else
            {
                <text>@L["查詢文字不會被記錄，只記一次搜尋的次數。"]</text>
            }
            @if (Session.Capabilities.AiAnswer)
            {
                <text> @L["回答由 AI 產生：你的問題與相關條文會送到模型服務。"]</text>
            }</p>
        </form>
    }
</div>
