@inherits LayoutComponentBase

@* 營運者後台的外殼：頂欄放品牌與帳號（選單從帳號鈕長出，點外面或 Esc 收回），左側欄是導覽。
   側欄依群組排：目前只有「平台」；服務有自己的頁面時，以同一個樣式加一組「服務」。導覽只列已經存在的頁面。
   側欄每項是圖示加文字：桌機可收成只剩圖示的窄欄、手機是從左側滑出的抽屜（forms.js 切換；沒有 JavaScript 時，
   窄螢幕上收成頂欄下方一條可橫捲的列）。 *@
<PlatformProviders />

<a class="ep-skip-link" href="#main">@L["跳到主要內容"]</a>

<div class="ep-console">
    <header class="ep-shell-top">
        <button type="button" class="ep-side-toggle" aria-controls="ep-side" aria-expanded="true" aria-label="@L["展開或收合導覽"]"><NavIcon Path="@Icons.Material.Outlined.Menu" /></button>
        <span class="ep-brand"><BrandMark />@Brand.Name</span>
        <span class="ep-console-product">@L["營運後台"]</span>
        <AuthorizeView>
            <Authorized>
                <button type="button" id="ep-palette-open" class="ep-palette-open" popovertarget="ep-palette" aria-keyshortcuts="Control+K Meta+K">
                    <span>@L["搜尋頁面與租戶"]</span><kbd class="ep-kbd" data-shortcut-hint>Ctrl K</kbd>
                </button>
                <div id="ep-palette" class="ep-menu ep-palette" popover aria-label="@L["搜尋頁面與租戶"]">
                    <CommandPalette />
                </div>
                <button type="button" class="ep-avatar" popovertarget="ep-ui-account-menu" aria-label="@L["帳號選單"]">@Avatar(context.User)</button>
                <div id="ep-ui-account-menu" class="ep-menu" popover>
                    <p class="ep-menu-who">
                        <span>@context.User.FindFirst(ClaimTypes.Email)?.Value</span>
                    </p>
                    <nav aria-label="@L["帳號選單"]">
                        <a class="ep-menu-item" href="@UiEndpoints.PasswordPath">@L["改密碼"]</a>
                        <a class="ep-menu-item" href="@UiEndpoints.SecurityPath">@L["兩步驟驗證"]</a>
                    </nav>
                    <LanguageSwitch Action="@UiEndpoints.LanguagePath" />
                    <form method="post" action="/ui/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="ep-menu-item">@L["登出"]</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>

    <div class="ep-scrim" aria-hidden="true"></div>
    <div class="ep-edge" aria-hidden="true"></div>

    <div class="ep-console-body">
        <aside id="ep-side" class="ep-side">
            <p class="ep-side-group" aria-hidden="true">@L["平台"]</p>
            <nav class="ep-side-nav" aria-label="@L["主要導覽"]">
                <NavLink class="ep-side-link" href="/ui" Match="NavLinkMatch.All"><NavIcon Path="@Icons.Material.Outlined.Dashboard" /><span class="ep-side-label">@L["總覽"]</span></NavLink>
                <NavLink class="ep-side-link" href="/ui/tenants"><NavIcon Path="@Icons.Material.Outlined.Apartment" /><span class="ep-side-label">@L["租戶"]</span></NavLink>
                <NavLink class="ep-side-link" href="/ui/operators"><NavIcon Path="@Icons.Material.Outlined.AdminPanelSettings" /><span class="ep-side-label">@L["營運者"]</span></NavLink>
                <NavLink class="ep-side-link" href="/ui/audit"><NavIcon Path="@Icons.Material.Outlined.History" /><span class="ep-side-label">@L["稽核紀錄"]</span></NavLink>
            </nav>
        </aside>

        <main class="ep-console-main" id="main" tabindex="-1">
            @Body
        </main>
    </div>
</div>

@code {
    private static string Avatar(ClaimsPrincipal user)
    {
        var email = user.FindFirst(ClaimTypes.Email)?.Value;
        return string.IsNullOrEmpty(email) ? "?" : email[..1].ToUpperInvariant();
    }
}
