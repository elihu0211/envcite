@inherits PortalLayoutBase
@implements IDisposable

@* 客戶入口的互動式外殼（工作區，Interactive Server）。與靜態的 PortalLayout 同一個外觀（PortalShell），差別只在身分與租戶從哪裡來：
   circuit 裡沒有請求解析出的環境租戶，所以租戶一律取自已驗證的身分（登入 cookie 的租戶 claim），不用 IPortalAccount。
   問答頁問完一題、對話被記進歷史，會通知這裡重新讀最近對話。 *@
<PortalShell TenantName="@_tenantName"
             HomeHref="@_home"
             HistoryEnabled="@HistoryAvailability.Enabled"
             HistoryHref="@HistoryHrefOf(_tenantIdentifier)"
             UserDisplayName="@DisplayNameOf(_user)"
             UserEmail="@_user?.FindFirst(ClaimTypes.Email)?.Value"
             RoleLabel="@(PortalLabels.Role(_user?.FindFirst(ClaimTypes.Role)?.Value))"
             AvatarText="@AvatarOf(_user)"
             LogoutAction="@(_home is null ? null : $"{_home}/logout")"
             ShowMenu="@_showMenu"
             MenuItems="@_menuItems"
             NavItems="@_navItems"
             Recent="@_recent"
             LanguageAction="@(_home is null ? null : $"{_home}/language")">
    @Body
</PortalShell>
