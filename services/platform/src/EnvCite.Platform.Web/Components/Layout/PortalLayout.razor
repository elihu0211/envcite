@inherits PlatformLayoutBase
@inject IPortalAccount Account
@inject IConversationHistory History

@* 客戶入口的外殼：靜態渲染（沒有 circuit、沒有互動元件），所以不用 MudBlazor 的元件。外觀與版面見 PortalShell。 *@
<PortalShell TenantName="@(Account.CurrentTenant is { } tenant ? tenant.Name ?? tenant.Identifier : null)"
             HomeHref="@(Account.CurrentTenant is { } home && Authenticated ? PortalPaths.Home(home.Identifier) : null)"
             UserEmail="@Email"
             RoleLabel="@(PortalLabels.Role(_user?.FindFirst(ClaimTypes.Role)?.Value))"
             AvatarText="@AvatarText"
             LogoutAction="@(Authenticated && Account.CurrentTenant is { } current ? $"{PortalPaths.Home(current.Identifier)}/logout" : null)"
             ShowMenu="@ShowMenu"
             MenuItems="@MenuItems"
             NavItems="@NavItems"
             LanguageAction="@(Account.CurrentTenant is { } languageTenant ? $"{PortalPaths.Home(languageTenant.Identifier)}/language" : null)">
    @Body
</PortalShell>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private ClaimsPrincipal? _user;

    private bool Authenticated => _user?.Identity?.IsAuthenticated == true && Account.CurrentTenant is not null;

    private string? Email => _user?.FindFirst(ClaimTypes.Email)?.Value;

    private string AvatarText
    {
        get
        {
            var name = _user?.FindFirst(ClaimTypes.GivenName)?.Value ?? Email;
            return string.IsNullOrEmpty(name) ? string.Empty : char.ConvertFromUtf32(char.ConvertToUtf32(name, 0)).ToUpperInvariant();
        }
    }

    /// <summary>已登入、而且沒有待辦的強制步驟（改初始密碼、註冊驗證器）才有選單：那兩步只開一頁，其他連結點了也會被導回去。</summary>
    private bool ShowMenu =>
        Authenticated
        && _user!.FindFirst(PlatformClaimTypes.PasswordChangeRequired) is null
        && _user.FindFirst(PlatformClaimTypes.MfaEnrollmentRequired) is null;

    private bool CanManageMembers => _user is not null && (_user.IsInRole(CustomerRoles.Owner) || _user.IsInRole(CustomerRoles.Admin));

    private IReadOnlyList<PortalShell.NavItem> NavItems
    {
        get
        {
            if (Account.CurrentTenant is not { } tenant)
            {
                return [];
            }

            var home = PortalPaths.Home(tenant.Identifier);
            var items = new List<PortalShell.NavItem> { new(home, L["查詢"], L["服務"], Exact: true, Icon: Icons.Material.Outlined.Search) };
            if (History.Enabled)
            {
                items.Add(new($"{home}/history", L["對話紀錄"], L["服務"], Icon: Icons.Material.Outlined.Forum));
            }

            if (CanManageMembers)
            {
                items.Add(new($"{home}/members", L["成員"], L["組織"], Icon: Icons.Material.Outlined.Group));
            }

            items.Add(new($"{home}/account", L["帳號與組織"], L["組織"], Icon: Icons.Material.Outlined.ManageAccounts));
            return items;
        }
    }

    private IReadOnlyList<PortalShell.MenuItem> MenuItems =>
        Account.CurrentTenant is { } tenant
            ? [new($"{PortalPaths.Home(tenant.Identifier)}/settings", L["個人設定"]), new($"{PortalPaths.Home(tenant.Identifier)}/security", L["兩步驟驗證"]), new(PortalPaths.Password(tenant.Identifier), L["改密碼"])]
            : [];

    protected override async Task OnInitializedAsync() =>
        _user = AuthenticationState is null ? null : (await AuthenticationState).User;
}
