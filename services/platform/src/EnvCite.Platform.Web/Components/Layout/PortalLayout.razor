@inherits PortalLayoutBase

@* 客戶入口的靜態外殼（登入、帳號、成員等靜態頁；沒有 circuit）：租戶取自請求解析出的環境租戶。
   互動式的工作區用 WorkspaceLayout（沒有環境租戶，租戶取自身分）。外觀與版面見 PortalShell。 *@
<PortalShell TenantName="@(Account.CurrentTenant is { } tenant ? tenant.Name ?? tenant.Identifier : null)"
             HomeHref="@(Account.CurrentTenant is { } home && Authenticated ? PortalPaths.Home(home.Identifier) : null)"
             HistoryEnabled="@HistoryAvailability.Enabled"
             HistoryHref="@HistoryHrefOf(Account.CurrentTenant?.Identifier)"
             UserDisplayName="@DisplayNameOf(_user)"
             UserEmail="@Email"
             RoleLabel="@(PortalLabels.Role(_user?.FindFirst(ClaimTypes.Role)?.Value))"
             AvatarText="@AvatarOf(_user)"
             LogoutAction="@(Authenticated && Account.CurrentTenant is { } current ? $"{PortalPaths.Home(current.Identifier)}/logout" : null)"
             ShowMenu="@ShowMenu"
             MenuItems="@MenuItems"
             NavItems="@NavItems"
             Recent="@_recent"
             LanguageAction="@(Account.CurrentTenant is { } languageTenant ? $"{PortalPaths.Home(languageTenant.Identifier)}/language" : null)">
    @Body
</PortalShell>
