@using EnvCite.Platform.Web.Components.Layout.Navigation
@inherits PortalLayoutBase
@inject IPortalAccount Account
@inject IEnumerable<IPortalNavContributor> NavContributors

@* 客戶入口的靜態外殼（登入、帳號、成員等靜態頁；沒有 circuit）：租戶取自請求解析出的環境租戶。
   互動式的工作區用 WorkspaceLayout（沒有環境租戶，租戶取自身分）。外觀與版面見 PortalShell。 *@
<PortalShell TenantName="@(Account.CurrentTenant is { } tenant ? tenant.Name ?? tenant.Identifier : null)"
             HomeHref="@(Account.CurrentTenant is { } home && Authenticated ? PortalPaths.Home(home.Identifier) : null)"
             UserEmail="@Email"
             RoleLabel="@(PortalLabels.Role(_user?.FindFirst(ClaimTypes.Role)?.Value))"
             AvatarText="@AvatarOf(_user)"
             LogoutAction="@(Authenticated && Account.CurrentTenant is { } current ? $"{PortalPaths.Home(current.Identifier)}/logout" : null)"
             ShowMenu="@ShowMenu"
             MenuItems="@MenuItems"
             NavItems="@NavItems"
             Recent="@_recent"
             LanguageAction="@(Account.CurrentTenant is { } languageTenant ? $"{PortalPaths.Home(languageTenant.Identifier)}/language" : null)">
    @Body
</PortalShell>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private ClaimsPrincipal? _user;

    private IReadOnlyList<PortalShell.RecentGroup> _recent = [];

    private bool Authenticated => _user?.Identity?.IsAuthenticated == true && Account.CurrentTenant is not null;

    private string? Email => _user?.FindFirst(ClaimTypes.Email)?.Value;

    private bool ShowMenu => Authenticated && CanUseMenu(_user);

    /// <summary>側欄的項目由各功能的 <see cref="IPortalNavContributor"/> 貢獻，外殼不認識任何功能。</summary>
    private IReadOnlyList<PortalShell.NavItem> NavItems =>
        Account.CurrentTenant is { } tenant && _user is not null
            ? PortalNavigation.Collect(NavContributors, new PortalNavContext(PortalPaths.Home(tenant.Identifier), _user))
            : [];

    private IReadOnlyList<PortalShell.MenuItem> MenuItems =>
        Account.CurrentTenant is { } tenant ? MenuItemsOf(tenant.Identifier) : [];

    protected override async Task OnInitializedAsync()
    {
        _user = AuthenticationState is null ? null : (await AuthenticationState).User;
        if (ShowMenu && Account.CurrentTenant is { } tenant)
            _recent = await RecentOfAsync(_user!, tenant.Identifier);
    }
}
