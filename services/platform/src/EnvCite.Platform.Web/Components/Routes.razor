<Router AppAssembly="typeof(Routes).Assembly" NotFoundPage="typeof(Anonymous.NotFound)">
    <Found Context="routeData">
        @* Resource：把路由資料當授權資源。circuit 裡的頁面切換不是 HTTP 請求，沒有租戶解析的環境租戶，
           入口的授權（PortalMemberHandler）靠這個資源裡的路由值取得「這一頁屬於哪個租戶」。拿掉它，入口頁在 circuit 裡一律被拒。 *@
        <AuthorizeRouteView RouteData="routeData" Resource="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized Context="auth">
                @if (auth.User.Identity?.IsAuthenticated == true)
                {
                    @* 已登入但帳號被停用或登入已失效（在已開著的頁面裡切換頁面時才會走到這裡；重新載入會由授權導去說明頁）：
                       不能再導去登入，會繞圈。 *@
                    <MudAlert Severity="Severity.Warning">@L["這個帳號目前沒有後台權限（可能已被停用，或登入已失效）。"]<MudLink Href="@UiEndpoints.LoginPath">@L["重新登入"]</MudLink></MudAlert>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
