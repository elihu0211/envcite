@inherits NavigableComponentBase

<Router AppAssembly="typeof(Routes).Assembly" NotFoundPage="typeof(Anonymous.NotFound)">
    <Found Context="routeData">
        @* Resource：把路由資料當授權資源。circuit 裡的頁面切換不是 HTTP 請求，沒有租戶解析的環境租戶，
           入口的授權（PortalMemberHandler）靠這個資源裡的路由值取得「這一頁屬於哪個租戶」。拿掉它，入口頁在 circuit 裡一律被拒。 *@
        <AuthorizeRouteView RouteData="routeData" Resource="routeData" DefaultLayout="@(InPortal ? typeof(WorkspaceLayout) : typeof(MainLayout))">
            <NotAuthorized Context="auth">
                @if (auth.User.Identity?.IsAuthenticated == true && InPortal)
                {
                    @* 客戶入口的頁面、已登入但不能開：別的組織的頁面，或還有必須先完成的步驟（改密碼、兩步驟驗證）。
                       版面用入口的（DefaultLayout 依網址挑），不能讓客戶看到後台的外殼與導覽。 *@
                    <FormAlert Message="@L["你目前不能開啟這個頁面。可能不是這個組織的成員，或還有必須先完成的步驟（改密碼、兩步驟驗證）。"]" />
                    @if (auth.User.FindFirst(PlatformClaimTypes.TenantIdentifier)?.Value is { Length: > 0 } own)
                    {
                        <a class="ep-btn ep-btn-primary" href="@PortalPaths.Home(own)">@L["回到我的組織"]</a>
                    }
                }
                else if (auth.User.Identity?.IsAuthenticated == true)
                {
                    @* 已登入但帳號被停用或登入已失效（在已開著的頁面裡切換頁面時才會走到這裡；重新載入會由授權導去說明頁）：
                       不能再導去登入，會繞圈。 *@
                    <MudAlert Severity="Severity.Warning">@L["這個帳號目前沒有後台權限（可能已被停用，或登入已失效）。"]<MudLink Href="@UiEndpoints.LoginPath">@L["重新登入"]</MudLink></MudAlert>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    /// <summary>目前的網址是客戶入口的頁面：未授權時的版面與說明要用入口的，不是後台的。</summary>
    private bool InPortal => PortalPaths.TenantFrom(new PathString(new Uri(Navigation.Uri).AbsolutePath)) is not null;
}
