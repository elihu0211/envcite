<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    @* viewport-fit=cover：瀏海與圓角螢幕上讓內容延伸到邊緣，再用安全區內縮（見 platform.css）。不禁用縮放。 *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    @* 瀏覽器的工具列顏色；顏色來自 token，不另寫。 *@
    <meta name="theme-color" content="@DesignTokens.Light.Background" />
    <base href="/" />
    <style>@((MarkupString)TokenCss.Render())</style>
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/EnvCite.Platform.Web/design/platform.css"]" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>
    /// 營運後台是互動的（Interactive Server）；標了 <c>[ExcludeFromInteractiveRouting]</c> 的頁面（客戶入口）是靜態伺服器端渲染：
    /// 每個請求自己解析租戶、自己驗證，不開 circuit，登入表單就是一個普通的 POST。
    /// </summary>
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
