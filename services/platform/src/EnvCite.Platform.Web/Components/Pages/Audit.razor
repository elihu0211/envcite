@page "/ui/audit"

<PageTitle>@L["稽核紀錄 · 環境知識"]</PageTitle>

<PageHeader Title="@L["稽核紀錄"]" />

<section class="ep-card ep-table-card" aria-label="@L["稽核事件"]">
    @* 篩選在表格正上方；條件存在網址裡，所以可以分享連結，重新整理也不會丟。 *@
    <div class="ep-toolbar ep-toolbar-wrap" role="search">
        <MudSelect T="string" @bind-Value="_tenant" Label="@L["租戶"]" Placeholder="@L["全部租戶"]" Clearable="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="ep-field">
            @foreach (var tenant in _tenantsById.Values.OrderBy(t => t.Identifier, StringComparer.Ordinal))
            {
                <MudSelectItem T="string" Value="@tenant.Id">@tenant.Identifier</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" @bind-Value="_action" Label="@L["事件"]" Placeholder="@L["全部事件"]" Clearable="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="ep-field">
            @foreach (var action in AuditActions.All)
            {
                <MudSelectItem T="string" Value="@action">@AuditLabels.Action(action)</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_actor" Label="@L["操作者"]" Placeholder="@L["email 或 API key id"]" Clearable="true"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="ep-field"
                      OnKeyUp="@(e => { if (e.Key == "Enter") Apply(); })" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Apply">@L["套用"]</MudButton>
        <MudButton Variant="Variant.Text" OnClick="Reset" Disabled="@(!HasFilter)">@L["重設"]</MudButton>
        <MudSpacer />
        <MudSwitch T="bool" @bind-Value="_dense" Color="Color.Primary" Label="@L["緊湊"]" aria-label="@L["緊湊列高"]" />
    </div>

    @* 讓螢幕閱讀器知道載入了多少筆，不搶走焦點。 *@
    <p class="ep-status" role="status" aria-live="polite">@Status</p>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="ma-4">
            @L["載入稽核紀錄失敗。"]
            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="() => LoadAsync(append: false)">@L["重試"]</MudButton>
        </MudAlert>
    }
    else if (_loading)
    {
        <Skeleton Kind="table" Rows="6" Label="@L["載入稽核紀錄中"]" />
    }
    else if (_items.Count == 0)
    {
        <EmptyState Icon="@(HasFilter ? Icons.Material.Outlined.SearchOff : Icons.Material.Outlined.History)" Title="@(HasFilter ? L["沒有符合條件的稽核事件"] : L["還沒有稽核事件"])"
                    Description="@(HasFilter ? L["試試放寬條件，或重設篩選。"] : L["建立租戶、簽發或撤銷 API key、營運者登入時，會留下紀錄。"])">
            @if (HasFilter)
            {
                <MudButton Variant="Variant.Text" OnClick="Reset">@L["重設篩選"]</MudButton>
            }
        </EmptyState>
    }
    else
    {
        <MudSimpleTable Dense="_dense" Hover="true" Elevation="0" Class="ep-table ep-cards" aria-label="@L["稽核事件，新到舊"]">
            <thead>
                <tr>
                    <th scope="col">@L["時間（台北）"]</th>
                    <th scope="col">@L["事件"]</th>
                    <th scope="col">@L["操作者"]</th>
                    <th scope="col">@L["租戶"]</th>
                    <th scope="col">@L["目標"]</th>
                    <th scope="col"><span class="ep-visually-hidden">@L["展開細節"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    var open = _expanded.Contains(item.Id);
                    <tr>
                        <td><time datetime="@TaipeiTime.Full(item.OccurredAt)" title="@TaipeiTime.Full(item.OccurredAt)">@TaipeiTime.Format(item.OccurredAt)</time></td>
                        <td>
                            <StatusBadge Tone="@AuditLabels.ActionTone(item.Action)">@AuditLabels.Action(item.Action)</StatusBadge>
                        </td>
                        <td class="ep-keep" data-label="@L["操作者"]">@AuditLabels.Actor(item.ActorType, item.ActorId)</td>
                        <td data-label="@L["租戶"]">@TenantLabel(item.TenantId)</td>
                        <td data-label="@L["目標"]">
                            @if (item.TargetId is null)
                            {
                                <span>—</span>
                            }
                            else
                            {
                                <span class="ep-secondary">@item.TargetType</span>
                                <code class="ep-mono ep-nowrap">@AuditLabels.Shorten(item.TargetId)</code>
                            }
                        </td>
                        <td>
                            <MudIconButton Icon="@(open ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small"
                                           aria-expanded="@(open ? "true" : "false")" aria-controls="@($"detail-{item.Id}")"
                                           aria-label="@((open ? L["收合"] : L["展開"]) + L["事件細節"])"
                                           OnClick="() => Toggle(item.Id)" />
                        </td>
                    </tr>
                    @if (open)
                    {
                        <tr id="@($"detail-{item.Id}")" class="ep-detail-row">
                            <td colspan="6">
                                <dl class="ep-detail">
                                    <dt>@L["事件 Id"]</dt><dd><code class="ep-mono">@item.Id</code></dd>
                                    <dt>@L["事件鍵"]</dt><dd><code class="ep-mono">@item.Action</code></dd>
                                    <dt>@L["操作者類型"]</dt><dd>@item.ActorType</dd>
                                    <dt>Trace</dt><dd><code class="ep-mono">@(item.TraceId ?? "—")</code></dd>
                                    <dt>@L["內容"]</dt><dd><pre class="ep-mono">@Pretty(item.Detail)</pre></dd>
                                </dl>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </MudSimpleTable>

        <div class="ep-load-more">
            @if (_next is not null)
            {
                @* 「載入更多」而不是無限捲動：使用者決定要不要看更多，也不會把頁尾推走（無障礙）。 *@
                <MudButton Variant="Variant.Outlined" OnClick="LoadMoreAsync" Disabled="_loadingMore">
                    @(_loadingMore ? L["載入中…"] : L["載入更多"])
                </MudButton>
            }
            else
            {
                <p class="ep-page-description">@L["已顯示全部。"]</p>
            }
        </div>
    }
</section>
