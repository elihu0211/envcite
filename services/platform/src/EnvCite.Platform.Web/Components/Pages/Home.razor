@page "/ui"
@inject ITenantDirectory Directory
@inject IOperatorAdmin Operators
@inject IAuditQuery AuditQuery

<PageTitle>@L["總覽 · 環境知識"]</PageTitle>

<PageHeader Title="@L["總覽"]" />

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">
        @L["載入總覽失敗。"]
        <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="LoadAsync">@L["重試"]</MudButton>
    </MudAlert>
}
else if (_tenants is null || _operators is null)
{
    <Skeleton Label="@L["載入總覽中"]" />
}
else
{
    <section class="ep-stats" aria-label="@L["摘要"]">
        <a class="ep-stat" href="/ui/tenants">
            <span class="ep-stat-label">@L["租戶"]</span>
            <span class="ep-stat-value">@_tenants.Count</span>
            <span class="ep-stat-note">@(_withoutPlan.Count == 0 ? L["都有方案"] : L["{0} 個沒有方案", _withoutPlan.Count])</span>
        </a>
        <a class="ep-stat" href="/ui/operators">
            <span class="ep-stat-label">@L["營運者"]</span>
            <span class="ep-stat-value">@_operators.Count(o => !o.Disabled)</span>
            <span class="ep-stat-note">@(_pendingOperators.Count == 0 ? L["都已完成設定"] : L["{0} 位需要處理", _pendingOperators.Count])</span>
        </a>
        <a class="ep-stat" href="/ui/audit">
            <span class="ep-stat-label">@L["最近的登入失敗"]</span>
            <span class="ep-stat-value">@_recent.Count(r => AuditLabels.ActionTone(r.Action) == "error")</span>
            <span class="ep-stat-note">@L["最近 {0} 筆事件中", _recent.Count]</span>
        </a>
    </section>

    <div class="ep-columns">
        <section class="ep-card" aria-labelledby="todo-heading">
            <h2 id="todo-heading" class="ep-section-title">@L["需要處理"]</h2>
            @if (_withoutPlan.Count == 0 && _pendingOperators.Count == 0)
            {
                <p class="ep-page-description">@L["沒有待辦。"]</p>
            }
            else
            {
                <ul class="ep-list">
                    @foreach (var tenant in _withoutPlan)
                    {
                        <li>
                            <StatusBadge Tone="warning">@L["沒有方案"]</StatusBadge>
                            <span>@(tenant.Name ?? tenant.Identifier) <code class="ep-mono ep-secondary">@tenant.Identifier</code></span>
                            <a href="@($"/ui/tenants/{Uri.EscapeDataString(tenant.Id)}")">@L["指派方案"]</a>
                        </li>
                    }
                    @foreach (var op in _pendingOperators)
                    {
                        <li>
                            <StatusBadge Tone="@(op.LockedOut ? "error" : "warning")">@OperatorLabels.Status(op)</StatusBadge>
                            <span>@op.Email</span>
                            <a href="/ui/operators">@L["營運者"]</a>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="ep-card" aria-labelledby="recent-heading">
            <div class="ep-toolbar">
                <h2 id="recent-heading" class="ep-section-title">@L["最近活動"]</h2>
                <span class="ep-spacer"></span>
                <a href="/ui/audit">@L["稽核紀錄"]</a>
            </div>
            @if (_recent.Count == 0)
            {
                <p class="ep-page-description">@L["還沒有事件。"]</p>
            }
            else
            {
                <ul class="ep-list">
                    @foreach (var item in _recent)
                    {
                        <li>
                            <StatusBadge Tone="@AuditLabels.ActionTone(item.Action)">@AuditLabels.Action(item.Action)</StatusBadge>
                            <span class="ep-keep">@AuditLabels.Actor(item.ActorType, item.ActorId)</span>
                            <time class="ep-secondary" datetime="@TaipeiTime.Full(item.OccurredAt)">@TaipeiTime.Format(item.OccurredAt)</time>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
}

@code {
    private const int RecentCount = 8;

    private IReadOnlyList<TenantSummary>? _tenants;
    private IReadOnlyList<OperatorInfo>? _operators;
    private IReadOnlyList<TenantSummary> _withoutPlan = [];
    private IReadOnlyList<OperatorInfo> _pendingOperators = [];
    private IReadOnlyList<AuditRecord> _recent = [];
    private string? _error;

    public sealed record Overview(IReadOnlyList<TenantSummary> Tenants, IReadOnlyList<OperatorInfo> Operators, IReadOnlyList<AuditRecord> Recent);

    /// <summary>預先渲染查到的資料交給互動渲染，不再查一次。重新連線不還原：資料可能已經變了，要重查。</summary>
    [PersistentState(RestoreBehavior = RestoreBehavior.SkipLastSnapshot)]
    public Overview? Prerendered { get; set; }

    protected override Task OnInitializedAsync()
    {
        if (Prerendered is { } overview)
        {
            Prerendered = null;
            Show(overview);
            return Task.CompletedTask;
        }

        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _tenants = null;
        _operators = null;
        try
        {
            var tenants = await Directory.ListAsync(CancellationToken.None);
            var operators = await Operators.ListAsync(CancellationToken.None);
            if (!operators.IsOk)
            {
                _error = operators.Localized() ?? L["載入失敗。"];
                return;
            }

            var recent = await AuditQuery.QueryAsync(new AuditFilter(Limit: RecentCount), CancellationToken.None);

            var overview = new Overview(tenants, operators.Value!, recent.Items);
            if (!RendererInfo.IsInteractive)
            {
                Prerendered = overview;
            }

            Show(overview);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _error = exception.GetType().Name;
        }
    }

    private void Show(Overview overview)
    {
        _tenants = overview.Tenants;
        _operators = overview.Operators;
        _withoutPlan = [.. overview.Tenants.Where(t => t.Plan is null).OrderBy(t => t.Identifier, StringComparer.Ordinal)];
        _pendingOperators = [.. overview.Operators.Where(o => !o.Disabled && OperatorLabels.Tone(o) != "success")];
        _recent = overview.Recent;
    }
}
