@page "/ui/tenants"
@using EnvCite.Platform.Web.Components.Dialogs
@inject ITenantDirectory Directory
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<PageTitle>@L["租戶 · 環境知識"]</PageTitle>

<PageHeader Title="@L["租戶"]">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync">@L["新增租戶"]</MudButton>
    </Actions>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @L["載入租戶失敗。"]
        <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="LoadAsync">@L["重試"]</MudButton>
    </MudAlert>
}
else if (_tenants is null)
{
    <MudProgressLinear Indeterminate="true" aria-label="@L["載入租戶中"]" />
}
else
{
    <section class="ep-card ep-table-card" aria-label="@L["租戶清單"]">
        <div class="ep-toolbar" role="search">
            <MudTextField @bind-Value="_search" Immediate="true" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="@L["搜尋名稱或識別碼"]" aria-label="@L["搜尋租戶"]"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            <MudSpacer />
            <MudSwitch T="bool" @bind-Value="_dense" Color="Color.Primary" Label="@L["緊湊"]" aria-label="@L["緊湊列高"]" />
        </div>

        <MudTable Items="_tenants" Filter="Matches" Dense="_dense" Hover="true" Elevation="0" Breakpoint="Breakpoint.None"
                  RowsPerPage="25" Class="ep-table ep-cards">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<TenantSummary, object>(t => t.Name ?? string.Empty)">@L["名稱"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<TenantSummary, object>(t => t.Identifier)" InitialDirection="SortDirection.Ascending">@L["識別碼"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<TenantSummary, object>(t => t.Plan ?? string.Empty)">@L["方案"]</MudTableSortLabel></MudTh>
                <MudTh>@L["操作"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["名稱"]"><MudLink Href="@($"/ui/tenants/{Uri.EscapeDataString(context.Id)}")">@(context.Name ?? context.Identifier)</MudLink></MudTd>
                <MudTd DataLabel="@L["識別碼"]"><code class="ep-mono">@context.Identifier</code></MudTd>
                <MudTd DataLabel="@L["方案"]">
                    @if (context.Plan is { } plan)
                    {
                        <StatusBadge Tone="success">@plan</StatusBadge>
                    }
                    else
                    {
                        <StatusBadge Tone="warning">@L["沒有方案"]</StatusBadge>
                    }
                </MudTd>
                <MudTd DataLabel="@L["操作"]">
                    <MudLink Href="@($"/ui/tenants/{Uri.EscapeDataString(context.Id)}")">@L["管理"]</MudLink>
                    <MudLink Href="@($"/ui/audit?tenant={Uri.EscapeDataString(context.Id)}")" Class="ml-3">@L["稽核紀錄"]</MudLink>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                @if (string.IsNullOrWhiteSpace(_search))
                {
                    <EmptyState Icon="@Icons.Material.Outlined.Apartment" Title="@L["還沒有任何租戶"]"
                                Description="@L["建立第一個租戶，再為它簽發 API key 並指派方案。"]">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync">@L["新增租戶"]</MudButton>
                    </EmptyState>
                }
                else
                {
                    <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="@L["沒有符合「{0}」的租戶", _search!]"
                                Description="@L["試試其他關鍵字，或清除搜尋。"]">
                        <MudButton Variant="Variant.Text" OnClick="() => _search = null">@L["清除搜尋"]</MudButton>
                    </EmptyState>
                }
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" RowsPerPageString="@L["每頁筆數"]" InfoFormat="{first_item}–{last_item}／{all_items}" />
            </PagerContent>
        </MudTable>
    </section>
}

@code {
    private IReadOnlyList<TenantSummary>? _tenants;
    private string? _error;
    private string? _search;
    private bool _dense;

    /// <summary>預先渲染查到的清單交給互動渲染，不再查一次。重新連線不還原：資料可能已經變了，要重查。</summary>
    [PersistentState(RestoreBehavior = RestoreBehavior.SkipLastSnapshot)]
    public IReadOnlyList<TenantSummary>? Prerendered { get; set; }

    protected override Task OnInitializedAsync()
    {
        if (Prerendered is not null)
        {
            (_tenants, Prerendered) = (Prerendered, null);
            return Task.CompletedTask;
        }

        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _tenants = null;
        try
        {
            _tenants = await Directory.ListAsync(CancellationToken.None);
            if (!RendererInfo.IsInteractive)
            {
                Prerendered = _tenants;
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            _error = exception.GetType().Name;
        }
    }

    private async Task CreateAsync()
    {
        var dialog = await Dialogs.ShowAsync<CreateTenantDialog>(
            L["新增租戶"], new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: CreatedTenant created })
        {
            Navigation.NavigateTo($"/ui/tenants/{Uri.EscapeDataString(created.Id)}");
        }
    }

    private bool Matches(TenantSummary tenant) =>
        string.IsNullOrWhiteSpace(_search)
        || tenant.Identifier.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || (tenant.Name?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);
}
