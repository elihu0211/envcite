@page "/ui/operators"
@using EnvCite.Platform.Web.Components.Dialogs
@inject IOperatorAdmin Admin
@inject IMailSender Mail
@inherits AdminPageBase

<DocumentTitle Text="@L["營運者"]" />

<PageHeader Title="@L["營運者"]">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync">@L["新增營運者"]</MudButton>
    </Actions>
</PageHeader>

@if (Error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @L["載入營運者失敗。"]
        <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="LoadAsync">@L["重試"]</MudButton>
    </MudAlert>
}
else if (_operators is null)
{
    <Skeleton Kind="table" Label="@L["載入營運者中"]" />
}
else
{
    @if (Notice is not null)
    {
        <MudAlert Severity="@NoticeSeverity" Class="mb-4" role="status">@Notice</MudAlert>
    }

    <section class="ep-card ep-table-card" aria-label="@L["營運者清單"]">
        <div class="ep-toolbar" role="search">
            <MudTextField @bind-Value="_search" Immediate="true" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="@L["搜尋電子郵件"]" aria-label="@L["搜尋營運者"]"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </div>

        <MudTable Items="_operators" Filter="Matches" Hover="true" Elevation="0" Breakpoint="Breakpoint.None" Class="ep-table ep-cards">
            <HeaderContent>
                <MudTh>@L["電子郵件"]</MudTh>
                <MudTh>@L["狀態"]</MudTh>
                <MudTh>@L["操作"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["電子郵件"]">@context.Email</MudTd>
                <MudTd DataLabel="@L["狀態"]">
                    <StatusBadge Tone="@OperatorLabels.Tone(context)">@OperatorLabels.Status(context)</StatusBadge>
                    @if (!context.EmailConfirmed && !context.Invited)
                    {
                        <StatusBadge Tone="warning">@L["信箱未驗證"]</StatusBadge>
                    }
                </MudTd>
                <MudTd DataLabel="@L["操作"]" Class="ep-cell-actions">
                    @if (IsSelf(context))
                    {
                        <span class="ep-secondary">@L["你"]</span>
                    }
                    else if (context.Disabled)
                    {
                        <MudButton Variant="Variant.Text" Disabled="Busy" OnClick="() => EnableAsync(context)">@L["啟用"]</MudButton>
                    }
                    else
                    {
                        @if (Mail.Enabled && (context.Invited || !context.EmailConfirmed))
                        {
                            <MudButton Variant="Variant.Text" Disabled="Busy" OnClick="() => ResendAsync(context)"
                                       aria-label="@(context.Invited ? L["重寄邀請給 {0}", context.Email] : L["寄驗證信給 {0}", context.Email])">@(context.Invited ? L["重寄邀請"] : L["寄驗證信"])</MudButton>
                        }
                        <MudButton Variant="Variant.Text" Disabled="Busy" OnClick="() => ResetPasswordAsync(context)">@L["重設密碼"]</MudButton>
                        <MudButton Variant="Variant.Text" Disabled="Busy" OnClick="() => ResetTwoFactorAsync(context)">@L["重設驗證器"]</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="Busy" OnClick="() => DisableAsync(context)">@L["停用"]</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                @if (string.IsNullOrWhiteSpace(_search))
                {
                    <EmptyState Icon="@Icons.Material.Outlined.AdminPanelSettings" Title="@L["還沒有任何營運者"]"
                                Description="@L["建立第一個帳號，把一次性密碼交給對方。"]">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync">@L["新增營運者"]</MudButton>
                    </EmptyState>
                }
                else
                {
                    <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="@L["沒有符合「{0}」的營運者", _search!]"
                                Description="@L["試試其他關鍵字，或清除搜尋。"]">
                        <MudButton Variant="Variant.Text" OnClick="() => _search = null">@L["清除搜尋"]</MudButton>
                    </EmptyState>
                }
            </NoRecordsContent>
        </MudTable>
    </section>
}

@code {
    private IReadOnlyList<OperatorInfo>? _operators;
    private string? _selfId;
    private string? _search;

    protected override async Task OnInitializedAsync()
    {
        var user = await ActorAsync();
        _selfId = user.FindFirst(PlatformClaimTypes.OperatorId)?.Value;
        if (Prerendered is not null)
        {
            (_operators, Prerendered) = (Prerendered, null);
            return;
        }

        await LoadAsync();
    }

    /// <summary>預先渲染查到的清單交給互動渲染，不再查一次。重新連線不還原：資料可能已經變了，要重查。</summary>
    [PersistentState(RestoreBehavior = RestoreBehavior.SkipLastSnapshot)]
    public IReadOnlyList<OperatorInfo>? Prerendered { get; set; }

    private async Task LoadAsync()
    {
        Error = null;
        _operators = null;
        try
        {
            var listed = await Admin.ListAsync(CancellationToken.None);
            if (!listed.IsOk)
            {
                Error = listed.Localized() ?? L["載入失敗。"];
                _operators = [];
                return;
            }

            _operators = listed.Value;
            if (!RendererInfo.IsInteractive)
            {
                Prerendered = _operators;
            }
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Error = exception.GetType().Name;
            _operators = [];
        }
    }

    private bool IsSelf(OperatorInfo op) => string.Equals(op.Id, _selfId, StringComparison.OrdinalIgnoreCase);

    private bool Matches(OperatorInfo op) =>
        string.IsNullOrWhiteSpace(_search) || op.Email.Contains(_search, StringComparison.OrdinalIgnoreCase);


    private async Task CreateAsync()
    {
        var dialog = await Dialogs.ShowAsync<CreateOperatorDialog>(L["新增營運者"], Narrow);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: IssuedOperatorPassword issued })
        {
            await RevealAsync(issued);
            await ReloadQuietlyAsync();
        }
        else if (result is { Canceled: false, Data: OperatorInvitation invitation })
        {
            await ReloadQuietlyAsync();
            if (invitation.Mail == MailDelivery.Sent)
            {
                Succeed(L["已寄出邀請信給 {0}。", invitation.Operator.Email]);
            }
            else
            {
                Fail(L["邀請信寄送失敗，{0} 的帳號已建立。請按「重寄邀請」，或用「重設密碼」取得暫時密碼。", invitation.Operator.Email]);
            }
        }
    }

    private async Task ResendAsync(OperatorInfo op)
    {
        await RunAsync(async () =>
        {
            var sent = await Admin.ResendInvitationAsync(await ActorAsync(), op.Id, CancellationToken.None);
            if (!sent.IsOk)
            {
                Fail(sent.Localized() ?? L["寄信失敗，請稍後再試。"]);
                return;
            }

            await ReloadQuietlyAsync();
            if (sent.Value!.Mail == MailDelivery.Sent)
            {
                Succeed(op.Invited ? L["已重寄邀請信給 {0}。", op.Email] : L["已寄出驗證信給 {0}。", op.Email]);
            }
            else
            {
                Fail(L["寄信失敗，請稍後再試。"]);
            }
        });
    }

    private async Task ResetPasswordAsync(OperatorInfo op)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["重設密碼"],
            L["這會作廢 {0} 現在的密碼，並讓他在所有裝置上登出。新的一次性密碼只顯示一次。確定？", op.Email],
            yesText: L["重設密碼"], cancelText: L["取消"]);
        if (confirmed != true)
        {
            return;
        }

        await RunAsync(async () =>
        {
            var reset = await Admin.ResetPasswordAsync(await ActorAsync(), op.Id, CancellationToken.None);
            if (!reset.IsOk)
            {
                Fail(reset.Localized() ?? L["重設失敗。"]);
                return;
            }

            await RevealAsync(reset.Value!);
            await ReloadQuietlyAsync();
        });
    }

    private async Task ResetTwoFactorAsync(OperatorInfo op)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["重設驗證器"],
            L["這會關掉 {0} 的兩步驟驗證、丟掉驗證器金鑰與復原碼，並讓他在所有裝置上登出。請先確認對方是本人。確定？", op.Email],
            yesText: L["重設驗證器"], cancelText: L["取消"]);
        if (confirmed != true)
        {
            return;
        }

        await RunAsync(async () =>
        {
            var reset = await Admin.ResetTwoFactorAsync(await ActorAsync(), op.Id, CancellationToken.None);
            if (!reset.IsOk)
            {
                Fail(reset.Localized() ?? L["重設失敗。"]);
                return;
            }

            await ReloadQuietlyAsync();
            Succeed(L["已重設 {0} 的驗證器。", op.Email]);
        });
    }

    private async Task DisableAsync(OperatorInfo op)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["停用營運者"],
            L["{0} 的下一個請求就進不去。已經開著的頁面最多還能用一分鐘。確定停用？", op.Email],
            yesText: L["停用"], cancelText: L["取消"]);
        if (confirmed != true)
        {
            return;
        }

        await SetDisabledAsync(op, true);
    }

    private Task EnableAsync(OperatorInfo op) => SetDisabledAsync(op, false);

    private async Task SetDisabledAsync(OperatorInfo op, bool disabled)
    {
        await RunAsync(async () =>
        {
            var changed = await Admin.SetDisabledAsync(await ActorAsync(), op.Id, disabled, CancellationToken.None);
            if (!changed.IsOk)
            {
                Fail(changed.Localized() ?? L["操作失敗。"]);
                return;
            }

            await ReloadQuietlyAsync();
            Succeed(disabled ? L["已停用 {0}。", op.Email] : L["已重新啟用 {0}。", op.Email]);
        });
    }

    private async Task RevealAsync(IssuedOperatorPassword issued)
    {
        var reveal = await Dialogs.ShowAsync<OperatorPasswordDialog>(L["一次性密碼"], new DialogParameters<OperatorPasswordDialog>
        {
            { x => x.Operator, issued.Operator },
            { x => x.Password, issued.Password },
            { x => x.LoginPath, UiEndpoints.LoginPath },
        }, Narrow);
        await reveal.Result;
    }

    private async Task ReloadQuietlyAsync()
    {
        var listed = await Admin.ListAsync(CancellationToken.None);
        if (listed.IsOk)
        {
            _operators = listed.Value;
        }
    }
}
