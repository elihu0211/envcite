@page "/ui/tenants/{TenantId}"
@inject IAnswerAvailability Availability
@inherits AdminPageBase

<DocumentTitle Text="@(_tenant?.Identifier ?? L["租戶"])" />

<LoadedView Loading="Loading" Error="@Error" Missing="@(_tenant is null)" SkeletonKind="detail"
            FailedText="@L["載入租戶失敗。"]" LoadingLabel="@L["載入租戶中"]" OnRetry="LoadAsync"
            MissingIcon="@Icons.Material.Outlined.SearchOff" MissingTitle="@L["找不到這個租戶"]" MissingDescription="@L["它可能不存在，或識別有誤。"]">
    <MissingActions>
        <MudButton Variant="Variant.Text" Href="/ui/tenants">@L["回到租戶清單"]</MudButton>
    </MissingActions>
    <ChildContent>
        @{ var tenant = _tenant!; }
        <nav class="ep-breadcrumb" aria-label="@L["位置"]"><a href="/ui/tenants">@L["租戶"]</a> / @tenant.Identifier</nav>
        <PageHeader Title="@(tenant.Name ?? tenant.Identifier)">
            <Actions>
                <MudButton Variant="Variant.Outlined" OnClick="AddMemberAsync">@L["新增成員"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="IssueKeyAsync">@L["簽發新 key"]</MudButton>
            </Actions>
        </PageHeader>
        @* 身分列：左邊是租戶識別碼與狀態，右邊是存取網址。網址是附屬的，貼在身分旁的小按鈕，不佔一張卡；
           有沒有成員、有沒有 key 都在，所以不屬於任何一個分頁。 *@
        <div class="ep-subbar">
            <p class="ep-meta">
                <code class="ep-mono">@tenant.Identifier</code>
                @if (tenant.Plan is { } plan)
                {
                    <StatusBadge Tone="success">@plan</StatusBadge>
                }
                else
                {
                    <StatusBadge Tone="warning">@L["沒有方案"]</StatusBadge>
                }
                @if (tenant.AiAnswer)
                {
                    <StatusBadge Tone="info">@L["AI 回答"]</StatusBadge>
                }
            </p>
            <div class="ep-copy-group" role="group" aria-label="@L["存取網址"]">
                <CopyButton Id="portal-login-url" Label="@L["複製登入網址"]" Value="@PortalLoginUrl" />
                <CopyButton Id="api-base-url" Label="@L["複製 API Base URL"]" Value="@ApiBaseUrl" />
            </div>
        </div>

        @if (Notice is not null)
        {
            <MudAlert Severity="@NoticeSeverity" role="status" ShowCloseIcon="true" CloseIconClicked="() => ClearNotice()">@Notice</MudAlert>
        }

        <StatGrid Items="Stats" />

        @* 摘要之下依主題分頁：一次只看一件事。五個面板都在文件裡（只是收起），所以切換不必再查資料。 *@
        <PageTabs Items="Tabs" Active="@ActiveTab" />

        <TabPanel Key="@UsageTab" Active="@Is(UsageTab)">
            <SectionCard Id="usage-heading" Title="@L["用量與計量"]" Class="ep-table-card" Wrap="true">
                <Actions>
                    <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Class="ep-usage-filter">
                        <MudButton Color="@(_usageDays == 0 ? Color.Primary : Color.Default)" OnClick="() => SetUsageFilterAsync(0)">@L["全部"]</MudButton>
                        <MudButton Color="@(_usageDays == 30 ? Color.Primary : Color.Default)" OnClick="() => SetUsageFilterAsync(30)">@L["近 30 天"]</MudButton>
                        <MudButton Color="@(_usageDays == 7 ? Color.Primary : Color.Default)" OnClick="() => SetUsageFilterAsync(7)">@L["近 7 天"]</MudButton>
                    </MudButtonGroup>
                </Actions>
                <ChildContent>
                    @if (_usage.Count == 0)
                    {
                        <EmptyState Icon="@Icons.Material.Outlined.Insights" Title="@L["還沒有使用紀錄"]" Description="@L["租戶以 API key 呼叫 /v2 後，用量會出現在這裡。"]" />
                    }
                    else
                    {
                        <DataTable Items="_usage" Columns="UsageColumns" Label="@L["用量與計量"]" />
                    }
                </ChildContent>
            </SectionCard>
        </TabPanel>

        <TabPanel Key="@KeysTab" Active="@Is(KeysTab)">
            <SectionCard Id="keys-heading" Title="API keys" Class="ep-table-card" Toolbar="true">
                @if (_keys.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.VpnKey" Title="@L["還沒有 API key"]" Description="@L["簽發第一把 key 給客戶，他們才能呼叫 /v2。"]" />
                }
                else
                {
                    <DataTable Items="_keys" Columns="KeyColumns" Label="API keys" />
                }
            </SectionCard>
        </TabPanel>

        <TabPanel Key="@MembersTab" Active="@Is(MembersTab)">
            <SectionCard Id="members-heading" Title="@L["成員（客戶入口）"]" Class="ep-table-card" Toolbar="true">
                @if (_members.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.Group" Title="@L["還沒有成員"]" Description="@L["新增第一位成員，客戶才能登入入口。"]" />
                }
                else
                {
                    <DataTable Items="_members" Columns="MemberColumns" Label="@L["成員"]" />
                }
            </SectionCard>
        </TabPanel>

        @* 設定：方案與 AI 回答是等寬、等高的兩張；目錄同步內容多，獨佔一整列。 *@
        <TabPanel Key="@SettingsTab" Active="@Is(SettingsTab)">
            <div class="ep-grid">
                <SectionCard Id="plan-heading" Title="@L["方案"]">
                    <p class="ep-page-description">@L["沒有方案時資料端點回 402。變更立即生效並寫入稽核。"]</p>
                    <MudSelect T="string" @bind-Value="_selectedPlan" Label="@L["方案"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Placeholder="@(tenant.Plan is null ? L["尚未指派"].Value : null)">
                        @foreach (var plan in _plans)
                        {
                            <MudSelectItem T="string" Value="@plan.Name">@PlanLabel(plan)</MudSelectItem>
                        }
                    </MudSelect>
                    <div class="ep-inline-form">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SavePlanAsync"
                                   Disabled="@(Busy || _selectedPlan is null || _selectedPlan == tenant.Plan)">
                            @(tenant.Plan is null ? L["指派方案"] : L["變更方案"])
                        </MudButton>
                        @if (tenant.Plan is not null)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="RemovePlanAsync" Disabled="Busy">@L["移除方案"]</MudButton>
                        }
                    </div>
                    <p class="ep-status" role="status">
                        @if (tenant.Plan is { } current)
                        {
                            <span>@L["目前："]<strong>@current</strong></span>
                        }
                        else
                        {
                            <span>@L["目前沒有方案。"]</span>
                        }
                    </p>
                </SectionCard>

                <SectionCard Id="ai-heading" Title="@L["AI 回答"]">
                    <p class="ep-page-description">@L["成員的提問與相關條文會送到外部模型服務。需租戶同意；方案移除時一併關閉。"]</p>
                    <div class="ep-inline-form">
                        <MudButton Variant="Variant.Filled" Color="@(tenant.AiAnswer ? Color.Default : Color.Primary)" OnClick="ToggleAiAnswerAsync"
                                   Disabled="@(Busy || tenant.Plan is null)">
                            @(tenant.AiAnswer ? L["關閉 AI 回答"] : L["開啟 AI 回答"])
                        </MudButton>
                    </div>
                    <p class="ep-status" role="status">
                        <span>@L["目前："]<strong>@(tenant.AiAnswer ? L["已開啟"] : L["未開啟"])</strong></span>
                        @if (tenant.Plan is null)
                        {
                            <span>@L["（先指派方案。）"]</span>
                        }
                        else if (!Availability.Available)
                        {
                            <span>@L["（這個環境沒有設定模型端點。）"]</span>
                        }
                    </p>
                </SectionCard>

                @if (_directory is { } sync)
                {
                    <div class="ep-span">
                        <DirectoryStatusCard Id="directory" Status="sync" BaseUrl="@ScimUrl">
                            <Actions>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="DisableDirectoryAsync"
                                           Disabled="@(Busy || !sync.Settings.Enabled)">@L["關閉目錄同步"]</MudButton>
                            </Actions>
                        </DirectoryStatusCard>
                    </div>
                }

                <div class="ep-span">
                    <SectionCard Id="modules-heading" Title="@L["功能模組"]" Class="ep-table-card">
                        <ChildContent>
                            <p class="ep-page-description">@L["控制此租戶可使用的本體查詢與推論能力。變更立即生效並寫入稽核；方案終止時一併重設。"]</p>
                            <DataTable Items="_modules" Columns="ModuleColumns" Label="@L["功能模組"]" />
                        </ChildContent>
                    </SectionCard>
                </div>
            </div>
        </TabPanel>

        <TabPanel Key="@AuditTab" Active="@Is(AuditTab)">
            <SectionCard Id="audit-heading" Title="@L["最近的稽核事件"]">
                <Actions>
                    <a href="@($"/ui/audit?tenant={Uri.EscapeDataString(tenant.Id)}")">@L["全部"]</a>
                </Actions>
                <ChildContent>
                    @if (_recent.Count == 0)
                    {
                        <p class="ep-page-description">@L["還沒有事件。"]</p>
                    }
                    else
                    {
                        <ul class="ep-list" aria-label="@L["最近的稽核事件，新到舊"]">
                            @foreach (var item in _recent)
                            {
                                <li>
                                    <StatusBadge Tone="@AuditLabels.ActionTone(item.Action)">@AuditLabels.Action(item.Action)</StatusBadge>
                                    <span class="ep-keep">@AuditLabels.Actor(item.ActorType, item.ActorId)</span>
                                    <time class="ep-secondary" datetime="@TaipeiTime.Full(item.OccurredAt)">@TaipeiTime.Format(item.OccurredAt)</time>
                                </li>
                            }
                        </ul>
                    }
                </ChildContent>
            </SectionCard>
        </TabPanel>
    </ChildContent>
</LoadedView>

@code {
    private const string UsageTab = "usage";
    private const string KeysTab = "keys";
    private const string MembersTab = "members";
    private const string SettingsTab = "settings";
    private const string AuditTab = "audit";

    /// <summary>分頁依「先看資料、再管理、最後設定與紀錄」排；數量只給會增減的清單。</summary>
    private IReadOnlyList<TabItem> Tabs =>
    [
        new(UsageTab, L["用量"]),
        new(KeysTab, "API keys", _keys.Count),
        new(MembersTab, L["成員"], _members.Count),
        new(SettingsTab, L["設定"]),
        new(AuditTab, L["稽核紀錄"]),
    ];

    /// <summary>網址的 <c>?tab=</c> 沒給或不認得時，是第一個分頁。</summary>
    private string ActiveTab => Tabs.Any(t => t.Key == Tab) ? Tab! : UsageTab;

    private bool Is(string key) => ActiveTab == key;

    private IReadOnlyList<StatItem> Stats =>
    [
        new(L["呼叫次數"], TotalUsageCalls.ToString("N0"), UsageRangeLabel),
        new(L["計量單位"], TotalUsageUnits.ToString("N0"), UsageRangeLabel),
        new(L["有效 API keys"], _keys.Count(k => k.RevokedAt is null && (k.ExpiresAt is not { } e || e > DateTimeOffset.UtcNow)).ToString(CultureInfo.CurrentCulture),
            L["共 {0} 把", _keys.Count]),
        new(L["成員"], _members.Count(m => !m.Disabled).ToString(CultureInfo.CurrentCulture),
            _members.Count(m => m.MustChangePassword && !m.Disabled) is var pending && pending > 0 ? L["{0} 位待改密碼", pending] : L["都已啟用"]),
    ];

    private IReadOnlyList<ColumnDef<TenantUsageSummary>> UsageColumns =>
    [
        new()
        {
            Title = L["操作"], Class = "ep-keep", Labeled = false, SortBy = item => UsageLabels.Operation(item.Operation),
            Cell = item => @<text><div>@UsageLabels.Operation(item.Operation)</div><code class="ep-mono ep-secondary">@item.Operation</code></text>,
        },
        new() { Title = L["分類"], SortBy = item => UsageLabels.Category(item.Operation), Cell = item => @<text>@UsageLabels.Category(item.Operation)</text> },
        new() { Title = L["呼叫次數"], Numeric = true, SortBy = item => item.Calls, InitialSort = ColumnSort.Descending, Cell = item => @<text>@item.Calls.ToString("N0")</text> },
        new() { Title = L["計量單位"], Numeric = true, SortBy = item => item.Units, Cell = item => @<text>@item.Units.ToString("N0")<span class="ep-num-unit">@UsageLabels.UnitName(item.Operation)</span></text> },
        new()
        {
            Title = L["最近呼叫（台北）"], Label = L["最近呼叫"], SortBy = item => item.LastOccurredAt,
            Cell = item => @<text>
                @if (item.LastOccurredAt is { } last)
                {
                    <time datetime="@TaipeiTime.Full(last)">@TaipeiTime.Format(last)</time>
                }
                else
                {
                    <span>—</span>
                }
            </text>,
        },
    ];

    private IReadOnlyList<ColumnDef<ApiKeyInfo>> KeyColumns =>
    [
        new() { Title = L["名稱"], Class = "ep-keep", Labeled = false, SortBy = key => key.Name, Cell = key => @<text>@key.Name</text> },
        new() { Title = L["前綴"], Cell = key => @<text><code class="ep-mono">@key.Prefix</code></text> },
        new()
        {
            Title = L["建立（台北）"], Label = L["建立"], SortBy = key => key.CreatedAt,
            Cell = key => @<text><time datetime="@TaipeiTime.Full(key.CreatedAt)">@TaipeiTime.Format(key.CreatedAt)</time></text>,
        },
        new()
        {
            Title = L["狀態"],
            Cell = key => @<text>
                @if (key.RevokedAt is not null)
                {
                    <StatusBadge>@L["已撤銷"]</StatusBadge>
                }
                else if (key.ExpiresAt is { } expires && expires <= DateTimeOffset.UtcNow)
                {
                    <StatusBadge Tone="warning">@L["已過期"]</StatusBadge>
                }
                else
                {
                    <StatusBadge Tone="success">@L["有效"]</StatusBadge>
                }
            </text>,
        },
        new()
        {
            Title = L["操作"], HideTitle = true, Labeled = false,
            Cell = key => @<text>
                @if (key.RevokedAt is null)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" Disabled="Busy"
                               aria-label="@L["撤銷 {0}", key.Name]" OnClick="() => RevokeKeyAsync(key)">@L["撤銷"]</MudButton>
                }
            </text>,
        },
    ];

    private IReadOnlyList<ColumnDef<MemberInfo>> MemberColumns =>
    [
        new()
        {
            Title = L["電子郵件"], Class = "ep-keep", Labeled = false, SortBy = member => member.Email,
            Cell = member => @<text>@member.Email@(member.DisplayName is null ? "" : $"（{member.DisplayName}）")</text>,
        },
        new() { Title = L["角色"], SortBy = member => PortalLabels.Role(member.Role), Cell = member => @<text>@PortalLabels.Role(member.Role)</text> },
        new()
        {
            Title = L["狀態"],
            Cell = member => @<text>
                @if (member.Disabled)
                {
                    <StatusBadge>@L["已停用"]</StatusBadge>
                }
                else if (member.LockedOut)
                {
                    <StatusBadge Tone="error">@L["已鎖定"]</StatusBadge>
                }
                else if (member.Invited)
                {
                    <StatusBadge Tone="warning">@L["待啟用"]</StatusBadge>
                }
                else if (member.MustChangePassword)
                {
                    <StatusBadge Tone="warning">@L["待改密碼"]</StatusBadge>
                }
                else
                {
                    <StatusBadge Tone="success">@L["正常"]</StatusBadge>
                }
                @if (!member.EmailConfirmed && !member.Invited)
                {
                    <StatusBadge Tone="warning">@L["信箱未驗證"]</StatusBadge>
                }
                @if (member.TwoFactorEnabled)
                {
                    <StatusBadge Tone="info">@L["兩步驟"]</StatusBadge>
                }
                @if (member.Managed)
                {
                    <StatusBadge Tone="info">@L["由目錄同步管理"]</StatusBadge>
                }
            </text>,
        },
        new()
        {
            Title = L["操作"], HideTitle = true, Labeled = false,
            Cell = member => @<text>
                @if (CanResend(member))
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="Busy"
                               aria-label="@(member.Invited ? L["重寄邀請給 {0}", member.Email] : L["寄驗證信給 {0}", member.Email])"
                               OnClick="() => ResendInvitationAsync(member)">@(member.Invited ? L["重寄邀請"] : L["寄驗證信"])</MudButton>
                }
                <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="Busy"
                           aria-label="@L["重設 {0} 的密碼", member.Email]" OnClick="() => ResetPasswordAsync(member)">@L["重設密碼"]</MudButton>
                @if (member.Managed)
                {
                    @* 受目錄同步管理：停用與啟用由身分來源決定；要由人處理，先解除管理。 *@
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="Busy"
                               aria-label="@L["解除 {0} 的目錄同步管理", member.Email]" OnClick="() => ReleaseManagedAsync(member)">@L["解除管理"]</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="Busy"
                               aria-label="@(member.Disabled ? L["重新啟用 {0}", member.Email] : L["停用 {0}", member.Email])"
                               OnClick="() => SetDisabledAsync(member, !member.Disabled)">@(member.Disabled ? L["重新啟用"] : L["停用"])</MudButton>
                }
                @if (member.TwoFactorEnabled)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="Busy"
                               aria-label="@L["重設 {0} 的兩步驟驗證", member.Email]" OnClick="() => ResetTwoFactorAsync(member)">@L["重設兩步驟"]</MudButton>
                }
            </text>,
        },
    ];

    private IReadOnlyList<ColumnDef<TenantModuleStatus>> ModuleColumns =>
    [
        new()
        {
            Title = L["功能模組"], Class = "ep-keep", Labeled = false,
            Cell = m => @<text><strong>@ModuleName(m.Key)</strong> <code class="ep-mono">@m.Key</code></text>,
        },
        new()
        {
            Title = L["狀態"],
            Cell = m => @<text>
                @if (m.Enabled)
                {
                    <StatusBadge Tone="success">@L["已啟用"]</StatusBadge>
                }
                else
                {
                    <StatusBadge>@L["已關閉"]</StatusBadge>
                }
                <StatusBadge Tone="@(m.Source == TenantModuleSource.PlanDefault ? "neutral" : "info")">@ModuleSourceLabel(m.Source)</StatusBadge>
                @if (!m.GloballyAvailable)
                {
                    <StatusBadge Tone="warning">@L["（這個環境沒有設定模型端點。）"]</StatusBadge>
                }
                @if (m.UnmetDependencies.Count > 0)
                {
                    <StatusBadge Tone="warning">@L["需先開啟前置模組"]</StatusBadge>
                }
            </text>,
        },
        new()
        {
            Title = L["操作"], HideTitle = true, Labeled = false,
            Cell = m => @<text>
                @if (m.Enabled)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@(Busy || _tenant?.Plan is null)"
                               OnClick="() => SetModuleAsync(m.Key, false)">@L["關閉"]</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               Disabled="@(Busy || _tenant?.Plan is null || m.UnmetDependencies.Count > 0)"
                               OnClick="() => SetModuleAsync(m.Key, true)">@L["開啟"]</MudButton>
                }
                @if (m.Source != TenantModuleSource.PlanDefault)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@(Busy || _tenant?.Plan is null)"
                               OnClick="() => SetModuleAsync(m.Key, null)">@L["重設為預設"]</MudButton>
                }
            </text>,
        },
    ];
}
