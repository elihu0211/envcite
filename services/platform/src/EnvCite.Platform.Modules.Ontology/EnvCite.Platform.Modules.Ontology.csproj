<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EnvCite.Platform.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnvCite.Platform.Data\EnvCite.Platform.Data.csproj" />
    <ProjectReference Include="..\EnvCite.Platform.SharedKernel\EnvCite.Platform.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Grpc.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Contract source of truth: the repo-root proto/. Server stubs are generated too, for test fakes. -->
    <Protobuf Include="../../../../proto/envcite/ontology/v2/ontology.proto"
              ProtoRoot="../../../../proto"
              GrpcServices="Both" />
    <Protobuf Include="../../../../proto/envcite/ontology/v2/reasoning.proto"
              ProtoRoot="../../../../proto"
              GrpcServices="Both" />
  </ItemGroup>

</Project>
