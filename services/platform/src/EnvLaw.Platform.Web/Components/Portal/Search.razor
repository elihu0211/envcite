@page "/portal/{Tenant}/search"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = PlatformAuth.PortalPolicy)]

<PageTitle>搜尋法規 · env-law</PageTitle>

<header class="ep-page-header">
    <div>
        <h1 class="ep-page-title">搜尋法規</h1>
        <p class="ep-page-description">查某一天有效的條文。查詢文字不會被記錄，只記一次搜尋的次數。</p>
    </div>
    <a class="ep-btn ep-btn-quiet" href="@PortalPaths.Home(Tenant)">回總覽</a>
</header>

@if (!_hasPlan)
{
    <p class="ep-alert ep-alert-info" role="status">
        你的組織目前沒有方案，不能使用搜尋。請洽我們的業務啟用。
    </p>
}
else
{
    <section class="ep-card" aria-label="搜尋條件">
        @* POST：查詢全文是案件內容，不放進網址（網址會被各種日誌記下來）。 *@
        <EditForm Model="Input" FormName="portal-search" OnValidSubmit="SearchAsync" method="post" class="ep-form ep-search-form">
            <div class="ep-field-row">
                <label for="query" class="ep-label">關鍵字</label>
                <InputText id="query" @bind-Value="Input.Query" class="ep-input" required maxlength="500" autofocus
                           placeholder="例如：噪音管制標準" aria-describedby="query-hint" />
                <p id="query-hint" class="ep-hint">用條文裡會出現的詞，空白分隔。</p>
            </div>
            <div class="ep-field-row">
                <label for="asof" class="ep-label">哪一天有效（選填）</label>
                <InputText id="asof" @bind-Value="Input.AsOf" type="date" class="ep-input" aria-describedby="asof-hint" />
                <p id="asof-hint" class="ep-hint">不填就是現行。查行為發生當時適用的條文，請填那一天。</p>
            </div>
            <button type="submit" class="ep-btn ep-btn-primary">搜尋</button>
        </EditForm>
    </section>

    @if (_error is not null)
    {
        <p class="ep-alert ep-alert-error" role="alert">@_error</p>
    }

    @if (_hits is not null)
    {
        <p class="ep-status" role="status" aria-live="polite">
            @(_hits.Count == 0 ? "沒有符合的條文。試試其他說法，或換一天。" : $"找到 {_hits.Count} 條（相關度高的在前）。")
        </p>

        <div class="ep-stack">
            @foreach (var hit in _hits)
            {
                <article class="ep-card ep-hit" aria-label="@($"《{hit.LawTitle}》第 {hit.Number} 條")">
                    <h2 class="ep-section-title">《@hit.LawTitle》第 @hit.Number 條</h2>
                    <p class="ep-hit-body">@hit.Content</p>
                    @* 可直接複製的引用：法規名、條號、查的是哪一天、ELI 網址。 *@
                    <p class="ep-hint">引用：《@hit.LawTitle》第 @hit.Number 條（@_asOfLabel）<code class="ep-mono">@hit.Uri</code></p>
                </article>
            }
        </div>
    }
}
