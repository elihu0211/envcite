@page "/portal/{Tenant}/history"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = PlatformAuth.PortalPolicy)]

<PageTitle>對話紀錄 · 環境知識</PageTitle>

<PageHeader Title="對話紀錄" Description="你問過的問題與找到的出處。只有你看得到，同組織的其他人（包括擁有者）都看不到。" />

@if (!Store.Enabled)
{
    <p class="ep-alert ep-alert-info" role="status">這個環境沒有開啟對話紀錄。</p>
}
else
{
    <p class="ep-hint">超過 @Store.RetentionDays 天沒有更新的對話會自動刪除。</p>

    @if (_message is not null)
    {
        <p class="ep-alert ep-alert-info" role="status">@_message</p>
    }

    @if (_items.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.History" Title="還沒有對話" Description="在首頁問一個問題，它就會出現在這裡。">
            <a class="ep-btn ep-btn-primary" href="@PortalPaths.Home(Tenant)">查詢</a>
        </EmptyState>
    }
    else
    {
        <EditForm Model="Input" FormName="portal-history-delete" OnValidSubmit="DeleteAsync" method="post">
            <ul class="ep-history" aria-label="對話">
                @foreach (var item in _items)
                {
                    <li class="ep-card ep-history-item">
                        <a class="ep-history-link" href="@($"{PortalPaths.Home(Tenant)}/history/{item.Id}")">
                            <span class="ep-history-title">@item.Title</span>
                            <time class="ep-secondary" datetime="@TaipeiTime.Full(item.UpdatedAt)">@TaipeiTime.Format(item.UpdatedAt)</time>
                        </a>
                        <button type="submit" name="Input.Delete" value="@item.Id" formnovalidate class="ep-btn ep-btn-quiet"
                                aria-label="@($"刪除對話：{item.Title}")">刪除</button>
                    </li>
                }
            </ul>
        </EditForm>
    }
}
