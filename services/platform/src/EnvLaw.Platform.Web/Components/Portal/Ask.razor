@page "/portal/{Tenant}"
@page "/portal/{Tenant}/search"
@layout PortalLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Policy = PlatformAuth.PortalPolicy)]

<PageTitle>查詢法規 · env-law</PageTitle>

@* 問答為主的首頁：一個輸入框。還沒問時是置中的招呼加輸入框；問了之後是「你的問題 → 找到的條文」，輸入框留在底部接著問。
   有設定模型端點（Platform:Answer）時，回答是模型只根據 consult 的封閉證據寫的、每個論點附出處代號，加上對應的條文卡片；
   沒有設定時只列有出處的條文（法規名、條號、查的是哪一天、ELI 網址）。 *@
<div class="ep-ask" data-state="@(_asked ? "result" : "empty")">
    @if (!_hasPlan)
    {
        <p class="ep-alert ep-alert-info" role="status">
            你的組織目前沒有方案，不能使用搜尋。請洽我們的業務啟用。
        </p>
    }
    else
    {
        @if (!_asked)
        {
            <header class="ep-ask-hero">
                <h1 class="ep-ask-title">@(Name is null ? "你好" : $"你好，{Name}")</h1>
                <p class="ep-ask-lead">想查哪一條法規？</p>
            </header>
        }
        else
        {
            <h1 class="ep-visually-hidden">查詢結果</h1>
            <div class="ep-thread">
                <p class="ep-bubble">
                    @_question
                    <span class="ep-bubble-meta">@_asOfLabel</span>
                </p>

                <div class="ep-answer" aria-live="polite">
                    @if (_error is not null)
                    {
                        <p class="ep-alert ep-alert-error" role="alert">@_error</p>
                    }
                    else if (_answer is not null)
                    {
                        @if (_answer.Refused)
                        {
                            <p class="ep-alert ep-alert-info" role="status">@RefusalLabel(_answer.RefusalReason)</p>
                        }
                        else
                        {
                            <p class="ep-answer-text">@_answer.Text</p>
                            <p class="ep-hint">這段回答由 AI 只根據下列法條產生，請核對出處再引用。</p>

                            @foreach (var source in _answer.Sources)
                            {
                                <article class="ep-card ep-hit" aria-label="@source.Citation">
                                    <h2 class="ep-section-title">[@source.Code] @source.Citation</h2>
                                    <p class="ep-hit-body">@source.Text</p>
                                    <p class="ep-hint">引用：@source.Citation（@_asOfLabel）<code class="ep-mono">@source.Uri</code></p>
                                </article>
                            }
                        }
                    }
                    else if (_hits is not null)
                    {
                        <p class="ep-status" role="status">
                            @(_hits.Count == 0 ? "沒有符合的條文。試試其他說法，或換一天。" : $"找到 {_hits.Count} 條（相關度高的在前）。")
                        </p>

                        @foreach (var hit in _hits)
                        {
                            <article class="ep-card ep-hit" aria-label="@($"《{hit.LawTitle}》第 {hit.Number} 條")">
                                <h2 class="ep-section-title">《@hit.LawTitle》第 @hit.Number 條</h2>
                                <p class="ep-hit-body">@hit.Content</p>
                                @* 可直接複製的引用：法規名、條號、查的是哪一天、ELI 網址。 *@
                                <p class="ep-hint">引用：《@hit.LawTitle》第 @hit.Number 條（@_asOfLabel）<code class="ep-mono">@hit.Uri</code></p>
                            </article>
                        }
                    }
                </div>
            </div>
        }

        @* POST：查詢全文是案件內容，不放進網址（網址會被各種日誌記下來）。 *@
        <EditForm Model="Input" FormName="portal-search" OnValidSubmit="SearchAsync" method="post" class="ep-composer-form">
            @if (_conversationId is { } conversation)
            {
                <input type="hidden" name="Input.ConversationId" value="@conversation" />
            }
            <div class="ep-composer">
                <label for="query" class="ep-visually-hidden">關鍵字</label>
                <InputText id="query" @bind-Value="Input.Query" type="search" class="ep-composer-input" maxlength="500" required
                           autofocus="@(!_asked)" autocomplete="off" enterkeyhint="search"
                           placeholder="輸入關鍵字，例如：噪音管制標準" aria-describedby="query-hint" />
                <button type="submit" class="ep-send" aria-label="搜尋"><NavIcon Path="@Icons.Material.Filled.ArrowUpward" /></button>
            </div>
            <div class="ep-composer-options">
                <label class="ep-date-chip" for="asof">
                    <span>哪一天有效</span>
                    <InputText id="asof" @bind-Value="Input.AsOf" type="date" aria-describedby="query-hint" />
                </label>
            </div>

            @if (!_asked)
            {
                <div class="ep-examples" aria-label="範例">
                    @foreach (var example in Examples)
                    {
                        <button type="submit" name="Input.Example" value="@example" formnovalidate class="ep-chip">@example</button>
                    }
                </div>
            }

            <p id="query-hint" class="ep-ask-note">用條文裡會出現的詞，空白分隔。不填日期就是現行；查行為發生當時適用的條文，請填那一天。@if (History.Enabled)
            {
                <text>你的提問會存在<a href="@($"{PortalPaths.Home(Tenant)}/history")">對話紀錄</a>，只有你看得到，@History.RetentionDays 天後自動刪除，也可以隨時自己刪。</text>
            }
            else
            {
                <text>查詢文字不會被記錄，只記一次搜尋的次數。</text>
            }
            @if (Answerer.Available)
            {
                <text> 回答由 AI 產生：你的問題與相關條文會送到模型服務。</text>
            }</p>
        </EditForm>
    }
</div>
