@inherits LayoutComponentBase
@inject IPortalAccount Account

@* 客戶入口的外殼：靜態渲染（沒有 circuit、沒有互動元件），所以不用 MudBlazor 的元件。外觀與版面見 PortalShell。 *@
<PortalShell TenantName="@(Account.CurrentTenant is { } tenant ? tenant.Name ?? tenant.Identifier : null)"
             UserEmail="@_user?.FindFirst(ClaimTypes.Email)?.Value"
             LogoutAction="@(_user?.Identity?.IsAuthenticated == true && Account.CurrentTenant is { } current ? $"{PortalPaths.Home(current.Identifier)}/logout" : null)"
             ShowNav="@ShowNav"
             Items="@Items">
    @Body
</PortalShell>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private ClaimsPrincipal? _user;

    /// <summary>已登入、而且沒有待辦的強制步驟（改初始密碼、註冊驗證器）才有導覽：那兩步只開一頁，其他連結點了也會被導回去。</summary>
    private bool ShowNav =>
        _user?.Identity?.IsAuthenticated == true
        && Account.CurrentTenant is not null
        && _user.FindFirst(PlatformClaimTypes.PasswordChangeRequired) is null
        && _user.FindFirst(PlatformClaimTypes.MfaEnrollmentRequired) is null;

    private bool CanManageMembers => _user is not null && (_user.IsInRole(CustomerRoles.Owner) || _user.IsInRole(CustomerRoles.Admin));

    private IReadOnlyList<PortalShell.NavItem> Items
    {
        get
        {
            if (Account.CurrentTenant is not { } tenant)
            {
                return [];
            }

            var home = PortalPaths.Home(tenant.Identifier);
            var items = new List<PortalShell.NavItem>
            {
                new(home, "總覽", Icons.Material.Outlined.Dashboard, NavLinkMatch.All),
                new($"{home}/search", "搜尋法規", Icons.Material.Outlined.Search),
            };
            if (CanManageMembers)
            {
                items.Add(new($"{home}/members", "成員", Icons.Material.Outlined.Group));
            }

            items.Add(new($"{home}/security", "兩步驟驗證", Icons.Material.Outlined.Security));
            return items;
        }
    }

    protected override async Task OnInitializedAsync() =>
        _user = AuthenticationState is null ? null : (await AuthenticationState).User;
}
