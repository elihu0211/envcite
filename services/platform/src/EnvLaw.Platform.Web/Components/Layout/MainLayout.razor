@inherits LayoutComponentBase

@* 營運者後台的外殼：頂欄（半透明、內容從底下捲過）、頂欄下方的分頁列、主要內容。沒有側欄：只有三個頁面，分頁列就夠，
   手機上也不必再開抽屜。導覽只列已經存在的頁面；新頁面做好時再加一行，不放會 404 的連結。 *@
<PlatformProviders />

<a class="ep-skip-link" href="#main">跳到主要內容</a>

<MudLayout>
    <MudAppBar Class="ep-appbar" Elevation="0">
        <span class="ep-brand">env-law platform</span>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-3 ep-user">@context.User.FindFirst(ClaimTypes.Email)?.Value</MudText>
                <form method="post" action="/ui/logout">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Inherit">登出</MudButton>
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent id="main" tabindex="-1">
        <nav class="ep-tabs" aria-label="主要導覽">
            <NavLink class="ep-tab" href="/ui" Match="NavLinkMatch.All">總覽</NavLink>
            <NavLink class="ep-tab" href="/ui/tenants">租戶</NavLink>
            <NavLink class="ep-tab" href="/ui/audit">稽核紀錄</NavLink>
        </nav>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
