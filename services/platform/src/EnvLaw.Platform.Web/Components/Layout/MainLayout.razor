@inherits LayoutComponentBase

@* 營運者後台的外殼：頂欄（半透明、內容從底下捲過）、左側導覽、主要內容。 *@
<PlatformProviders />

<a class="ep-skip-link" href="#main">跳到主要內容</a>

<MudLayout>
    <MudAppBar Class="ep-appbar" Elevation="0">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="開關導覽選單" OnClick="() => _drawerOpen = !_drawerOpen" />
        <span class="ep-brand">env-law platform</span>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-3">@context.User.FindFirst(ClaimTypes.Email)?.Value</MudText>
                <form method="post" action="/ui/logout">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Inherit">登出</MudButton>
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" Elevation="0">
        <NavMenu />
    </MudDrawer>

    <MudMainContent id="main" tabindex="-1">
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
}
