@* 一次性初始密碼：只在建立或重設的當下顯示。不能用 Esc 或點背景關掉（SetOptions 在 OnInitialized 設定），只有「我已交給對方」。 *@
@using Microsoft.JSInterop
@inject IJSRuntime Js

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-3" role="status">
            這組密碼只會顯示這一次，關閉後無法再取回。請安全地交給 <strong>@Member.Email</strong>（不要貼在公開的聊天室或工單裡）。
            對方第一次登入時必須自己改掉；營運人員之後不會知道他的密碼。
        </MudAlert>
        <MudTextField T="string" Value="@Password" ReadOnly="true" Label="初始密碼" Variant="Variant.Outlined" Class="ep-mono"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                      AdornmentAriaLabel="複製初始密碼" OnAdornmentClick="CopyAsync" />
        <p class="ep-status" role="status" aria-live="polite">@(_copied ? "已複製到剪貼簿" : string.Empty)</p>
        <p class="ep-page-description">入口登入網址：<code class="ep-mono">@LoginPath</code></p>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => MudDialog.Close()">我已交給對方</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public MemberInfo Member { get; set; } = default!;

    [Parameter, EditorRequired] public string Password { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string LoginPath { get; set; } = string.Empty;

    private bool _copied;

    protected override Task OnInitializedAsync() =>
        MudDialog.SetOptionsAsync(MudDialog.Options with { BackdropClick = false, CloseOnEscapeKey = false, CloseButton = false });

    private async Task CopyAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", Password);
            _copied = true;
        }
        catch (JSException)
        {
            _copied = false; // 剪貼簿被瀏覽器擋住（非安全環境）：仍可手動選取文字。
        }
    }
}
