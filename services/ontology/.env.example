# 複製成 .env，用 `uv run --env-file .env <入口>` 載入；環境裡已有的同名變數優先。

# 資料庫（所有入口）
ONTOLOGY_DSN=postgresql://envcite:envcite@localhost:5432/envcite

# 快照目錄（envcite-sync、acquire、import）
ACQUIRE_SNAPSHOT_DIR=/tmp/snapshots

# 模型配置檔（envcite-ontology、envcite-sync 讀它的 [embedding]，啟用語意檢索臂）；空值為只用字面臂
ONTOLOGY_MODELS=models.toml
