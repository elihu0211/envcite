# 複製成 .env，用 `uv run --env-file .env <入口>` 載入；環境裡已有的同名變數優先。

# 資料庫（所有入口）
ONTOLOGY_DSN=postgresql://env_law:env_law@localhost:5432/env_law

# 快照目錄（env-law-sync、acquire、import）
ACQUIRE_SNAPSHOT_DIR=/tmp/snapshots

# 服務間呼叫的共用權杖（env-law-ontology）：呼叫端以 Bearer 帶上，本機各服務設相同值。
# 用 `wt ontology` 啟動時已自動設定，此處只供手動執行。ONTOLOGY_GRPC_PORT 為選用。
ONTOLOGY_INTERNAL_TOKEN=dev

# 模型金鑰（env-law-pipeline，由 models.toml 引用）
CHAT_API_KEY=
