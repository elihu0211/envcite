# 複製成 .env，用 `uv run --env-file .env <入口>` 載入；環境裡已有的同名變數優先。

# 資料庫（所有入口）
ONTOLOGY_DSN=postgresql://envcite:envcite@localhost:5432/envcite

# 快照目錄（envcite-sync、acquire、import）
ACQUIRE_SNAPSHOT_DIR=/tmp/snapshots

# 語意檢索臂的嵌入模型（envcite-ontology、envcite-sync）；EMBEDDING_BASE_URL 空值為只用字面臂
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-m3-embedding
EMBEDDING_API_KEY=

# 模型金鑰（envcite-pipeline，由 models.toml 引用）
CHAT_API_KEY=
