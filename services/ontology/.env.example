# 複製成 .env，用 `uv run --env-file .env <入口>` 載入；環境裡已有的同名變數優先。

# 資料庫（所有入口）
ENVCITE_ONTOLOGY_DSN=postgresql://envcite:envcite@localhost:5432/envcite

# 快照目錄（envcite-sync、acquire、import）
ENVCITE_ONTOLOGY_SNAPSHOT_DIR=/tmp/snapshots

# 模型配置檔（envcite-ontology、envcite-sync 讀它的 [embedding]，啟用語意檢索臂；envcite-ontology 另讀
# [reranker]，讓帶 rerank 的查詢精排）；空值為只用字面臂、不精排
ENVCITE_ONTOLOGY_MODELS=models.toml

# 字面臂略過出現在超過此比例的段落的詞（envcite-ontology）；0 為不略過
# ENVCITE_ONTOLOGY_LEXICAL_MAX_DF=0.005

# 函釋入口：命中的函釋占可用函釋的比例超過此值時，這個查詢不用函釋入口（envcite-ontology）；0 為不限制
# ENVCITE_ONTOLOGY_GUIDANCE_MAX_DF=0.03

# 請求帶 rerank 時，兩臂取幾條候選交給精排模型（envcite-ontology）；上限 50
# ENVCITE_ONTOLOGY_RERANK_CANDIDATES=30
