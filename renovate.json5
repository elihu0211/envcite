{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Renovate 官方建議的基線：recommended 之外再加 digest 釘選、最短發布天數、每週鎖檔維護。
  // 兩個註解預設集讓 Dockerfile 的 ARG 與 CI 的 *_VERSION 變數可由 `# renovate:` 註解追蹤。
  extends: [
    'config:best-practices',
    ':semanticCommits',
    'customManagers:dockerfileVersions',
    'customManagers:gitlabPipelineVersions',
  ],
  timezone: 'Asia/Taipei',
  // CI 額度有限：每週一批，不隨發布即時開 MR。
  schedule: ['before 6am on monday'],
  // 預設會略過 tests/；測試用的資料庫映像也要與其他處同版。
  ignorePaths: [],
  customManagers: [
    {
      customType: 'regex',
      description: 'Testcontainers 的 PostgreSQL 映像',
      managerFilePatterns: ['/(^|/)tests/.+\\.(py|cs)$/'],
      matchStrings: ['(?:PostgresContainer|PostgreSqlBuilder)\\("(?<depName>postgres):(?<currentValue>[^"@]+)"'],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: '文件中以 npx 執行的 buf',
      managerFilePatterns: ['/(^|/)[^/]+\\.md$/'],
      matchStrings: ['npx (?<depName>@bufbuild/buf)@(?<currentValue>\\d+\\.\\d+\\.\\d+)'],
      datasourceTemplate: 'npm',
    },
  ],
  packageRules: [
    {
      // 由 ARG 組成的映像參照：版本由 ARG 上的 renovate 註解追蹤，FROM 行不另外更新。
      matchManagers: ['dockerfile'],
      matchDepNames: ['ghcr.io/astral-sh/uv', 'python'],
      enabled: false,
    },
    // 同一個工具寫在多處時，所有位置在同一個 MR 一起升版。
    { groupName: 'uv', matchDepNames: ['ghcr.io/astral-sh/uv', 'uv_build'] },
    { groupName: 'Python', matchDepNames: ['python'] },
    { groupName: 'buf', matchDepNames: ['bufbuild/buf', '@bufbuild/buf'] },
    { groupName: 'PostgreSQL', matchDepNames: ['postgres'] },
    { groupName: 'Docker', matchDepNames: ['docker'] },
    {
      groupName: '.NET',
      matchDepNames: ['dotnet-sdk', 'mcr.microsoft.com/dotnet/sdk', 'mcr.microsoft.com/dotnet/aspnet'],
    },
  ],
}
